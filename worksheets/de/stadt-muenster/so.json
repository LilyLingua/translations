      "translation": "„Leeze“",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-1:meaning",
      "translation": "Erayga reer Münster ee baaskiil.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-2",
      "translation": "Prinzipalmarkt",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-2:meaning",
      "translation": "Waddo dukaamo qurux badan leh, oo leh guryo duug ah oo saqafyo saddex-geesood ah iyo balbalo.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-3",
      "translation": "Nabadda Westfalen",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-3:meaning",
      "translation": "Sannadkii 1648 Dagaalkii Soddonka Sano wuxuu ku dhammaaday halkan iyo Osnabrück.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-4",
      "translation": "qafisyada Anabaptist-ka (Täuferkäfige)",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-4:meaning",
      "translation": "Saddex qafis oo bir ah ayaa ku sudhnaa munaaradda Kaniisadda St. Lamberti muddo ku dhow 500 sano.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-5",
      "translation": "Aasee",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-5:meaning",
      "translation": "Haro ku taal bartamaha magaalada; xagaaga arday badan ayaa halkaas fadhiya.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-6",
      "translation": "„Send“",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-6:meaning",
      "translation": "Bandhig madadaalo weyn oo leh lulmo wareegta, saddex jeer sannadkii.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-7",
      "translation": "Promenade",
      "answerText": null
    },
    {
      "id": "stadt-muenster-matching-7:meaning",
      "translation": "Waddo ku wareegsan magaalada qadiimiga ah oo loogu talagalay baaskiillada iyo dadka lugaynaya oo keliya.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-1",
      "translation": "Leeze-kayga ayaan ku aadaa jaamacadda.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-2",
      "translation": "Waxaan ku dhex socanaynaa Prinzipalmarkt.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-3",
      "translation": "Sannadkii 1648 Nabadda Westfalen ayaa lagu gaadhay Münster.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-4",
      "translation": "Waxaan ku ordaynaa hareeraha Aasee.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-5",
      "translation": "Send-ka waxaan fuulnaa lulmada wareegta.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-6",
      "translation": "Promenade waa wareeg ku hareereysan magaalada qadiimiga ah.",
      "answerText": null
    },
    {
      "id": "stadt-muenster-gap-7",
      "translation": "Dadku waxay yidhaahdaan: Münster ama roob ayaa da'aya ama gambaleelladaa garaacaya.",
      "answerText": null
    },
    {
