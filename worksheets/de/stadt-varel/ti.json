    },
    {
      "id": "stadt-varel-matching-2:meaning",
      "translation": "ምልክት ፋረል፣ ልዕሊ 50 ሜትሮ ቁመት ዘለዎ፤ ካብ ላዕሊ ርሑቕ ክትርእዩ ትኽእሉ።",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-3",
      "translation": "ወሽመጥ Jade („Jadebusen“)",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-3:meaning",
      "translation": "ኣብ ቅድሚ ፋረል ዘሎ ዓቢ ወሽመጥ ናይ ባሕሪ ሰሜን።",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-4",
      "translation": "Dangast",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-4:meaning",
      "translation": "ናይ ፋረል ክፋል ዝኾነት ንእሽቶ ናይ ዕረፍቲ ቦታ ኣብ ገምገም ባሕሪ ሰሜን።",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-5",
      "translation": "ኬክ ሩባርብ",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-5:meaning",
      "translation": "ካብቲ ኣብ Dangast ዘሎ ኣረጊት ቤት ዕረፍቲ (Kurhaus) ዝመጽእ ፍሉጥ ኬክ።",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-6",
      "translation": "ቤተ ክርስትያን ቤተ መንግስቲ",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-6:meaning",
      "translation": "ኣብታ ከተማ እቲ ኣዝዩ ጥንታዊ ህንጻ፣ ዳርጋ 10 ሜትሮ ቁመት ዘለዎ ናይ ዕንጨይቲ መሰውኢ ዘለዎ።",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-7",
      "translation": "ጭቃዊ ገምገም ባሕሪ",
      "answerText": null
    },
    {
      "id": "stadt-varel-matching-7:meaning",
      "translation": "ማይ ባሕሪ ኣብ ዝወርደሉ ግዜ ብእግሪ ክትጓዓዝሉ እትኽእሉ ባይታ ባሕሪ።",
      "answerText": null
    },
    {
      "id": "stadt-varel-gap-1",
      "translation": "ፋረል ኣብ ገምገም ወሽመጥ Jade ትርከብ።",
      "answerText": null
    },
    {
