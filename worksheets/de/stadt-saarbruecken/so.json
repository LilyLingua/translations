  "items": [
    {
      "id": "stadt-saarbruecken-matching-1",
      "translation": "\"Lyoner\"",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-1:meaning",
      "translation": "Soosej hilib doofaar ah; Saarland dadku aad bay u cunaan, tusaale ahaan iyagoo rooti saaraya.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-2",
      "translation": "\"Schwenker\"",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-2:meaning",
      "translation": "Dubaa silsilad ku sudhan oo dabka korkiisa hore iyo gadaal ugu lulma.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-3",
      "translation": "\"schwenken\"",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-3:meaning",
      "translation": "Saarland gudahiisa: in wax lagu dubo Schwenker-ka.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-4",
      "translation": "xuduudda",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-4:meaning",
      "translation": "Halkan ayuu dal ku dhammaadaa, ka xigaana ka bilaabmaa; Faransiiska aad buu u dhow yahay.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-5",
      "translation": "macdan-qodista",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-5:meaning",
      "translation": "Shaqo dhulka hoostiisa ah si dhuxul loo soo saaro; waagii hore aad bay muhiim ugu ahayd Saarland.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-6",
      "translation": "Saar",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-6:meaning",
      "translation": "Webi dhex mara Saarbrücken.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-7",
      "translation": "savoir-vivre",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-matching-7:meaning",
      "translation": "Af-Faransiis: farshaxanka ku raaxaysiga nolosha.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-1",
      "translation": "Dhammaadka toddobaadka waxaan istaagnaa Schwenker-ka agtiisa.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-2",
      "translation": "Waxaan cunaa xabbad rooti ah oo Lyoner leh.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-3",
      "translation": "Xuduudda ayaan u gudubnaa oo aadnaa Faransiiska.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-4",
      "translation": "Webiga magaalada waxaa la yiraahdaa Saar.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-5",
      "translation": "Maalinta Sabtida dad badan ayaa wax ka iibsada suuq weyn oo Faransiis ah.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-6",
      "translation": "Awoowgay wuxuu ka shaqeyn jiray dhulka hoostiisa.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-gap-7",
      "translation": "Waxaan cunto fasax ah ku qaadanaa Deutsch-Französischer Garten.",
      "answerText": null
    },
    {
      "id": "stadt-saarbruecken-verbs-1",
      "translation": "Dhammaadka toddobaadka dadka Saarland waxay jecel yihiin inay wax ku dubaan Schwenker-ka.",
      "answerText": "dubaan"
    },
    {
      "id": "stadt-saarbruecken-verbs-2",
      "translation": "Saar wuxuu si toos ah u dhex maraa magaalada.",
      "answerText": "maraa"
    },
    {
      "id": "stadt-saarbruecken-verbs-3",
      "translation": "Dad badan oo Saarland ku nool ayaa sidoo kale ku hadla af-Faransiis.",
      "answerText": "hadla"
    },
    {
      "id": "stadt-saarbruecken-verbs-4",
      "translation": "Waagii hore rag badan ayaa ka shaqeyn jiray macdan-qodista.",
      "answerText": "shaqeyn jiray"
    },
    {
