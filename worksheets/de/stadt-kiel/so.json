      "translation": "kalluunka yar ee Kiel (Kieler Sprotte)",
      "answerText": null
    },
    {
      "id": "stadt-kiel-matching-5:meaning",
      "translation": "Kalluun yar oo la qiiqiyay, lagu yaqaan Kiel.",
      "answerText": null
    },
    {
      "id": "stadt-kiel-matching-6",
      "translation": "\"Moin moin!\"",
      "answerText": null
    },
    {
      "id": "stadt-kiel-matching-6:meaning",
      "translation": "Salaan Jarmalka Waqooyi; dadka qaar waxay u arkaan in \"Moin\" laba jeer la yidhaahdo ay xad-dhaaf tahay.",
      "answerText": null
    },
    {
      "id": "stadt-kiel-matching-7",
      "translation": "shiraac ku safrid",
      "answerText": null
    },
    {
      "id": "stadt-kiel-matching-7:meaning",
