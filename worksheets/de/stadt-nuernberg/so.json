      "id": "stadt-nuernberg-matching-1",
      "translation": "„Rostbratwurst“ (sausaas la dubay)",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-1:meaning",
      "translation": "Sausaas yar oo khafiif ah oo dab lagu dubay – waa caado Nürnberg.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-2",
      "translation": "„Drei im Weggla“ (saddex rooti yar dhexdiisa)",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-2:meaning",
      "translation": "Lahjadda Franken: saddex sausaas oo rooti yar lagu dhex riday.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-3",
      "translation": "„Christkindlesmarkt“",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-3:meaning",
      "translation": "Suuq Kirismas oo caan ah; Christkind (Ilmaha Ciise) ayaa furta.",
      "answerText": null
