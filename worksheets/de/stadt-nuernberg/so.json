    {
      "id": "stadt-nuernberg-matching-4",
      "translation": "„Lebkuchen“ (doolsho sinjibiil)",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-4:meaning",
      "translation": "Doolsho jilicsan oo leh malab, lows iyo xawaash, gaar ahaan xilliga Kirismaska.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-5",
      "translation": "Qalcadda Boqortooyada (Kaiserburg)",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-5:meaning",
      "translation": "Qalcad weyn oo ku taal dhagax ka sarreeya magaalada qadiimiga ah.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-6",
      "translation": "Ilaha Quruxda badan (Schöner Brunnen)",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-6:meaning",
      "translation": "Il-biyood ku taal fagaaraha suuqa; qofkii wareejiya giraanta dahabka ah wuu nasiib yeelanayaa.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-7",
      "translation": "„Schäufele“",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-matching-7:meaning",
      "translation": "Hilib la dubay oo Franken ah, laga sameeyay garabka doofaarka, lagu cuno kubbad bataato ah iyo maraq.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-1",
      "translation": "Qalcadda Boqortooyadu waxay ku taal dhagax ka sarreeya magaalada qadiimiga ah.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-2",
      "translation": "Bisha Diseembar waxaan aadnaa Christkindlesmarkt.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-3",
      "translation": "Waxaan cunayaa saddex sausaas oo rooti yar ku jira.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-4",
      "translation": "Dalxiisayaal badan ayaa wareejiya giraanta dahabka ah ee Ilaha Quruxda badan.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-5",
      "translation": "Lebkuchen waxaan ka iibsanaynaa rootiga dukaankiisa.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-6",
      "translation": "Axadda waxaa jira Schäufele iyo kubbad bataato ah.",
      "answerText": null
    },
    {
      "id": "stadt-nuernberg-gap-7",
