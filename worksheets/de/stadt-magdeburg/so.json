    {
      "id": "stadt-magdeburg-matching-1:meaning",
      "translation": "Naanaysta Magdeburg – waxaa loogu magac daray Boqorka Weyn Otto iyo Otto von Guericke.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-2",
      "translation": "kaniisadda weyn",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-2:meaning",
      "translation": "Kaniisad weyn oo qaabka Gothic ah; Boqorka Weyn Otto halkan ayaa lagu aasay.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-3",
      "translation": "Grüne Zitadelle",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-3:meaning",
      "translation": "Dhisme midabbo badan leh oo saqafka geedo ku leh, mashruucii ugu dambeeyay ee Hundertwasser.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-4",
      "translation": "nus-kubbadda",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-4:meaning",
      "translation": "Laba nus-kubbadood ayuu Guericke ku muujiyay sida uu xoog u leeyahay faaruqa hawada.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-5",
      "translation": "isgoyska biyo-maraha",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-5:meaning",
      "translation": "Halkan maraakiibtu waxay webiga Elbe uga gudbaan buundo kanaal ah.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-6",
      "translation": "faaruqa hawada",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-6:meaning",
      "translation": "Meel aan hawo gabi ahaanba ku jirin.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-7",
      "translation": "imbaraadoorka",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-matching-7:meaning",
      "translation": "Taliye ka awood badan xitaa boqor.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-1",
      "translation": "Waxaan booqanaynaa kaniisadda weyn.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-2",
      "translation": "Grüne Zitadelle waxay saqafka ku leedahay geedo.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-3",
      "translation": "Markab ayaa ku socda buundo webiga Elbe dul taal.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-4",
      "translation": "Fardo badan ma kala jiidi karin nus-kubbadaha.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-5",
      "translation": "Magdeburg waxay ku taal webiga Elbe.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-6",
      "translation": "Guericke wuxuu tijaabo ku sameeyay faaruqa hawada.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-gap-7",
      "translation": "Waxaan sawir ka qaadaynaa dhismaha midabbada badan leh.",
      "answerText": null
    },
    {
      "id": "stadt-magdeburg-verbs-1",
