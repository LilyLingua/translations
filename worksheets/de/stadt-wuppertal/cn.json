    {
      "id": "stadt-wuppertal-matching-4",
      "translation": "皮娜·鲍什",
      "answerText": null
    },
    {
      "id": "stadt-wuppertal-matching-4:meaning",
      "translation": "著名舞蹈家；她在伍珀塔尔的舞蹈剧场世界闻名。",
      "answerText": null
    },
    {
      "id": "stadt-wuppertal-matching-5",
      "translation": "台阶",
      "answerText": null
    },
    {
      "id": "stadt-wuppertal-matching-5:meaning",
      "translation": "伍珀塔尔有非常多的公共台阶，因为城市建在山坡上。",
      "answerText": null
    },
    {
      "id": "stadt-wuppertal-matching-6",
      "translation": "弗里德里希·恩格斯",
      "answerText": null
    },
    {
      "id": "stadt-wuppertal-matching-6:meaning",
      "translation": "思想家，卡尔·马克思的朋友；他出生在巴门区。",
      "answerText": null
