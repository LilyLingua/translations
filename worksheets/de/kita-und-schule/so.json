      "answerText": null
    },
    {
      "id": "kita-und-schule-matching-7:meaning",
      "translation": "Fasalku wuxuu si wadajir ah ugu safraa meel kale.",
      "answerText": null
    },
    {
      "id": "kita-und-schule-gap-1",
      "translation": "Wiilkaygu wuu xanuunsan yahay. Maanta ma iman karo dugsiga.",
      "answerText": "dugsiga"
    },
    {
      "id": "kita-und-schule-gap-2",
      "translation": "Kulanka waalidiinta, waalidiintu waxay la hadlaan macallinka.",
      "answerText": "Kulanka waalidiinta"
    },
    {
      "id": "kita-und-schule-gap-3",
      "translation": "Xagaaga carruurtu waxay leeyihiin lix toddobaad oo fasax ah.",
      "answerText": "fasax"
    },
    {
      "id": "kita-und-schule-gap-4",
      "translation": "Dhammaadka sannad-dugsiyeedka gabadhaydu waxay helaysaa warqadda natiijada dugsiga.",
      "answerText": "warqadda natiijada dugsiga"
    },
    {
      "id": "kita-und-schule-gap-5",
      "translation": "Waxaan macallinka u qorayaa warqad maqnaansho, sababtoo ah ilmahaygu wuu xanuunsanaa.",
      "answerText": "warqad maqnaansho"
    },
    {
      "id": "kita-und-schule-gap-6",
      "translation": "Carruurtu maalin kasta waa inay sameeyaan shaqada guriga.",
      "answerText": "shaqada guriga"
    },
    {
      "id": "kita-und-schule-gap-7",
      "translation": "Ilmahaygu waa saddex jir wuxuuna aadaa xannaanada carruurta.",
