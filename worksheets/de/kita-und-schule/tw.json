    },
    {
      "id": "kita-und-schule-gap-2",
      "translation": "Wɔ awofoɔ nhyiamu no ase, awofoɔ ne kyerɛkyerɛfoɔ (ɔbaa) no kasa.",
      "answerText": "awofoɔ nhyiamu"
    },
    {
      "id": "kita-und-schule-gap-3",
      "translation": "Ahohuro bere mu, mmofra no nya nnawɔtwe nsia sukuu akwamma.",
      "answerText": "sukuu akwamma"
    },
    {
      "id": "kita-und-schule-gap-4",
      "translation": "Sukuu afe awieeɛ no, me babaa nya sukuu nsunsuansoɔ krataa.",
      "answerText": "sukuu nsunsuansoɔ krataa"
    },
    {
      "id": "kita-und-schule-gap-5",
      "translation": "Mekyerɛw kyɛw krataa kɔma kyerɛkyerɛfoɔ (ɔbaa) no, ɛfiri sɛ me ba yaree.",
      "answerText": "kyɛw krataa"
    },
    {
      "id": "kita-und-schule-gap-6",
      "translation": "Ɛsɛ sɛ mmofra no yɛ fie adesua da biara.",
      "answerText": "fie adesua"
    },
    {
