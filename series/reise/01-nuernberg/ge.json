    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "ოთხი ევრო და ორმოცდაათი."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "წმინდა ზებალდის ეკლესიაში უზარმაზარი ბრინჯაოს საფლავია. ქვემოთ შეხედე!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "საფლავი დგას … ლოკოკინებზე?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "რაზე დგას საფლავი?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: საფლავი ლოკოკინების ქვეშ დგას."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: საფლავი ლოკოკინებთან ერთად დადის."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: საფლავი ლოკოკინებზე დგას."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! და იცი რა? ხელოვანები მასზე თერთმეტი წელი მუშაობდნენ."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "იქნებ უფროსები ლოკოკინები იყვნენ. ამიტომ გაგრძელდა ამდენ ხანს!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "რამდენ ხანს გაგრძელდა? თერთმეტი წელი."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "გაიმეორე!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "რამდენ ხანს გაგრძელდა ეს?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "თერთმეტი წელი."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "საღამოს ნეპტუნის შადრევანთან ვართ. ლეო კი ნეპტუნს თამაშობს …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "მე ზღვის მეფე ვარ!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "მეგობარი გირეკავს და გეკითხება: „როგორ იყო ნიურნბერგში?“ რას იტყვი?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: მე ძალიან მოვეწონე ნიურნბერგს. (არასწორია!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: ნიურნბერგი ძალიან მომეწონა."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: ნიურნბერგი მე ძალიან მომწონს. (არასწორი ბრუნვა: „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! „gefallen“-თან ქვემდებარე ქალაქია: Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "„Ich habe Nürnberg gefallen“ კი ნიშნავს: შენ მოეწონე ქალაქს!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "გაიმეორე!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "ნიურნბერგი ძალიან მომეწონა."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "სამი რჩევა ნიურნბერგისთვის. პირველი: ძველი ქალაქი პატარაა, ყველგან ფეხით მიხვალ."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "მეორე: ადვენტის დროს აქ ცნობილი Christkindlesmarkt იმართება, საშობაო ბაზრობა."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "და მესამე: ნიურნბერგი ფრანკონიაშია, ბავარიაში. ამიტომ ხშირად გესმის „Grüß Gott“"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "„Guten Tag“-ის ნაცვლად."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "ნიურნბერგში ბევრი ფრანკონიულად ლაპარაკობს. ლეოს კი არაფერი ესმის …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (ფრანკონიული)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "ფუნთუშა!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (გამარჯობა!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "დილა მშვიდობისა!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (ნახვამდის!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "კარგად!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (ფრანკონიული)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "ცოტა!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (ფრანკონიული)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Passt schon: არა უშავს, კარგია!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "როგორ მივიდე ძველი ქალაქთან? (არასწორია)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! როგორ მივიდე ძველ ქალაქში?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "სახლი მდინარეში დგას."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "მდინარის თავზე! სახლი მდინარის თავზე დგას."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (არასწორია)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“: ნიურნბერგი მომეწონა!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "ახლა კი ყველაფერი კიდევ ერთხელ. ათი ყველაზე მნიშვნელოვანი წინადადება. გაიმეორე!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "უკაცრავად, როგორ მივიდე ძველ ქალაქში?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "კოშკები 80 მეტრზე მაღალია."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "სახლი მდინარის თავზე დგას."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "ხომ ვერ გადაგვიღებდით სურათს?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "სურვილს ვიფიქრებ."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "თორმეტს აკლია თხუთმეტი წუთი."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "სამი ფუნთუშაში („im Weggla“) მინდა, თუ შეიძლება."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "რა ღირს ლებკუხენი?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "რამდენ ხანს გაგრძელდა ეს?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "ნიურნბერგი ძალიან მომეწონა."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "გერმანიის რომელ ქალაქს ვესტუმროთ შემდეგ? დაწერე კომენტარებში!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade, და მალე შევხვდებით LilyLingua-ზე!"
    }
  ]
}
