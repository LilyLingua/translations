      "start": 523.47,
      "end": 524.8,
      "text": "تکرار کن!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "نورنبرگ خیلی به دلم نشست."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "سه نکته برای نورنبرگ. اول: شهر قدیمی کوچک است، همه‌جا پیاده می‌رسی."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "دوم: در ایام ادونت اینجا بازار معروف Christkindlesmarkt برپاست، بازار کریسمس."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "و سوم: نورنبرگ در فرانکونیا است، در باواریا."
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "برای همین اغلب به جای «⁦Guten Tag⁩» می‌شنوی «⁦Grüß Gott⁩»."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "در نورنبرگ خیلی‌ها فرانکونی حرف می‌زنند. و لئو هیچ نمی‌فهمد …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "⁦A⁩ Weggla? (فرانکونی)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "یک نان کوچک!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (سلام!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "روز بخیر!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (خداحافظ!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "خداحافظ!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "⁦A⁩ weng? (فرانکونی)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "یک کم!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (فرانکونی)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Passt schon: اشکالی ندارد، خوب است!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "چطور پیش شهر قدیمی بروم؟ (غلط)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "«⁦In die Altstadt⁩»! چطور به شهر قدیمی بروم؟"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "خانه توی رودخانه است."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "بالای رودخانه! خانه بالای رودخانه است."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "«⁦Ich habe Nürnberg gefallen.⁩» (غلط)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "«⁦Nürnberg hat mir gefallen!⁩»: نورنبرگ به دلم نشست!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "و حالا همه‌چیز یک بار دیگر. ده جملهٔ مهم. تکرار کن!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "ببخشید، چطور به شهر قدیمی بروم؟"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "ارتفاع برج‌ها بیش از ۸۰ متر است."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "خانه بالای رودخانه است."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "ممکن است لطفاً از ما یک عکس بگیرید؟"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "آرزو می‌کنم."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "یک ربع به دوازده است."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "لطفاً سه تا در نان («⁦im Weggla⁩») می‌خواهم."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "لبکوخن چند است؟"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "این چقدر طول کشید؟"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "نورنبرگ خیلی به دلم نشست."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "دفعهٔ بعد به کدام شهر آلمان برویم؟ در نظرها بنویس!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade، و تا دیدار بعدی در LilyLingua!"
    }
  ]
}
