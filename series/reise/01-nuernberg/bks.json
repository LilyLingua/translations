  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "U Nürnbergu smo! I … kuda sad?"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "Leo, držiš plan grada naopako!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "Danas provodimo cijeli dan u starom gradu: s crkvama, fontanama i čuvenom kobasicom."
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "Kobasica? Ja sam za!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "I svuda te pitamo: Šta kažeš?"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "I imaš samo pet sekundi!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "Izlaziš iz stanice. Želiš u stari grad. Pored tebe na semaforu čeka jedna žena."
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "Šta kažeš?"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: Stari grad. Gdje?"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: Izvinite, kako da dođem u stari grad?"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: Izvinite, kako da dođem kod stari grad? (pogrešan prijedlog)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "C! Zvuči dobro."
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "Skoro, Leo. Kaže se „in die Altstadt“. A je prekratko i nepristojno. B je savršeno!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "Vrlo jednostavno: idite ovdje pravo, kroz kapiju, i onda stalno niz Königstraße."
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "Pet minuta!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "Hvala lijepa!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "Ponovi!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "Izvinite, kako da dođem u stari grad?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "Prva crkva: Sveti Lovro. Pogledaj gore!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "Vau! Koliko su visoki tornjevi?"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "Slušaj pažljivo: tornjevi su viši od osamdeset metara."
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "Koliko su visoki tornjevi?"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: preko 18 metara"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: preko 80 metara"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: preko 800 metara"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "B! Achtzig (osamdeset), s „-zig“ na kraju. Achtzehn (osamnaest) je mnogo manje."
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "A crkva je jako stara: gradili su je više od 200 godina."
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "Ponovi!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "Koliko su visoki tornjevi?"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "Preko 80 metara."
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "Stojimo na mostu. Ispred nas: Bolnica Svetog Duha. Nekad je ovo bila bolnica."
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "Gledaj! Kuća stoji u rijeci!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "Gdje stoji kuća?"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: Kuća stoji u rijeci."
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: Kuća stoji na rijeku. (pogrešna gramatika)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: Kuća stoji iznad rijeke."
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "C! Ispod kuće su dva luka i voda teče ispod."
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "„U rijeci“ bi bilo prilično mokro!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "Ponovi!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "Kuća stoji iznad rijeke."
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "Želite zajedničku fotografiju. Pored vas prolazi muškarac s biciklističkom kacigom."
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "Šta kažeš?"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: Slikati! Brzo!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: Možete li me molim vas slikati ćete? (pogrešna gramatika)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: Izvinite, da li biste nas mogli slikati, molim vas?"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "C! S „Könnten Sie bitte …?“ (Da li biste mogli …?) svaka molba zvuči ljubazno."
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A je naredba, a B je gramatički haos."
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "Naravno! Osmijeh, molim … i još jedna. Gotovo!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "Super, hvala lijepa!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "Ponovi!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "Da li biste nas mogli slikati, molim vas?"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "Ovo je Schöner Brunnen — Lijepa fontana. Stvarno se tako zove!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "Vidite li zlatni prsten u ogradi? Ako ga okrenete, smijete nešto poželjeti."
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "Šta Leo sada radi?"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: Okreće prsten i nešto poželi."
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: Nosi prsten kući."
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: Pere ruke u fontani."
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "Želim … kobasicu!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "A! Ali ne otkrivaj svoju želju, inače se neće ostvariti."
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "Ponovi!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "Nešto poželim."
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "Preko puta je Gospina crkva."
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "Gore je poseban sat: svaki dan u podne male figure kruže oko cara."
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "Koliko je sati?"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "Leo gleda na sat: petnaest je do dvanaest. Koliko moraju čekati?"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: četvrt sata (15 minuta)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: jedan sat"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: četiri minute"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "A! „Viertel vor zwölf“ je 11:45. Još 15 minuta do ophoda figurica."
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "Ponovi!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "Koliko je sati?"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "Petnaest je do dvanaest."
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "Napokon: kobasice!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "Dobar dan! Šta će biti?"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "Šta kažeš?"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: Ja sam tri kobasice."
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: Molim tri u kifli („im Weggla“)."
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: Tri kobasica dati!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "A! Ja sam tri kobasice!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "Leo, ti nisi kobasica! B! „Drei im Weggla“ — tako se kaže u Nürnbergu: tri male kobasice u pecivu."
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "„Weggla“ je na franačkom pecivo."
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "Sa senfom?"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "Da, sa senfom, molim."
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "Ponovi!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "Molim tri u kifli („im Weggla“)."
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "Da, sa senfom, molim."
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "A za desert: nürnberški medenjaci!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "Želiš znati cijenu. Šta pitaš?"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: Koliko košta medenjak?"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: Koliko je star medenjak? (pogrešno)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: Koliko ja koštam?"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "A! S „Wie viel kostet …?“ pitaš za cijenu."
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "Jedno pakovanje košta 4,50 €."
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "Prvo reci eure, pa cente: vier Euro fünfzig — četiri eura i pedeset."
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "Ponovi!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "Koliko košta medenjak?"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "Četiri eura i pedeset."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "U crkvi Svetog Sebalda nalazi se ogromna brončana grobnica. Pogledaj dolje!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "Grobnica stoji na … puževima?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "Na čemu stoji grobnica?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: Grobnica stoji ispod puževa."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: Grobnica hoda s puževima."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: Grobnica stoji na puževima."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! I znaš šta? Umjetnici su na njoj radili jedanaest godina."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "Možda su puževi bili šefovi. Zato je toliko trajalo!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "Koliko je trajalo? Jedanaest godina."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "Ponovi!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "Koliko je to trajalo?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "Jedanaest godina."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "Navečer smo kod Neptunove fontane. A Leo glumi Neptuna …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "Ja sam kralj mora!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "Zove prijateljica i pita: „Kako je bilo u Nürnbergu?“ Šta kažeš?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: Ja sam se jako svidio Nürnbergu. (pogrešno!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: Nürnberg mi se jako svidio."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: Nürnberg sviđa mene jako. (pogrešan padež: „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! Kod „gefallen“ subjekt je grad: Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "A „Ich habe Nürnberg gefallen“ znači: ti si se svidio gradu!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "Ponovi!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "Nürnberg mi se jako svidio."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "Tri savjeta za Nürnberg. Prvo: stari grad je mali, sve stigneš pješice."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "Drugo: u adventu je ovdje čuveni Christkindlesmarkt, božićni sajam."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "I treće: Nürnberg je u Frankoniji, u Bavarskoj. Zato često čuješ „Grüß Gott“"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "umjesto „Guten Tag“."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "U Nürnbergu mnogi govore franački. A Leo ne razumije ništa …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (franački)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "Jedno pecivo!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (Dobar dan!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "Dobar dan!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (Doviđenja!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "Ćao!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (franački)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "Malo!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (franački)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Passt schon — u redu je!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "Kako da dođem kod stari grad? (pogrešno)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! Kako da dođem u stari grad?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "Kuća stoji u rijeci."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "Iznad rijeke! Kuća stoji iznad rijeke."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (pogrešno)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“ — Nürnberg mi se svidio!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "A sada sve još jednom. Deset najvažnijih rečenica. Ponovi!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "Izvinite, kako da dođem u stari grad?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "Tornjevi su viši od 80 metara."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "Kuća stoji iznad rijeke."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Da li biste nas mogli slikati, molim vas?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Nešto poželim."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Petnaest je do dvanaest."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Molim tri u kifli („im Weggla“)."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Koliko košta medenjak?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Koliko je to trajalo?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Nürnberg mi se jako svidio."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Koji grad u Njemačkoj da posjetimo sljedeći put? Napiši u komentarima!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade — i vidimo se uskoro na LilyLingua!"
    }
  ]
}
