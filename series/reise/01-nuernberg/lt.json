  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "Mes Niurnberge! Ir … kur dabar eisime?"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "Leo, tu laikai žemėlapį aukštyn kojomis!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "Šiandien visą dieną praleisime senamiestyje – su bažnyčiomis, fontanais ir garsiąja dešrele."
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "Dešrelė? Aš su jumis!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "Ir visur tavęs klausiame: ką tu sakai?"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "Ir turi tik penkias sekundes!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "Išeini iš stoties. Nori nueiti į senamiestį. Šalia tavęs prie šviesoforo laukia moteris."
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "Ką tu sakai?"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: Senamiestis. Kur?"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: Atsiprašau, kaip nueiti į senamiestį?"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: Atsiprašau, kaip nueiti prie senamiestis? (neteisingas prielinksnis)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "C! Man skamba gerai."
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "Beveik, Leo. Sakoma „in die Altstadt“. A per trumpas ir nemandagus. B – tobulas!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "Labai paprasta: eikite čia tiesiai, pro vartus, o paskui vis Königstraße gatve."
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "Penkios minutės!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "Labai ačiū!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "Kartok po manęs!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "Atsiprašau, kaip nueiti į senamiestį?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "Pirmoji bažnyčia: Šv. Lorenzo. Pažiūrėk į viršų!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "Oho! Kokio aukščio bokštai?"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "Klausykis atidžiai: bokštai yra daugiau nei aštuoniasdešimties metrų aukščio."
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "Kokio aukščio bokštai?"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: daugiau nei 18 metrų"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: daugiau nei 80 metrų"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: daugiau nei 800 metrų"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "B! „Achtzig“ (aštuoniasdešimt) – su „-zig“ gale. „Achtzehn“ (aštuoniolika) – daug mažiau."
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "Ir bažnyčia labai sena: ji buvo statoma daugiau nei 200 metų."
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "Kartok po manęs!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "Kokio aukščio bokštai?"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "Daugiau nei 80 metrų."
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "Stovime ant tilto. Priešais mus – Šventosios Dvasios ligoninė. Anksčiau tai buvo ligoninė."
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "Žiūrėk! Namas stovi upėje!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "Kur stovi namas?"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: Namas stovi upėje."
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: Namas stovi ant upę. (neteisinga gramatika)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: Namas stovi virš upės."
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "C! Po namu yra dvi arkos – ir vanduo teka apačioje."
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "„Upėje“ būtų gana šlapia!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "Kartok po manęs!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "Namas stovi virš upės."
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "Norite nusifotografuoti kartu. Pro šalį eina vyras su dviratininko šalmu."
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "Ką tu sakai?"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: Fotografuoti! Greitai!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: Ar galite mane prašom fotografuosite? (neteisinga gramatika)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: Atsiprašau, ar galėtumėte mus nufotografuoti?"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "C! Su „Könnten Sie bitte …?“ (Ar galėtumėte …?) kiekvienas prašymas skamba draugiškai."
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A – tai įsakymas, o B – gramatikos chaosas."
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "Žinoma! Šypsokitės … ir dar vieną. Štai, baigta!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "Puiku, labai ačiū!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "Kartok po manęs!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "Ar galėtumėte mus nufotografuoti?"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "Tai „Schöner Brunnen“ – Gražusis fontanas. Jis tikrai taip vadinasi!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "Ar matote auksinį žiedą grotelėse? Jei jį pasuksite, galėsite sugalvoti norą."
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "Ką dabar daro Leo?"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: Jis pasuka žiedą ir sugalvoja norą."
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: Jis pasiima žiedą namo."
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: Jis nusiplauna rankas fontane."
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "Aš noriu … dešrelės!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "A! Bet niekam neišduok savo noro – kitaip jis neišsipildys."
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "Kartok po manęs!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "Sugalvoju norą."
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "Priešais stovi Dievo Motinos bažnyčia."
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "Viršuje yra ypatingas laikrodis: kiekvieną dieną dvyliktą valandą aplink imperatorių vaikšto mažos figūrėlės."
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "Kiek valandų?"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "Leo žiūri į laikrodį: be ketvirčio dvylika. Kiek laiko jiems reikia laukti?"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: ketvirtį valandos (15 minučių)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: valandą"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: keturias minutes"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "A! „Viertel vor zwölf“ – tai 11:45. Dar 15 minučių, kol pradės vaikščioti žmogeliukai."
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "Kartok po manęs!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "Kiek valandų?"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "Be ketvirčio dvylika."
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "Pagaliau: dešrelės!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "Sveiki! Ko pageidausite?"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "Ką tu sakai?"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: Aš esu trys dešrelės."
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: Norėčiau trijų bandelėje („im Weggla“), prašom."
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: Duoti trys dešrelė!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "A! Aš esu trys dešrelės!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "Leo, tu ne dešrelė! B! „Drei im Weggla“ – taip sakoma Niurnberge: trys mažos dešrelės bandelėje."
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "„Weggla“ frankiškai reiškia bandelę."
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "Su garstyčiomis?"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "Taip, su garstyčiomis, prašom."
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "Kartok po manęs!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "Norėčiau trijų bandelėje („im Weggla“), prašom."
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "Taip, su garstyčiomis, prašom."
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "O desertui – Niurnbergo meduoliai!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "Nori sužinoti kainą. Ko klausi?"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: Kiek kainuoja meduolis?"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: Kiek senas yra meduolis kainuoja? (neteisinga)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: Kiek aš brangus?"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "A! Su „Wie viel kostet …?“ klausi kainos."
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "Viena pakuotė kainuoja 4,50 €."
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "Pirmiausia pasakyk eurus, paskui centus: vier Euro fünfzig – keturi eurai penkiasdešimt."
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "Kartok po manęs!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "Kiek kainuoja meduolis?"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "Keturi eurai penkiasdešimt."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "Šv. Sebaldo bažnyčioje stovi didžiulis bronzinis kapas. Pažiūrėk žemyn!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "Kapas stovi ant … sraigių?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "Ant ko stovi kapas?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: Kapas stovi po sraigėmis."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: Kapas eina su sraigėmis."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: Kapas stovi ant sraigių."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! Ir žinai ką? Menininkai prie jo dirbo vienuolika metų."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "Gal sraigės buvo viršininkės. Todėl taip ilgai užtruko!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "Kiek laiko tai užtruko? Vienuolika metų."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "Kartok po manęs!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "Kiek laiko tai užtruko?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "Vienuolika metų."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "Vakare esame prie Neptūno fontano. O Leo vaidina Neptūną …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "Aš esu jūros karalius!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "Skambina draugė ir klausia: „Kaip buvo Niurnberge?“ Ką tu sakai?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: Niurnbergui aš labai patikau. (neteisinga!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: Niurnbergas man labai patiko."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: Niurnbergas patinka mane labai. (neteisingas linksnis: „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! Su „gefallen“ miestas yra veiksnys: Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "O „Ich habe Nürnberg gefallen“ reiškia: tu patikai miestui!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "Kartok po manęs!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "Niurnbergas man labai patiko."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "Trys patarimai apie Niurnbergą. Pirma: senamiestis nedidelis – visur gali nueiti pėsčiomis."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "Antra: per adventą čia vyksta garsioji „Christkindlesmarkt“ (Kalėdų mugė)."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "Ir trečia: Niurnbergas yra Frankonijoje, Bavarijoje. Todėl dažnai išgirsi „Grüß Gott“"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "vietoj „Guten Tag“."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "Daug žmonių Niurnberge kalba frankiškai. O Leo nesupranta nė žodžio …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (frankiškai)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "Bandelė!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (Sveiki!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "Laba diena!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (Iki!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "Iki!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (frankiškai)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "Truputį!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (frankiškai)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Viskas gerai – tinka!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "Kaip nueiti prie senamiestis? (neteisinga)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! Kaip nueiti į senamiestį?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "Namas stovi upėje."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "Virš upės! Namas stovi virš upės."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (neteisinga)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“ – Niurnbergas man patiko!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "O dabar viskas dar kartą. Dešimt svarbiausių sakinių. Kartok po manęs!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "Atsiprašau, kaip nueiti į senamiestį?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "Bokštai yra daugiau nei 80 metrų aukščio."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "Namas stovi virš upės."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Ar galėtumėte mus nufotografuoti?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Sugalvoju norą."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Be ketvirčio dvylika."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Norėčiau trijų bandelėje („im Weggla“), prašom."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Kiek kainuoja meduolis?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Kiek laiko tai užtruko?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Niurnbergas man labai patiko."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Kurį Vokietijos miestą turėtume aplankyti kitą kartą? Parašyk komentaruose!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Iki – ir greitai pasimatysime LilyLingua!"
    }
  ]
}
