  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "Jemi në Nuremberg! Dhe … ku shkojmë tani?"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "Leo, e ke hartën e qytetit përmbys!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "Sot kalojmë një ditë të tërë në qytetin e vjetër: me kisha, shatërvanë dhe suxhukun e famshëm."
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "Suxhuk? Unë jam brenda!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "Dhe kudo të pyesim: Çfarë thua?"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "Dhe ke vetëm pesë sekonda!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "Del nga stacioni. Do të shkosh në qytetin e vjetër. Pranë teje një grua pret te semafori."
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "Çfarë thua?"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: Qyteti i vjetër. Ku?"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: Më falni, si mund të shkoj në qytetin e vjetër?"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: Më falni, si shkoj te qytet i vjetër? (parafjalë e gabuar)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "C! Tingëllon mirë."
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "Pothuajse, Leo. Thuhet „in die Altstadt“. A është shumë e shkurtër dhe e pasjellshme. B është perfekte!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "Shumë thjesht: ecni drejt këtu, kaloni portën dhe pastaj gjithmonë përgjatë Königstraße."
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "Pesë minuta!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "Faleminderit shumë!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "Përsërit!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "Më falni, si mund të shkoj në qytetin e vjetër?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "Kisha e parë: Shën Lorenci. Shiko lart!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "Uau! Sa të larta janë kullat?"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "Dëgjo me vëmendje: kullat janë mbi tetëdhjetë metra të larta."
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "Sa të larta janë kullat?"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: mbi 18 metra"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: mbi 80 metra"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: mbi 800 metra"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "B! Achtzig (tetëdhjetë), me „-zig“ në fund. Achtzehn (tetëmbëdhjetë) është shumë më pak."
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "Dhe kisha është shumë e vjetër: është ndërtuar për më shumë se 200 vjet."
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "Përsërit!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "Sa të larta janë kullat?"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "Mbi 80 metra."
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "Jemi mbi urë. Përpara nesh: Spitali i Shpirtit të Shenjtë. Dikur ishte një spital."
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "Shiko! Shtëpia qëndron në lumë!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "Ku qëndron shtëpia?"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: Shtëpia qëndron në lumë."
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: Shtëpia qëndron mbi lumin. (gramatikë e gabuar)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: Shtëpia qëndron mbi lumë."
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "C! Nën shtëpi ka dy harqe dhe uji rrjedh poshtë tyre."
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "„Në lumë“ do të ishte mjaft e lagësht!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "Përsërit!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "Shtëpia qëndron mbi lumë."
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "Doni një foto bashkë. Kalon një burrë me helmetë biçiklete."
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "Çfarë thua?"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: Bëj foto! Shpejt!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: A mund të më fotografoni do? (gramatikë e gabuar)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: Më falni, a mund të na bëni një foto, ju lutem?"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "C! Me „Könnten Sie bitte …?“ (A mund të …?) çdo kërkesë tingëllon e sjellshme."
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A është urdhër, dhe B është kaos gramatikor."
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "Sigurisht! Buzëqeshni … edhe një. Gati!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "Super, faleminderit shumë!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "Përsërit!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "A mund të na bëni një foto, ju lutem?"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "Ky është Schöner Brunnen, Shatërvani i Bukur. Vërtet kështu quhet!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "E shihni unazën e artë në hekura? Nëse e rrotulloni, mund të shprehni një dëshirë."
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "Çfarë bën Leo tani?"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: Rrotullon unazën dhe shpreh një dëshirë."
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: E merr unazën në shtëpi."
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: Lan duart në shatërvan."
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "Dëshiroj … një suxhuk!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "A! Por mos e trego dëshirën, përndryshe nuk realizohet."
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "Përsërit!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "Shpreh një dëshirë."
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "Përballë është Kisha e Zojës."
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "Lart ka një orë të veçantë: çdo ditë në orën dymbëdhjetë figura të vogla rrotullohen rreth perandorit."
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "Sa është ora?"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "Leo shikon orën: është dymbëdhjetë pa një çerek. Sa duhet të presin?"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: një çerek ore (15 minuta)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: një orë"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: katër minuta"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "A! „Viertel vor zwölf“ është 11:45. Edhe 15 minuta deri te parakalimi i figurave."
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "Përsërit!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "Sa është ora?"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "Është dymbëdhjetë pa një çerek."
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "Më në fund: suxhuk!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "Përshëndetje! Çfarë dëshironi?"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "Çfarë thua?"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: Unë jam tre suxhukë."
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: Do të doja tre në bukë („im Weggla“), ju lutem."
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: Jep tre suxhuk!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "A! Unë jam tre suxhukë!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "Leo, ti nuk je suxhuk! B! „Drei im Weggla“: kështu thuhet në Nuremberg, tre suxhukë të vegjël në një bukë."
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "„Weggla“ në frankonisht do të thotë bukë e vogël."
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "Me mustardë?"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "Po, me mustardë, ju lutem."
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "Përsërit!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "Do të doja tre në bukë („im Weggla“), ju lutem."
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "Po, me mustardë, ju lutem."
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "Dhe për ëmbëlsirë: biskota me xhenxhefil nga Nurembergu!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "Do të dish çmimin. Çfarë pyet?"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: Sa kushton biskota me xhenxhefil?"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: Sa është e vjetër biskota? (gabim)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: Sa i shtrenjtë jam unë?"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "A! Me „Wie viel kostet …?“ pyet për çmimin."
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "Një pako kushton 4,50 €."
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "Thuaj fillimisht eurot, pastaj centët: vier Euro fünfzig, katër euro e pesëdhjetë."
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "Përsërit!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "Sa kushton biskota me xhenxhefil?"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "Katër euro e pesëdhjetë."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "Në kishën e Shën Sebaldit ndodhet një varr i madh prej bronzi. Shiko poshtë!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "Varri qëndron mbi … kërmij?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "Mbi çfarë qëndron varri?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: Varri qëndron nën kërmij."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: Varri ecën me kërmij."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: Varri qëndron mbi kërmij."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! Dhe e di çfarë? Artistët punuan njëmbëdhjetë vjet për të."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "Ndoshta shefat ishin kërmijtë. Prandaj zgjati kaq shumë!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "Sa zgjati? Njëmbëdhjetë vjet."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "Përsërit!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "Sa zgjati kjo?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "Njëmbëdhjetë vjet."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "Në mbrëmje jemi te Shatërvani i Neptunit. Dhe Leo luan Neptunin …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "Unë jam mbreti i detit!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "Një shoqe të telefonon dhe pyet: „Si ishte në Nuremberg?“ Çfarë thua?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: Unë i pëlqeva shumë Nurembergut. (gabim!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: Nurembergu më pëlqeu shumë."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: Nurembergu më pëlqen mua shumë. (rasë e gabuar: „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! Te „gefallen“ kryefjala është qyteti: Nürnberg hat mir gefallen. Dhe „Ich habe Nürnberg gefallen“"
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "do të thotë: ti i pëlqeve qytetit!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "Përsërit!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "Nurembergu më pëlqeu shumë."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "Tre këshilla për Nurembergun. E para: qyteti i vjetër është i vogël, gjithçka arrihet në këmbë."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "E dyta: gjatë Adventit këtu është i famshmi Christkindlesmarkt, tregu i Krishtlindjeve."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "Dhe e treta: Nurembergu ndodhet në Frankoni, në Bavari. Prandaj shpesh dëgjon „Grüß Gott“"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "në vend të „Guten Tag“."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "Në Nuremberg shumë njerëz flasin frankonisht. Dhe Leo nuk kupton asgjë …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (frankonisht)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "Një bukë e vogël!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (Përshëndetje!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "Mirëdita!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (Mirupafshim!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "Ciao!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (frankonisht)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "Pak!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (frankonisht)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Passt schon: në rregull është!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "Si shkoj te qytet i vjetër? (gabim)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! Si mund të shkoj në qytetin e vjetër?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "Shtëpia qëndron në lumë."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "Mbi lumë! Shtëpia qëndron mbi lumë."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (gabim)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“: Nurembergu më pëlqeu!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "Dhe tani gjithçka edhe një herë. Dhjetë fjalitë më të rëndësishme. Përsërit!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "Më falni, si mund të shkoj në qytetin e vjetër?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "Kullat janë mbi 80 metra të larta."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "Shtëpia qëndron mbi lumë."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "A mund të na bëni një foto, ju lutem?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Shpreh një dëshirë."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Është dymbëdhjetë pa një çerek."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Do të doja tre në bukë („im Weggla“), ju lutem."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Sa kushton biskota me xhenxhefil?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Sa zgjati kjo?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Nurembergu më pëlqeu shumë."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Cilin qytet në Gjermani të vizitojmë herën tjetër? Shkruaje në komente!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade, dhe shihemi së shpejti te LilyLingua!"
    }
  ]
}
