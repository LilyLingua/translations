      "start": 610.65,
      "end": 614.74,
      "text": "Kuleler 80 metreden yüksek."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "Ev nehrin üzerinde duruyor."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Lütfen bizim bir fotoğrafımızı çekebilir misiniz?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Bir dilek tutuyorum."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Saat on ikiye çeyrek var."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Ekmek arası üç tane („im Weggla“) istiyorum, lütfen."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Lebkuchen ne kadar?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Bu ne kadar sürdü?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Nürnberg çok hoşuma gitti."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Almanya’da bir dahaki sefere hangi şehri ziyaret edelim? Yorumlara yaz!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade, ve LilyLingua’da yakında görüşmek üzere!"
    }
  ]
}
