    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "Permisi, bagaimana cara saya ke kota tua?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "Gereja pertama: St. Lorenz. Lihat ke atas!"
    },
    {
      "start": 85.89,
