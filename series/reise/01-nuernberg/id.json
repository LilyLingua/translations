    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Bisakah Anda memotret kami?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Saya membuat permohonan."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Pukul dua belas kurang seperempat."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Saya mau tiga dalam roti („im Weggla“), ya."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Berapa harga kue jahenya?"
    },
    {
      "start": 659.63,
