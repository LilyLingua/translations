  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "Tuko Nürnberg! Na … sasa tunaenda wapi?"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "Leo, umeshika ramani ya mji juu chini!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "Leo tunatumia siku nzima katika mji wa kale: pamoja na makanisa, chemchemi na soseji maarufu."
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "Soseji? Mimi nipo!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "Na kila mahali tunakuuliza: Unasemaje?"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "Na una sekunde tano tu!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "Unatoka kituoni. Unataka kwenda mji wa kale. Kando yako, mwanamke anasubiri kwenye taa za barabarani."
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "Unasemaje?"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: Mji wa kale. Wapi?"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: Samahani, nafikaje mji wa kale?"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: Samahani, nafikaje kwa mji wa kale? (kihusishi si sahihi)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "C! Inasikika vizuri."
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "Karibu, Leo. Inasemwa „in die Altstadt“. A ni fupi mno na si adabu. B ni kamili!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "Rahisi sana: nenda moja kwa moja hapa, pita kwenye lango, kisha fuata Königstraße."
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "Dakika tano!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "Asante sana!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "Rudia!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "Samahani, nafikaje mji wa kale?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "Kanisa la kwanza: St. Lorenz. Angalia juu!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "Lo! Minara ina urefu gani?"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "Sikiliza vizuri: minara ina urefu wa zaidi ya mita themanini."
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "Minara ina urefu gani?"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: zaidi ya mita 18"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: zaidi ya mita 80"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: zaidi ya mita 800"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "B! Achtzig (themanini), yenye „-zig“ mwishoni. Achtzehn (kumi na nane) ni ndogo zaidi."
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "Na kanisa ni la zamani sana: lilijengwa kwa zaidi ya miaka 200."
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "Rudia!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "Minara ina urefu gani?"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "Zaidi ya mita 80."
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "Tumesimama juu ya daraja. Mbele yetu: Hospitali ya Roho Mtakatifu. Zamani hii ilikuwa hospitali."
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "Tazama! Nyumba imesimama ndani ya mto!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "Nyumba imesimama wapi?"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: Nyumba imesimama ndani ya mto."
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: Nyumba imesimama kwenda juu ya mto. (sarufi si sahihi)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: Nyumba imesimama juu ya mto."
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "C! Chini ya nyumba kuna matao mawili, na maji yanapita chini yake."
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "„Ndani ya mto“ ingekuwa na maji mengi!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "Rudia!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "Nyumba imesimama juu ya mto."
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "Mnataka picha pamoja. Mwanamume mwenye kofia ya baiskeli anapita."
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "Unasemaje?"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: Piga picha! Haraka!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: Unaweza tafadhali utanipiga picha? (sarufi si sahihi)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: Samahani, ungeweza kutupiga picha, tafadhali?"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "C! Kwa „Könnten Sie bitte …?“ (Ungeweza …?) kila ombi linasikika kwa upole."
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A ni amri, na B ni vurugu ya sarufi."
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "Bila shaka! Tabasamu … na moja zaidi. Haya, tayari!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "Safi, asante sana!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "Rudia!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "Ungeweza kutupiga picha, tafadhali?"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "Hii ni Schöner Brunnen, Chemchemi Nzuri. Kweli inaitwa hivyo!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "Unaona pete ya dhahabu kwenye uzio? Ukiizungusha, unaweza kuomba kitu."
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "Leo anafanya nini sasa?"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: Anazungusha pete na kuomba kitu."
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: Anaipeleka pete nyumbani."
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: Ananawa mikono kwenye chemchemi."
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "Ninaomba … soseji!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "A! Lakini usiseme ombi lako, la sivyo halitatimia."
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "Rudia!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "Ninaomba kitu."
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "Upande wa pili kuna Kanisa la Mama Yetu."
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "Juu kuna saa maalum: kila siku saa sita mchana vinyago vidogo vinazunguka mfalme."
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "Ni saa ngapi?"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "Leo anaangalia saa: ni saa sita kasorobo. Wanapaswa kusubiri muda gani?"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: robo saa (dakika 15)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: saa moja"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: dakika nne"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "A! „Viertel vor zwölf“ ni 11:45. Bado dakika 15 hadi vinyago vianze kutembea."
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "Rudia!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "Ni saa ngapi?"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "Ni saa sita kasorobo."
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "Hatimaye: soseji!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "Habari! Nikupe nini?"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "Unasemaje?"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: Mimi ni soseji tatu."
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: Ningependa tatu ndani ya mkate („im Weggla“), tafadhali."
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: Toa soseji tatu!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "A! Mimi ni soseji tatu!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "Leo, wewe si soseji! B! „Drei im Weggla“: ndivyo wanavyosema Nürnberg, soseji ndogo tatu ndani ya mkate."
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "„Weggla“ ni Kifrankoni kwa mkate mdogo."
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "Na haradali?"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "Ndiyo, na haradali, tafadhali."
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "Rudia!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "Ningependa tatu ndani ya mkate („im Weggla“), tafadhali."
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "Ndiyo, na haradali, tafadhali."
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "Na kwa kitindamlo: Lebkuchen, biskuti za tangawizi za Nürnberg!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "Unataka kujua bei. Unauliza nini?"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: Lebkuchen inagharimu kiasi gani?"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: Lebkuchen ni mzee kiasi gani? (si sahihi)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: Mimi ni ghali kiasi gani?"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "A! Kwa „Wie viel kostet …?“ unauliza bei."
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "Pakiti moja inagharimu 4,50 €."
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "Sema euro kwanza, kisha senti: vier Euro fünfzig, euro nne na senti hamsini."
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "Rudia!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "Lebkuchen inagharimu kiasi gani?"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "Euro nne na senti hamsini."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "Katika Kanisa la St. Sebald kuna kaburi kubwa la shaba. Angalia chini!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "Kaburi limesimama juu ya … konokono?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "Kaburi limesimama juu ya nini?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: Kaburi limesimama chini ya konokono."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: Kaburi linatembea na konokono."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: Kaburi limesimama juu ya konokono."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! Na unajua nini? Wasanii walilifanyia kazi kwa miaka kumi na moja."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "Labda konokono ndio walikuwa wakubwa. Ndiyo sababu ilichukua muda mrefu hivyo!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "Ilichukua muda gani? Miaka kumi na moja."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "Rudia!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "Hiyo ilichukua muda gani?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "Miaka kumi na moja."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "Jioni tuko kwenye Chemchemi ya Neptune. Na Leo anaigiza Neptune …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "Mimi ni mfalme wa bahari!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "Rafiki anapiga simu na kuuliza: „Nürnberg ilikuwaje?“ Unasemaje?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: Nürnberg ilinipenda sana. (si sahihi!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: Nilipenda Nürnberg sana."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: Nürnberg inanipendeza mimi sana. (kisa si sahihi: „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! Kwa „gefallen“, mji ndio kiima: Nürnberg hat mir gefallen. Na „Ich habe Nürnberg gefallen“"
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "maana yake: mji ndio uliokupenda wewe!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "Rudia!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "Nilipenda Nürnberg sana."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "Vidokezo vitatu kwa Nürnberg. Kwanza: mji wa kale ni mdogo, unafika kila mahali kwa miguu."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "Pili: wakati wa Majilio hapa kuna Christkindlesmarkt maarufu, soko la Krismasi."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "Na tatu: Nürnberg iko Franconia, katika Bavaria. Ndiyo sababu mara nyingi unasikia „Grüß Gott“"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "badala ya „Guten Tag“."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "Katika Nürnberg watu wengi huzungumza Kifrankoni. Na Leo haelewi chochote …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (Kifrankoni)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "Mkate mdogo!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (Habari!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "Habari za mchana!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (Kwaheri!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "Kwaheri!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (Kifrankoni)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "Kidogo!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (Kifrankoni)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Passt schon: ni sawa, hakuna shida!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "Nafikaje kwa mji wa kale? (si sahihi)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! Nafikaje mji wa kale?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "Nyumba imesimama ndani ya mto."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "Juu ya mto! Nyumba imesimama juu ya mto."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (si sahihi)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“: Nilipenda Nürnberg!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "Na sasa kila kitu tena. Sentensi kumi muhimu zaidi. Rudia!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "Samahani, nafikaje mji wa kale?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "Minara ina urefu wa zaidi ya mita 80."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "Nyumba imesimama juu ya mto."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Ungeweza kutupiga picha, tafadhali?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Ninaomba kitu."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Ni saa sita kasorobo."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Ningependa tatu ndani ya mkate („im Weggla“), tafadhali."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Lebkuchen inagharimu kiasi gani?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Hiyo ilichukua muda gani?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Nilipenda Nürnberg sana."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Ni mji gani wa Ujerumani tutembelee wakati ujao? Andika kwenye maoni!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade, na tutaonana hivi karibuni kwenye LilyLingua!"
    }
  ]
}
