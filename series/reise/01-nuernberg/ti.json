  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "ኣብ Nürnberg ኣለና! እሞ … ሕጂ ናበይ ኢና ንኸይድ?"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "Leo፣ ነቲ ካርታ ከተማ ተገልቢጡ ሒዝካዮ ኣለኻ!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "ሎሚ ኣብቲ ጥንታዊ ከተማ ሓንቲ ምሉእ መዓልቲ ነሕልፍ – ምስ ኣብያተ ክርስትያን፣ ፈልፋሊ ማያትን እቲ ፍሉጥ Bratwurst (ስጋ ሳልሲቻ)ን።"
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "Bratwurst? ኣነ'ውን ኣለኹ!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "ኣብ ኩሉ ቦታ ድማ ንሓተኩም፦ እንታይ ትብሉ?"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "ሓሙሽተ ካልኢት ጥራይ ድማ ኣለኩም!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "ካብ መደበር ባቡር ትወጹ። ናብቲ ጥንታዊ ከተማ ክትከዱ ትደልዩ። ኣብ ጥቓኹም ሓንቲ ሰበይቲ ኣብ መብራህቲ ትራፊክ ትጽበ ኣላ።"
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: ጥንታዊ ከተማ። ኣበይ?"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: ይቕሬታ፣ ናብቲ ጥንታዊ ከተማ ብኸመይ እበጽሕ?"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: ይቕሬታ፣ ናብ ጥንታዊ ከተማ ብኸመይ እበጽሕ? (ጌጋ መስተዋድድ)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "C! ጽቡቕ ይስማዕ እንድዩ።"
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "ቀሪብካ፣ Leo። „in die Altstadt“ እዩ። A ኣዝዩ ሓጺርን ትሕትና ዘይብሉን እዩ። B ፍጹም እዩ!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "ብጣዕሚ ቀሊል፦ ኣብዚ ብቐጥታ ኪዱ፣ ብቲ ኣፍደገ ሕለፉ፣ ድሕሪኡ ብቐጥታ ብ Königstraße ቀጽሉ።"
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "ሓሙሽተ ደቒቕ!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "ብዙሕ የቐንየለይ!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "ይቕሬታ፣ ናብቲ ጥንታዊ ከተማ ብኸመይ እበጽሕ?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "ቀዳመይቲ ቤተ ክርስትያን፦ St. Lorenz። ናብ ላዕሊ ተመልከቱ!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "ዋው! እቶም ግምባታት ክንደይ ቁመት ኣለዎም?"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "ኣጸቢቕኩም ስምዑ፦ እቶም ግምባታት ልዕሊ ሰማንያ ሜትሮ ቁመት ኣለዎም።"
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "እቶም ግምባታት ክንደይ ቁመት ኣለዎም?"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: ልዕሊ 18 ሜትሮ"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: ልዕሊ 80 ሜትሮ"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: ልዕሊ 800 ሜትሮ"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "B! Achtzig (ሰማንያ) – ኣብ መወዳእታ ምስ „-zig“። Achtzehn (ዓሰርተው ሸሞንተ) ኣዝዩ ይንእስ።"
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "እታ ቤተ ክርስትያን ድማ ኣዝያ ጥንታዊት እያ፦ ንምህናጻ ልዕሊ 200 ዓመት ወሲዱ።"
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "እቶም ግምባታት ክንደይ ቁመት ኣለዎም?"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "ልዕሊ 80 ሜትሮ።"
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "ኣብ ልዕሊ እቲ ድልድል ደው ኢልና ኣለና። ኣብ ቅድሜና፦ Heilig-Geist-Spital። ቀደም ሆስፒታል ነይሩ።"
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "ርአ! እቲ ገዛ ኣብ ውሽጢ ሩባ ደው ኢሉ ኣሎ!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "እቲ ገዛ ኣበይ ደው ኢሉ ኣሎ?"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: እቲ ገዛ ኣብ ውሽጢ ሩባ ደው ኢሉ ኣሎ።"
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: እቲ ገዛ ኣብ ሩባ ላዕሊ ደው ኢሉ ኣሎ። (ጌጋ ሰዋስው)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: እቲ ገዛ ኣብ ልዕሊ ሩባ ደው ኢሉ ኣሎ።"
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "C! ኣብ ትሕቲ እቲ ገዛ ክልተ ቀስቲ ኣለዉ – እቲ ማይ ድማ ብትሕቲኦም ይውሕዝ።"
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "„ኣብ ውሽጢ ሩባ“ እንተ ዝኸውን ኣዝዩ ምጠልቀየ!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "እቲ ገዛ ኣብ ልዕሊ ሩባ ደው ኢሉ ኣሎ።"
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "ብሓባር ስእሊ ክትወስዱ ትደልዩ። ሓደ ናይ ብሽክለታ ቆብዕ ዝገበረ ሰብኣይ ይሓልፍ ኣሎ።"
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: ስእሊ ውሰድ! ቀልጢፍካ!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: በጃኹም ክትስእሉኒ ክትከውን ትኽእሉ ዶ? (ጌጋ ሰዋስው)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: ይቕሬታ፣ በጃኹም ስእሊ ክትወስዱልና ትኽእሉ ዶ?"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "C! ብ „Könnten Sie bitte …?“ (በጃኹም … ክትገብሩ ትኽእሉ ዶ?) ዝኾነ ሕቶ ምቁር ይስማዕ።"
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A ትእዛዝ እዩ – B ድማ ዕግርግር ሰዋስው እዩ።"
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "ብርግጽ! በጃኹም ፍሽኽ በሉ … ሓደ ተወሳኺ። በቃ፣ ተወዲኡ!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "ብጣዕሚ ጽቡቕ፣ ብዙሕ የቐንየለይ!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "በጃኹም ስእሊ ክትወስዱልና ትኽእሉ ዶ?"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "እዚ Schöner Brunnen እዩ – ጽቡቕ ፈልፋሊ ማይ። ብሓቂ ከምኡ እዩ ዝበሃል!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "ኣብቲ ሓጹር ዘሎ ወርቃዊ ቀለቤት ትርእይዎ ዶ? እንተ ኣዝዊርኩምዎ፣ ምንዮት ክትምነዩ ትኽእሉ።"
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "Leo ሕጂ እንታይ ይገብር?"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: ነቲ ቀለቤት የዝውሮ፣ ምንዮት ድማ ይምነ።"
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: ነቲ ቀለቤት ናብ ገዛ ይወስዶ።"
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: ኣብቲ ፈልፋሊ ማይ ኣእዳዉ ይሓጽብ።"
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "ዝምነዮ … ሓደ Bratwurst እዩ!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "A! ግን ምንዮትኩም ንሓደ'ኳ ኣይትንገሩ – እንተዘይኮይኑ ኣይሰምርን።"
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "ምንዮት እምነ ኣለኹ።"
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "ኣብ ቅድሚኡ Frauenkirche ኣላ።"
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "ኣብ ላዕሊ ፍልይቲ ሰዓት ኣላ፦ መዓልታዊ ሰዓት ዓሰርተው ክልተ፣ ንኣሽቱ ምስልታት ንሃጸይ ይዘውርዎ።"
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "ሰዓት ክንደይ እዩ?"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "Leo ናብ ሰዓቱ ይጥምት፦ ሰዓት ዓሰርተው ክልተ ጎደል ርብዒ እዩ። ክንደይ ግዜ ክጽበዩ ኣለዎም?"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: ርብዒ ሰዓት (15 ደቒቕ)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: ሓደ ሰዓት"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: ኣርባዕተ ደቒቕ"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "A! „Viertel vor zwölf“ 11:45 እዩ። ክሳብ እቶም ንኣሽቱ ሰባት ዝጅምሩ ገና 15 ደቒቕ።"
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "ሰዓት ክንደይ እዩ?"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "ሰዓት ዓሰርተው ክልተ ጎደል ርብዒ እዩ።"
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "ኣብ መወዳእታ፦ Bratwurst!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "ሰላም! እንታይ ክህበኩም?"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: ኣነ ሰለስተ Bratwurst እየ።"
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: በጃኹም፣ ሰለስተ ኣብ ባኒ („im Weggla“) ደልየ ነይረ።"
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: ሰለስተ Bratwurst ሃብ!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "A! ኣነ ሰለስተ Bratwurst እየ!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "Leo፣ ንስኻ Bratwurst ኣይኮንካን! B! „Drei im Weggla“ – ኣብ Nürnberg ከምዚ ይበሃል፦ ሰለስተ ንኣሽቱ Bratwurst ኣብ ባኒ።"
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "„Weggla“ ብፍራንኮንኛ ባኒ ማለት እዩ።"
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "ምስ ሰናፍጭ?"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "እወ፣ ምስ ሰናፍጭ፣ በጃኹም።"
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "በጃኹም፣ ሰለስተ ኣብ ባኒ („im Weggla“) ደልየ ነይረ።"
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "እወ፣ ምስ ሰናፍጭ፣ በጃኹም።"
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "ንድሕሪ መግቢ ድማ፦ ናይ Nürnberg Lebkuchen (ብሽኮቲ ጂንጅብል)!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "ዋጋኡ ክትፈልጡ ትደልዩ። እንታይ ትሓቱ?"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: እቲ Lebkuchen ክንደይ ዋጋኡ?"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: እቲ Lebkuchen ክንደይ ዕድሚኡ እዩ? (ጌጋ)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: ኣነ ክንደይ ክቡር እየ?"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "A! ብ „Wie viel kostet …?“ ብዛዕባ ዋጋ ትሓቱ።"
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "ሓደ ፓኬት 4.50 € እዩ ዋጋኡ።"
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "ቅድም ዩሮ፣ ድሕሪኡ ሳንቲም በሉ፦ vier Euro fünfzig – ኣርባዕተ ዩሮ ሓምሳ።"
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "እቲ Lebkuchen ክንደይ ዋጋኡ?"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "ኣርባዕተ ዩሮ ሓምሳ።"
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "ኣብ ቤተ ክርስትያን St. Sebald ካብ ነሓስ ዝተሰርሐ ኣዝዩ ዓቢ መቓብር ኣሎ። ናብ ታሕቲ ተመልከቱ!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "እቲ መቓብር ኣብ ልዕሊ … ሓንዘዋት ደው ኢሉ?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "እቲ መቓብር ኣብ ልዕሊ እንታይ ደው ኢሉ ኣሎ?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: እቲ መቓብር ኣብ ትሕቲ ሓንዘዋት ደው ኢሉ ኣሎ።"
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: እቲ መቓብር ምስ ሓንዘዋት ይጓዓዝ ኣሎ።"
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: እቲ መቓብር ኣብ ልዕሊ ሓንዘዋት ደው ኢሉ ኣሎ።"
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! እሞ ትፈልጡ ዶ? እቶም ስነ-ጥበባውያን ዓሰርተው ሓደ ዓመት ሰሪሖምሉ።"
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "ምናልባት እቶም ሓንዘዋት ሓለፍቲ ነይሮም። ስለዚ እዩ ክንድዚ ነዊሕ ግዜ ዝወሰደ!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "ክንደይ ግዜ ወሲዱ? ዓሰርተው ሓደ ዓመት።"
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "ክንደይ ግዜ ወሲዱ?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "ዓሰርተው ሓደ ዓመት።"
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "ምሸት ኣብ Neptunbrunnen ኢና። Leo ድማ ከም Neptun ይጻወት …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "ኣነ ንጉስ ባሕሪ እየ!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "ሓንቲ መሓዛ ትድውል እሞ ትሓትት፦ „ኣብ Nürnberg ከመይ ነይሩ?“ እንታይ ትብሉ?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: Nürnberg ብጣዕሚ ፈትዩኒ። (ጌጋ!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: Nürnberg ብጣዕሚ ፈትየያ።"
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: Nürnberg ብጣዕሚ የሐጉሰኒ። (ጌጋ ኬዝ፦ „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! ምስ „gefallen“ እታ ከተማ እያ ባዓልቲ ግብሪ (ሱብጀክት)፦ Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "„Ich habe Nürnberg gefallen“ ድማ ማለት፦ እታ ከተማ ፈትያትኩም!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "Nürnberg ብጣዕሚ ፈትየያ።"
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "ንNürnberg ሰለስተ ምኽርታት። ቀዳማይ፦ እቲ ጥንታዊ ከተማ ንእሽቶ እዩ – ናብ ኩሉ ብእግሪ ክትበጽሑ ትኽእሉ።"
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "ካልኣይ፦ ኣብ ግዜ ኣድቨንት ኣብዚ እቲ ፍሉጥ Christkindlesmarkt (ዕዳጋ ልደት) ኣሎ።"
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "ሳልሳይ ድማ፦ Nürnberg ኣብ Franken፣ ኣብ Bayern ትርከብ። ስለዚ ብዙሕ ግዜ „Grüß Gott“ ትሰምዑ"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "ኣብ ክንዲ „Guten Tag“።"
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "ኣብ Nürnberg ብዙሓት ሰባት ፍራንኮንኛ ይዛረቡ። Leo ድማ ሓንቲ ቃል'ኳ ኣይርድኦን …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (ፍራንኮንኛ)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "ሓደ ባኒ!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (ሰላም!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "ደሓን ዋዓልኩም!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (ቻው!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "ቻው!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (ፍራንኮንኛ)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "ቁሩብ!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (ፍራንኮንኛ)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "ደሓን እዩ – ይኣክል!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "ናብ ጥንታዊ ከተማ ብኸመይ እበጽሕ? (ጌጋ)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! ናብቲ ጥንታዊ ከተማ ብኸመይ እበጽሕ?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "እቲ ገዛ ኣብ ውሽጢ ሩባ ደው ኢሉ ኣሎ።"
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "ኣብ ልዕሊ ሩባ! እቲ ገዛ ኣብ ልዕሊ ሩባ ደው ኢሉ ኣሎ።"
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (ጌጋ)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“ – Nürnberg ፈትየያ!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "ሕጂ ድማ ኩሉ ሓንሳብ ደጊምና። እተን ዓሰርተ ኣገደስቲ ሓረጋት። ድሕረይ ደግሙ!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "ይቕሬታ፣ ናብቲ ጥንታዊ ከተማ ብኸመይ እበጽሕ?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "እቶም ግምባታት ልዕሊ 80 ሜትሮ ቁመት ኣለዎም።"
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "እቲ ገዛ ኣብ ልዕሊ ሩባ ደው ኢሉ ኣሎ።"
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "በጃኹም ስእሊ ክትወስዱልና ትኽእሉ ዶ?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "ምንዮት እምነ ኣለኹ።"
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "ሰዓት ዓሰርተው ክልተ ጎደል ርብዒ እዩ።"
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "በጃኹም፣ ሰለስተ ኣብ ባኒ („im Weggla“) ደልየ ነይረ።"
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "እቲ Lebkuchen ክንደይ ዋጋኡ?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "ክንደይ ግዜ ወሲዱ?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Nürnberg ብጣዕሚ ፈትየያ።"
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "ብድሕሪ ሕጂ ኣየናይ ከተማ ጀርመን ክንበጽሕ ኣለና? ኣብ ርእይቶታት ጽሓፍዎ!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "ቻው – ቀልጢፍና ኣብ LilyLingua ክንራኸብ!"
    }
  ]
}
