      "start": 619.81,
      "end": 623.06,
      "text": "Casa stă deasupra râului."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Ați putea să ne faceți o poză, vă rog?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Îmi pun o dorință."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "E douăsprezece fără un sfert."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Aș dori trei în chiflă („im Weggla“), vă rog."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Cât costă turta dulce?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Cât a durat?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Nürnbergul mi-a plăcut foarte mult."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Ce oraș din Germania să vizităm data viitoare? Scrie în comentarii!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade, și pe curând la LilyLingua!"
    }
  ]
}
