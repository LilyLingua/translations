    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“！旧市街へはどう行けばいいですか？"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "家は川の中に建っている。"
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "川の上に！家は川の上に建っている。"
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“（間違い）"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“：ニュルンベルクが気に入りました！"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "では全部もう一度。いちばん大切な 10のフレーズ。リピートしよう！"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "すみません、旧市街へはどう行けばいいですか？"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "塔の高さは80メートル以上です。"
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "家は川の上に建っている。"
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "私たちの写真を撮っていただけませんか？"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "願い事をします。"
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "12時15分前です。"
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "パンに挟んだもの（„im Weggla“）を3本ください。"
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "このレープクーヘンはいくらですか？"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "それはどのくらいかかりましたか？"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "ニュルンベルクはとても気に入りました。"
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "次はドイツのどの街に行こう か？コメントで教えてね！"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade、またLilyLinguaで会おうね！"
    }
  ]
}
