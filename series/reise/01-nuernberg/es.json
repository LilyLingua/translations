    {
      "start": 511.58,
      "end": 517.39,
      "text": "¡B! Con „gefallen“, la ciudad es el sujeto: Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "Y „Ich habe Nürnberg gefallen“ significa: ¡tú le gustaste a la ciudad!"
