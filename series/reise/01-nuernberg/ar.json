  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "نحن في نورنبرغ! و… إلى أين الآن؟"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "ليو، أنت تمسك خريطة المدينة بالمقلوب!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "اليوم نقضي يومًا كاملًا في البلدة القديمة: مع الكنائس والنوافير والنقانق المشوية الشهيرة."
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "نقانق؟ أنا معكم!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "وفي كل مكان نسألك: ماذا تقول؟"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "ولديك خمس ثوانٍ فقط!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "تخرج من المحطة. تريد الذهاب إلى البلدة القديمة. بجانبك امرأة تنتظر عند الإشارة الضوئية."
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "ماذا تقول؟"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: بلدة قديمة. أين؟"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: عفوًا، كيف أصل إلى البلدة القديمة؟"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: عفوًا، كيف أصل عند بلدة قديمة؟ (حرف جر خاطئ)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "⁦C!⁩ تبدو جيدة."
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "تقريبًا يا ليو. نقول «⁦in die Altstadt⁩». A قصيرة جدًا وغير مهذبة. B ممتازة!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "سهل جدًا: امشي مستقيمًا من هنا، عبر البوابة، ثم على طول شارع Königstraße."
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "خمس دقائق!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "شكرًا جزيلًا!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "كرّر!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "عفوًا، كيف أصل إلى البلدة القديمة؟"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "الكنيسة الأولى: كنيسة القديس لورنز. انظر إلى الأعلى!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "واو! كم ارتفاع الأبراج؟"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "استمع جيدًا: ارتفاع الأبراج أكثر من ثمانين مترًا."
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "كم ارتفاع الأبراج؟"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: أكثر من 18 مترًا"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: أكثر من 80 مترًا"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: أكثر من 800 متر"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "⁦B!⁩ Achtzig (ثمانون)، مع «⁦-zig⁩» في النهاية. Achtzehn (ثمانية عشر) أقل بكثير."
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "والكنيسة قديمة جدًا: استغرق بناؤها أكثر من 200 سنة."
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "كرّر!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "كم ارتفاع الأبراج؟"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "أكثر من 80 مترًا."
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "نقف على الجسر. أمامنا: مستشفى الروح القدس. في الماضي كان هذا مستشفى."
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "انظر! البيت قائم في النهر!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "أين يقع البيت؟"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: البيت قائم في النهر."
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: البيت قائم على إلى النهر. (قواعد خاطئة)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: البيت قائم فوق النهر."
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "⁦C!⁩ تحت البيت قوسان، والماء يجري من تحتهما."
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "«⁦في النهر⁩» سيكون مبللًا جدًا!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "كرّر!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "البيت قائم فوق النهر."
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "تريدان صورة معًا. يمر رجل يرتدي خوذة دراجة."
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "ماذا تقول؟"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: صورة! بسرعة!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: هل يمكنك من فضلك سوف تصويري؟ (قواعد خاطئة)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: عفوًا، هل يمكنك من فضلك أن تلتقط لنا صورة؟"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "⁦C!⁩ مع «⁦Könnten Sie bitte …?⁩» (هل يمكنك من فضلك …؟) يبدو كل طلب لطيفًا."
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A أمر، وB فوضى في القواعد."
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "بالتأكيد! ابتسما… وواحدة أخرى. تفضلا، انتهينا!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "رائع، شكرًا جزيلًا!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "كرّر!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "هل يمكنك من فضلك أن تلتقط لنا صورة؟"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "هذه هي Schöner Brunnen، النافورة الجميلة. هذا اسمها فعلًا!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "هل ترى الحلقة الذهبية في السياج؟ إذا أدرتها، يمكنك أن تتمنى أمنية."
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "ماذا يفعل ليو الآن؟"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: يدير الحلقة ويتمنى أمنية."
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: يأخذ الحلقة معه إلى البيت."
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: يغسل يديه في النافورة."
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "أتمنى… نقانق!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "⁦A!⁩ لكن لا تكشف أمنيتك، وإلا فلن تتحقق."
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "كرّر!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "أتمنى أمنية."
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "في المقابل توجد كنيسة السيدة العذراء."
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "في الأعلى ساعة مميزة: كل يوم في الساعة الثانية عشرة تدور تماثيل صغيرة حول الإمبراطور."
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "كم الساعة؟"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "ينظر ليو إلى الساعة: إنها الثانية عشرة إلا ربعًا. كم عليهم أن ينتظروا؟"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: ربع ساعة (15 دقيقة)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: ساعة"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: أربع دقائق"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "⁦A!⁩ «⁦Viertel vor zwölf⁩» تعني 11:45. بقيت 15 دقيقة حتى تبدأ التماثيل الصغيرة بالدوران."
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "كرّر!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "كم الساعة؟"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "إنها الثانية عشرة إلا ربعًا."
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "أخيرًا: نقانق!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "أهلًا! ماذا تريد؟"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "ماذا تقول؟"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: أنا ثلاث نقانق."
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: أريد ثلاثًا في خبزة («⁦im Weggla⁩»)، من فضلك."
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: أعطِ ثلاث نقانق!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "⁦A!⁩ أنا ثلاث نقانق!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "ليو، أنت لست نقانق! B! «⁦Drei im Weggla⁩»: هكذا يقولون في نورنبرغ، ثلاث نقانق صغيرة في خبزة."
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "«⁦Weggla⁩» تعني خبزة باللهجة الفرانكونية."
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "مع الخردل؟"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "نعم، مع الخردل، من فضلك."
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "كرّر!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "أريد ثلاثًا في خبزة («⁦im Weggla⁩»)، من فضلك."
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "نعم، مع الخردل، من فضلك."
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "وللحلوى: كعك الزنجبيل Lebkuchen من نورنبرغ!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "تريد أن تعرف السعر. ماذا تسأل؟"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: بكم كعك الزنجبيل؟"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: كم كعك الزنجبيل عمره؟ (خطأ)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: كم ثمني أنا؟"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "⁦A!⁩ بـ «⁦Wie viel kostet …?⁩» تسأل عن السعر."
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "العلبة الواحدة بـ 4,50 €."
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "قل اليورو أولًا ثم السنتات: vier Euro fünfzig، أي أربعة يورو وخمسون."
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "كرّر!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "بكم كعك الزنجبيل؟"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "أربعة يورو وخمسون."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "في كنيسة القديس زيبالد يوجد ضريح ضخم من البرونز. انظر إلى الأسفل!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "الضريح يقف على… حلزونات؟!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "على ماذا يقف الضريح؟"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: الضريح يقف تحت حلزونات."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: الضريح يمشي مع حلزونات."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: الضريح يقف على حلزونات."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "⁦C!⁩ وهل تعرف؟ عمل الفنانون عليه أحد عشر عامًا."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "ربما كانت الحلزونات هي الرئيسة. لهذا استغرق الأمر وقتًا طويلًا!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "كم استغرق ذلك؟ أحد عشر عامًا."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "كرّر!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "كم استغرق ذلك؟"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "أحد عشر عامًا."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "في المساء نحن عند نافورة نبتون. وليو يمثل دور نبتون…"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "أنا ملك البحر!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "صديقة تتصل وتسأل: «⁦كيف كانت نورنبرغ؟⁩» ماذا تقول؟"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: أعجبتُ نورنبرغ كثيرًا. (خطأ!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: أعجبتني نورنبرغ كثيرًا."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: نورنبرغ تعجبني إياي كثيرًا. (حالة إعرابية خاطئة: «⁦mich⁩»)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "⁦B!⁩ مع «⁦gefallen⁩» تكون المدينة هي الفاعل: Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "و«⁦Ich habe Nürnberg gefallen⁩» تعني: أنت من أعجب المدينة!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "كرّر!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "أعجبتني نورنبرغ كثيرًا."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "ثلاث نصائح لنورنبرغ. أولًا: البلدة القديمة صغيرة، تصل إلى كل مكان مشيًا."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "ثانيًا: في فترة المجيء يقام هنا سوق Christkindlesmarkt الشهير، سوق عيد الميلاد."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "وثالثًا: تقع نورنبرغ في فرانكونيا، في بافاريا."
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "لذلك تسمع كثيرًا «⁦Grüß Gott⁩» بدلًا من «⁦Guten Tag⁩»."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "في نورنبرغ يتحدث كثير من الناس اللهجة الفرانكونية. وليو لا يفهم شيئًا…"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "⁦A⁩ Weggla? (فرانكونية)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "خبزة صغيرة!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (مرحبًا!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "نهارك سعيد!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (مع السلامة!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "إلى اللقاء!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "⁦A⁩ weng? (فرانكونية)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "قليلًا!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (فرانكونية)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Passt schon: لا بأس، تمام!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "كيف أصل عند بلدة قديمة؟ (خطأ)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "«⁦In die Altstadt⁩»! كيف أصل إلى البلدة القديمة؟"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "البيت قائم في النهر."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "فوق النهر! البيت قائم فوق النهر."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "«⁦Ich habe Nürnberg gefallen.⁩» (خطأ)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "«⁦Nürnberg hat mir gefallen!⁩»: أعجبتني نورنبرغ!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "والآن كل شيء مرة أخرى. أهم عشر جمل. كرّر!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "عفوًا، كيف أصل إلى البلدة القديمة؟"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "ارتفاع الأبراج أكثر من 80 مترًا."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "البيت قائم فوق النهر."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "هل يمكنك من فضلك أن تلتقط لنا صورة؟"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "أتمنى أمنية."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "إنها الثانية عشرة إلا ربعًا."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "أريد ثلاثًا في خبزة («⁦im Weggla⁩»)، من فضلك."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "بكم كعك الزنجبيل؟"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "كم استغرق ذلك؟"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "أعجبتني نورنبرغ كثيرًا."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "أي مدينة في ألمانيا نزور في المرة القادمة؟ اكتبها في التعليقات!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade، وإلى اللقاء قريبًا في LilyLingua!"
    }
  ]
}
