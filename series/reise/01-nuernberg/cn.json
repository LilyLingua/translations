    {
      "start": 593.73,
      "end": 595.94,
      "text": "「Nürnberg hat mir gefallen!」：我很喜欢纽伦堡！"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "现在把所有内容再来一遍。 最重要的十句话。跟我说！"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "不好意思，请问去老城怎么走？"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "塔高超过80米。"
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "房子横跨在河上方。"
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "能请您帮我们拍张照吗？"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "我许个愿。"
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "现在差一刻十二点。"
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "请给我三根夹在小面包里的（「im Weggla」）。"
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "姜饼多少钱？"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "这花了多长时间？"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "我很喜欢纽伦堡。"
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "下次我们去德国哪个城市？写在评论里吧！"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Ade，LilyLingua下次见！"
    }
  ]
