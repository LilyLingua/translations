  "subtitles": [
    {
      "start": 0.4,
      "end": 4.44,
      "text": "Me oleme Nürnbergis! Ja … kuhu me nüüd läheme?"
    },
    {
      "start": 4.54,
      "end": 7.48,
      "text": "Leo, sa hoiad linnakaarti tagurpidi!"
    },
    {
      "start": 7.53,
      "end": 14.98,
      "text": "Täna veedame terve päeva vanalinnas – kirikute, purskkaevude ja kuulsa praevorstiga."
    },
    {
      "start": 15.08,
      "end": 17.68,
      "text": "Praevorst? Mina olen kindlasti nõus!"
    },
    {
      "start": 17.78,
      "end": 21.19,
      "text": "Ja igal pool küsime sinult: mida sa ütled?"
    },
    {
      "start": 21.29,
      "end": 23.5,
      "text": "Ja sul on ainult viis sekundit!"
    },
    {
      "start": 26.8,
      "end": 33.24,
      "text": "Sa tuled jaamast välja. Sa tahad minna vanalinna. Sinu kõrval ootab valgusfoori juures üks naine."
    },
    {
      "start": 33.34,
      "end": 34.74,
      "text": "Mida sa ütled?"
    },
    {
      "start": 34.84,
      "end": 37.86,
      "text": "A: Vanalinn. Kus?"
    },
    {
      "start": 37.91,
      "end": 41.79,
      "text": "B: Vabandust, kuidas ma vanalinna saan?"
    },
    {
      "start": 41.84,
      "end": 45.72,
      "text": "C: Vabandust, kuidas ma vanalinnale saan? (vale eessõna)"
    },
    {
      "start": 50.92,
      "end": 52.89,
      "text": "C! Kõlab ju hästi."
    },
    {
      "start": 53.54,
      "end": 61.42,
      "text": "Peaaegu, Leo. Õige on „in die Altstadt“. A on liiga lühike ja ebaviisakas. B on täiuslik!"
    },
    {
      "start": 61.67,
      "end": 68.11,
      "text": "Väga lihtne: minge siit otse, läbi värava, ja siis kogu aeg mööda Königstraße’t."
    },
    {
      "start": 68.16,
      "end": 69.36,
      "text": "Viis minutit!"
    },
    {
      "start": 69.41,
      "end": 70.81,
      "text": "Suur aitäh!"
    },
    {
      "start": 70.91,
      "end": 72.24,
      "text": "Korda minu järel!"
    },
    {
      "start": 72.29,
      "end": 76.17,
      "text": "Vabandust, kuidas ma vanalinna saan?"
    },
    {
      "start": 81.5,
      "end": 85.8,
      "text": "Esimene kirik: St. Lorenz. Vaata üles!"
    },
    {
      "start": 85.89,
      "end": 88.73,
      "text": "Vau! Kui kõrged need tornid on?"
    },
    {
      "start": 88.83,
      "end": 93.76,
      "text": "Kuula hoolega: tornid on üle kaheksakümne meetri kõrged."
    },
    {
      "start": 93.86,
      "end": 95.83,
      "text": "Kui kõrged on tornid?"
    },
    {
      "start": 95.93,
      "end": 98.77,
      "text": "A: üle 18 meetri"
    },
    {
      "start": 98.82,
      "end": 101.65,
      "text": "B: üle 80 meetri"
    },
    {
      "start": 101.7,
      "end": 104.64,
      "text": "C: üle 800 meetri"
    },
    {
      "start": 110.34,
      "end": 115.56,
      "text": "B! Achtzig (kaheksakümmend) – lõpus „-zig“. Achtzehn (kaheksateist) on palju väiksem."
    },
    {
      "start": 115.61,
      "end": 121.75,
      "text": "Ja kirik on väga vana: seda ehitati üle 200 aasta."
    },
    {
      "start": 122,
      "end": 123.33,
      "text": "Korda minu järel!"
    },
    {
      "start": 123.38,
      "end": 125.72,
      "text": "Kui kõrged on tornid?"
    },
    {
      "start": 128.77,
      "end": 131.42,
      "text": "Üle 80 meetri."
    },
    {
      "start": 135.34,
      "end": 142.27,
      "text": "Me seisame sillal. Meie ees: Püha Vaimu hospidal. Varem oli see haigla."
    },
    {
      "start": 142.37,
      "end": 145.31,
      "text": "Vaata! Maja seisab jões!"
    },
    {
      "start": 145.41,
      "end": 147.23,
      "text": "Kus maja seisab?"
    },
    {
      "start": 147.33,
      "end": 150.43,
      "text": "A: Maja seisab jões."
    },
    {
      "start": 150.48,
      "end": 153.73,
      "text": "B: Maja seisab jõe peal. (vale grammatika)"
    },
    {
      "start": 153.78,
      "end": 157.12,
      "text": "C: Maja seisab jõe kohal."
    },
    {
      "start": 162.82,
      "end": 168.8,
      "text": "C! Maja all on kaks kaart – ja vesi voolab nende alt läbi."
    },
    {
      "start": 168.85,
      "end": 171.58,
      "text": "„Jões“ oleks üsna märg!"
    },
    {
      "start": 171.83,
      "end": 173.16,
      "text": "Korda minu järel!"
    },
    {
      "start": 173.21,
      "end": 176.36,
      "text": "Maja seisab jõe kohal."
    },
    {
      "start": 180.84,
      "end": 185.14,
      "text": "Te tahate koos fotot. Mööda läheb jalgratturikiivriga mees."
    },
    {
      "start": 185.24,
      "end": 186.56,
      "text": "Mida sa ütled?"
    },
    {
      "start": 186.66,
      "end": 189.26,
      "text": "A: Foto teha! Kiiresti!"
    },
    {
      "start": 189.31,
      "end": 192.8,
      "text": "B: Kas te saate mind palun pildistama hakkab? (vale grammatika)"
    },
    {
      "start": 192.85,
      "end": 197.39,
      "text": "C: Vabandust, kas te saaksite palun meist foto teha?"
    },
    {
      "start": 203.09,
      "end": 208.37,
      "text": "C! Väljendiga „Könnten Sie bitte …?“ (Kas te saaksite palun …?) kõlab iga palve sõbralikult."
    },
    {
      "start": 208.42,
      "end": 212.74,
      "text": "A on käsk – ja B on grammatikakaos."
    },
    {
      "start": 212.99,
      "end": 217.53,
      "text": "Muidugi! Naeratage, palun … ja veel üks. Palun väga!"
    },
    {
      "start": 217.63,
      "end": 219.68,
      "text": "Super, suur aitäh!"
    },
    {
      "start": 219.78,
      "end": 221.11,
      "text": "Korda minu järel!"
    },
    {
      "start": 221.16,
      "end": 224.41,
      "text": "Kas te saaksite palun meist foto teha?"
    },
    {
      "start": 229.01,
      "end": 232.58,
      "text": "See on Schöner Brunnen – Ilus purskkaev. Selle nimi on tõesti selline!"
    },
    {
      "start": 232.68,
      "end": 238.81,
      "text": "Kas näete võre sees kuldset rõngast? Kui te seda keerate, võite midagi soovida."
    },
    {
      "start": 238.91,
      "end": 240.81,
      "text": "Mida Leo nüüd teeb?"
    },
    {
      "start": 240.91,
      "end": 244.79,
      "text": "A: Ta keerab rõngast ja soovib midagi."
    },
    {
      "start": 244.84,
      "end": 248.01,
      "text": "B: Ta võtab rõnga koju kaasa."
    },
    {
      "start": 248.06,
      "end": 251.4,
      "text": "C: Ta peseb purskkaevus käsi."
    },
    {
      "start": 256.6,
      "end": 260.01,
      "text": "Ma soovin … ühte praevorsti!"
    },
    {
      "start": 260.66,
      "end": 265.89,
      "text": "A! Aga ära räägi oma soovi kellelegi – muidu see ei täitu."
    },
    {
      "start": 266.14,
      "end": 267.47,
      "text": "Korda minu järel!"
    },
    {
      "start": 267.52,
      "end": 269.76,
      "text": "Ma soovin midagi."
    },
    {
      "start": 273.19,
      "end": 275.49,
      "text": "Vastas on Frauenkirche ehk Neitsi Maarja kirik."
    },
    {
      "start": 275.54,
      "end": 282.04,
      "text": "Üleval on eriline kell: iga päev kell kaksteist liiguvad väikesed kujukesed keisri ümber."
    },
    {
      "start": 282.13,
      "end": 283.87,
      "text": "Mis kell on?"
    },
    {
      "start": 283.97,
      "end": 289.79,
      "text": "Leo vaatab kella: kell on veerand kaksteist puudu. Kui kaua nad peavad ootama?"
    },
    {
      "start": 289.89,
      "end": 293.85,
      "text": "A: veerand tundi (15 minutit)"
    },
    {
      "start": 293.9,
      "end": 296.26,
      "text": "B: tund aega"
    },
    {
      "start": 296.31,
      "end": 298.68,
      "text": "C: neli minutit"
    },
    {
      "start": 304.38,
      "end": 311.63,
      "text": "A! „Viertel vor zwölf“ on 11.45. Veel 15 minutit, kuni mehikesed hakkavad liikuma."
    },
    {
      "start": 311.88,
      "end": 313.21,
      "text": "Korda minu järel!"
    },
    {
      "start": 313.26,
      "end": 315.39,
      "text": "Mis kell on?"
    },
    {
      "start": 318.2,
      "end": 320.96,
      "text": "Kell on veerand kaksteist puudu."
    },
    {
      "start": 324.99,
      "end": 327.52,
      "text": "Lõpuks: praevorst!"
    },
    {
      "start": 327.62,
      "end": 329.83,
      "text": "Tere! Mida teile?"
    },
    {
      "start": 329.93,
      "end": 331.3,
      "text": "Mida sa ütled?"
    },
    {
      "start": 331.35,
      "end": 334.45,
      "text": "A: Ma olen kolm praevorsti."
    },
    {
      "start": 334.5,
      "end": 338.07,
      "text": "B: Ma sooviksin kolm kuklis („im Weggla“), palun."
    },
    {
      "start": 338.12,
      "end": 340.88,
      "text": "C: Andke kolm praevorst!"
    },
    {
      "start": 346.08,
      "end": 349.02,
      "text": "A! Ma olen kolm praevorsti!"
    },
    {
      "start": 349.67,
      "end": 358.85,
      "text": "Leo, sa ei ole praevorst! B! „Drei im Weggla“ – nii öeldakse Nürnbergis: kolm väikest praevorsti saiakuklis."
    },
    {
      "start": 358.9,
      "end": 362.12,
      "text": "„Weggla“ on frangi murdes saiakukkel."
    },
    {
      "start": 362.37,
      "end": 363.61,
      "text": "Sinepiga?"
    },
    {
      "start": 363.71,
      "end": 365.68,
      "text": "Jah, sinepiga, palun."
    },
    {
      "start": 365.78,
      "end": 367.11,
      "text": "Korda minu järel!"
    },
    {
      "start": 367.16,
      "end": 370.52,
      "text": "Ma sooviksin kolm kuklis („im Weggla“), palun."
    },
    {
      "start": 374.74,
      "end": 377.19,
      "text": "Jah, sinepiga, palun."
    },
    {
      "start": 380.86,
      "end": 384.43,
      "text": "Ja magustoiduks: Nürnbergi piparkoogid!"
    },
    {
      "start": 384.53,
      "end": 387.78,
      "text": "Sa tahad teada hinda. Mida sa küsid?"
    },
    {
      "start": 387.88,
      "end": 390.9,
      "text": "A: Kui palju piparkook maksab?"
    },
    {
      "start": 390.95,
      "end": 394.21,
      "text": "B: Kui palju on piparkook vana? (vale)"
    },
    {
      "start": 394.26,
      "end": 396.86,
      "text": "C: Kui kallis ma olen?"
    },
    {
      "start": 402.56,
      "end": 407.48,
      "text": "A! Küsimusega „Wie viel kostet …?“ küsid sa hinda."
    },
    {
      "start": 407.73,
      "end": 410.83,
      "text": "Üks pakk maksab 4,50 €."
    },
    {
      "start": 410.93,
      "end": 416.09,
      "text": "Ütle kõigepealt eurod, siis sendid: vier Euro fünfzig – neli eurot viiskümmend."
    },
    {
      "start": 416.19,
      "end": 417.52,
      "text": "Korda minu järel!"
    },
    {
      "start": 417.57,
      "end": 420.12,
      "text": "Kui palju piparkook maksab?"
    },
    {
      "start": 423.41,
      "end": 425.86,
      "text": "Neli eurot viiskümmend."
    },
    {
      "start": 429.53,
      "end": 435.26,
      "text": "St. Sebaldi kirikus on hiiglaslik pronkshaud. Vaata alla!"
    },
    {
      "start": 435.37,
      "end": 438.62,
      "text": "Haud seisab … tigude peal?!"
    },
    {
      "start": 438.72,
      "end": 440.93,
      "text": "Mille peal haud seisab?"
    },
    {
      "start": 441.03,
      "end": 444.28,
      "text": "A: Haud seisab tigude all."
    },
    {
      "start": 444.33,
      "end": 447.51,
      "text": "B: Haud kõnnib tigudega."
    },
    {
      "start": 447.56,
      "end": 450.65,
      "text": "C: Haud seisab tigude peal."
    },
    {
      "start": 456.36,
      "end": 461.93,
      "text": "C! Ja tead mis? Kunstnikud töötasid selle kallal üksteist aastat."
    },
    {
      "start": 462.18,
      "end": 466.56,
      "text": "Võib-olla olid tigud ülemused. Sellepärast kestiski see nii kaua!"
    },
    {
      "start": 466.66,
      "end": 470.7,
      "text": "Kui kaua see kestis? Üksteist aastat."
    },
    {
      "start": 470.8,
      "end": 472.13,
      "text": "Korda minu järel!"
    },
    {
      "start": 472.18,
      "end": 474.52,
      "text": "Kui kaua see kestis?"
    },
    {
      "start": 477.57,
      "end": 479.49,
      "text": "Üksteist aastat."
    },
    {
      "start": 482.56,
      "end": 487.18,
      "text": "Õhtul oleme Neptuni purskkaevu juures. Ja Leo mängib Neptuni …"
    },
    {
      "start": 487.28,
      "end": 490.04,
      "text": "Mina olen mere kuningas!"
    },
    {
      "start": 490.13,
      "end": 495.14,
      "text": "Sõbranna helistab ja küsib: „Kuidas Nürnbergis oli?“ Mida sa ütled?"
    },
    {
      "start": 495.24,
      "end": 498.73,
      "text": "A: Nürnbergile meeldisin mina väga. (vale!)"
    },
    {
      "start": 498.78,
      "end": 502.35,
      "text": "B: Mulle meeldis Nürnberg väga."
    },
    {
      "start": 502.4,
      "end": 505.88,
      "text": "C: Nürnberg meeldib mind väga. (vale kääne: „mich“)"
    },
    {
      "start": 511.58,
      "end": 517.39,
      "text": "B! Tegusõna „gefallen“ puhul on linn alus: Nürnberg hat mir gefallen."
    },
    {
      "start": 517.45,
      "end": 523.22,
      "text": "Ja „Ich habe Nürnberg gefallen“ tähendab: sina meeldisid linnale!"
    },
    {
      "start": 523.47,
      "end": 524.8,
      "text": "Korda minu järel!"
    },
    {
      "start": 524.85,
      "end": 528.11,
      "text": "Mulle meeldis Nürnberg väga."
    },
    {
      "start": 532.71,
      "end": 539.31,
      "text": "Kolm nõuannet Nürnbergi jaoks. Esiteks: vanalinn on väike – igale poole saab jalgsi."
    },
    {
      "start": 539.56,
      "end": 544.49,
      "text": "Teiseks: advendiajal on siin kuulus Christkindlesmarkt (jõuluturg)."
    },
    {
      "start": 544.74,
      "end": 548.46,
      "text": "Ja kolmandaks: Nürnberg asub Frangimaal, Baieris. Sellepärast kuuled sa tihti „Grüß Gott“"
    },
    {
      "start": 548.51,
      "end": 552.53,
      "text": "„Guten Tag“ asemel."
    },
    {
      "start": 552.88,
      "end": 558.62,
      "text": "Paljud inimesed Nürnbergis räägivad frangi murret. Ja Leo ei saa sõnagi aru …"
    },
    {
      "start": 558.87,
      "end": 560.11,
      "text": "A Weggla? (frangi murre)"
    },
    {
      "start": 560.46,
      "end": 562.2,
      "text": "Saiakukkel!"
    },
    {
      "start": 562.85,
      "end": 564.17,
      "text": "Grüß Gott! (Tere!)"
    },
    {
      "start": 564.52,
      "end": 565.72,
      "text": "Tere päevast!"
    },
    {
      "start": 566.34,
      "end": 567.54,
      "text": "Ade! (Head aega!)"
    },
    {
      "start": 567.85,
      "end": 569.05,
      "text": "Head aega!"
    },
    {
      "start": 569.59,
      "end": 570.83,
      "text": "A weng? (frangi murre)"
    },
    {
      "start": 571.18,
      "end": 572.66,
      "text": "Natuke!"
    },
    {
      "start": 573.31,
      "end": 574.78,
      "text": "Bassd scho! (frangi murre)"
    },
    {
      "start": 575.13,
      "end": 577.58,
      "text": "Pole hullu – see on okei!"
    },
    {
      "start": 578.23,
      "end": 580.44,
      "text": "Kuidas ma vanalinnale saan? (vale)"
    },
    {
      "start": 580.59,
      "end": 584.16,
      "text": "„In die Altstadt“! Kuidas ma vanalinna saan?"
    },
    {
      "start": 584.61,
      "end": 586.82,
      "text": "Maja seisab jões."
    },
    {
      "start": 586.97,
      "end": 590.85,
      "text": "Jõe kohal! Maja seisab jõe kohal."
    },
    {
      "start": 591.3,
      "end": 593.58,
      "text": "„Ich habe Nürnberg gefallen.“ (vale)"
    },
    {
      "start": 593.73,
      "end": 595.94,
      "text": "„Nürnberg hat mir gefallen!“ – Mulle meeldis Nürnberg!"
    },
    {
      "start": 596.39,
      "end": 601.89,
      "text": "Ja nüüd kõik veel kord. Kümme kõige tähtsamat lauset. Korda minu järel!"
    },
    {
      "start": 601.94,
      "end": 605.83,
      "text": "Vabandust, kuidas ma vanalinna saan?"
    },
    {
      "start": 610.65,
      "end": 614.74,
      "text": "Tornid on üle 80 meetri kõrged."
    },
    {
      "start": 619.81,
      "end": 623.06,
      "text": "Maja seisab jõe kohal."
    },
    {
      "start": 627.16,
      "end": 630.52,
      "text": "Kas te saaksite palun meist foto teha?"
    },
    {
      "start": 634.75,
      "end": 637.09,
      "text": "Ma soovin midagi."
    },
    {
      "start": 640.14,
      "end": 642.79,
      "text": "Kell on veerand kaksteist puudu."
    },
    {
      "start": 646.21,
      "end": 649.46,
      "text": "Ma sooviksin kolm kuklis („im Weggla“), palun."
    },
    {
      "start": 653.57,
      "end": 656.22,
      "text": "Kui palju piparkook maksab?"
    },
    {
      "start": 659.63,
      "end": 661.97,
      "text": "Kui kaua see kestis?"
    },
    {
      "start": 665.03,
      "end": 668.28,
      "text": "Mulle meeldis Nürnberg väga."
    },
    {
      "start": 672.39,
      "end": 677.39,
      "text": "Millist Saksamaa linna peaksime järgmisena külastama? Kirjuta see kommentaaridesse!"
    },
    {
      "start": 677.49,
      "end": 680.9,
      "text": "Head aega – ja kohtumiseni LilyLinguas!"
    }
  ]
}
