      "text": "رغيف خبز – أو كيس خبز توست!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "علبة زبادي من المعكرونة."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "كيس معكرونة!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "علبة كرتون ماء."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "زجاجة ماء!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "كيس طماطم."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "علبة طماطم!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "«⁦Wo finde ich der Käse?⁩»"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "«⁦Den Käse⁩»! «⁦Wo finde ich den Käse?⁩» (أين أجد الجبن؟)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "والفعل يأتي في النهاية: ليس «⁦Ich möchte bezahlen mit Karte⁩»، بل: «⁦Ich möchte mit Karte bezahlen.⁩» (أريد الدفع بالبطاقة.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "وعند الصندوق: «⁦Bon⁩» هو الإيصال. «⁦Bonbon⁩» هي قطعة حلوى."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "والآن كل شيء مرة أخرى. أهم عشر جمل. كرّر!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "هل يمكنك أن تصرف لي خمسة يورو؟"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "عفوًا، أين أجد الطحين؟"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "أريد 200 غرام غودا، من فضلك."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "نعم، لا بأس."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "لا، شكرًا. هذا كل شيء."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "الموز في العرض."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "أين آلة استرجاع العبوات؟"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "معي حقيبة."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "هل يمكنني الدفع بالبطاقة؟"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "شكرًا، ولك أيضًا!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "ما أكثر شيء تحب شراءه من السوبرماركت؟ اكتبه في التعليقات!"
    },
    {
      "start": 669.37,
      "end": 672.39,
      "text": "مع السلامة، وإلى اللقاء قريبًا في LilyLingua!"
    }
  ]
}
