  "subtitles": [
    {
      "start": 0.4,
      "end": 5.17,
      "text": "በጣም ርቦኛል! ግን ማቀዝቀዣዬ ባዶ ነው።"
    },
    {
      "start": 5.27,
      "end": 7.71,
      "text": "እንግዲያው ወደ ሱፐርማርኬት!"
    },
    {
      "start": 7.81,
      "end": 10.57,
      "text": "ሱፐርማርኬት? ሙሉ በሙሉ በጀርመንኛ?"
    },
    {
      "start": 10.67,
      "end": 16.98,
      "text": "በእርግጥ! ዛሬ አንድ ሙሉ ግብይት ያደርጋሉ – ከዕቃ መግፊያ ጋሪው እስከ ደረሰኙ ድረስ።"
    },
    {
      "start": 17.03,
      "end": 21.29,
      "text": "በእያንዳንዱ ሁኔታም እንጠይቅዎታለን፦ ምን ይላሉ?"
    },
    {
      "start": 21.39,
      "end": 23.76,
      "text": "ደግሞም ያለዎት አምስት ሰከንድ ብቻ ነው!"
    },
    {
      "start": 27.06,
      "end": 34.36,
      "text": "የዕቃ መግፊያ ጋሪ ይፈልጋሉ። ግን ለዚያ ሳንቲም ያስፈልግዎታል – እርስዎ ግን ያለዎት የ5 ዩሮ ኖት ብቻ ነው።"
    },
    {
      "start": 34.41,
      "end": 36.95,
      "text": "ከጎንዎ አንድ አዛውንት ቆመዋል።"
    },
    {
      "start": 37.05,
      "end": 38.52,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 38.62,
      "end": 42.74,
      "text": "A: ይቅርታ፣ 5 ዩሮ በስጦታ ሊሰጡኝ ይችላሉ?"
    },
    {
      "start": 42.79,
      "end": 47.01,
      "text": "B: ይቅርታ፣ 5 ዩሮ ሊዘረዝሩልኝ ይችላሉ?"
    },
    {
      "start": 47.06,
      "end": 50.79,
      "text": "C: ይቅርታ፣ ጋሪዎን እፈልጋለሁ።"
    },
    {
      "start": 56.49,
      "end": 62.73,
      "text": "B! „Wechseln“ ማለት፦ ኖት ሰጥተው ሳንቲሞችን ይቀበላሉ ማለት ነው። „Schenken“"
    },
    {
      "start": 62.78,
      "end": 68.94,
      "text": "ማለት ደግሞ፦ በነፃ ያገኙታል ማለት ነው – ያ በጣም ደግ ይሆን ነበር፣ ግን ትንሽ ድፍረት ነው።"
    },
    {
      "start": 69.19,
      "end": 74.35,
      "text": "አንድ ደቂቃ … አዎ፦ ሁለት፣ አራት፣ አምስት ዩሮ። ይኸውልዎት!"
    },
    {
      "start": 74.45,
      "end": 75.84,
      "text": "በጣም አመሰግናለሁ!"
    },
    {
      "start": 75.94,
      "end": 77.35,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 77.4,
      "end": 80.45,
      "text": "5 ዩሮ ሊዘረዝሩልኝ ይችላሉ?"
    },
    {
      "start": 84.81,
      "end": 91.49,
      "text": "ዱቄት ያስፈልግዎታል። ግን ዱቄቱ የት ነው? አንድ ሠራተኛ መደርደሪያ እየሞላ ነው።"
    },
    {
      "start": 91.59,
      "end": 93.14,
      "text": "ምን ብለው ይጠይቃሉ?"
    },
    {
      "start": 93.24,
      "end": 96.89,
      "text": "A: ይቅርታ፣ ዱቄት የት አገኛለሁ?"
    },
    {
      "start": 96.94,
      "end": 99.38,
      "text": "B: „Wo ist der Mehl?“ (የተሳሳተ አርቲክል)"
    },
    {
      "start": 99.43,
      "end": 102.19,
      "text": "C: ዱቄት አግኝተዋል?"
    },
    {
      "start": 107.39,
      "end": 109.83,
      "text": "B! „Wo ist der Mehl?“"
    },
    {
      "start": 110.48,
      "end": 117.53,
      "text": "ተቃርበሃል፣ Leo። „das Mehl“ ነው። ግን A የበለጠ ጥሩ ነው፦ „Entschuldigung, wo finde ich …?“"
    },
    {
      "start": 117.58,
      "end": 121.66,
      "text": "(ይቅርታ፣ … የት አገኛለሁ?) – በሱፐርማርኬት ውስጥ ማንኛውንም ነገር በትሕትና የሚጠይቁት እንዲህ ነው።"
    },
    {
      "start": 121.91,
      "end": 125.55,
      "text": "ዱቄት በመተላለፊያ 3 ውስጥ ነው፣ በመደርደሪያው ታችኛው ክፍል።"
    },
    {
      "start": 125.65,
      "end": 126.97,
      "text": "አመሰግናለሁ!"
    },
    {
      "start": 127.07,
      "end": 128.48,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 128.53,
      "end": 132.09,
      "text": "ይቅርታ፣ ዱቄት የት አገኛለሁ?"
    },
    {
      "start": 136.56,
      "end": 139.6,
      "text": "መተላለፊያ 3፣ ታች።"
    },
    {
      "start": 143.97,
      "end": 147.62,
      "text": "አሁን ወደ ትኩስ ምግቦች መሸጫ ይሄዳሉ። ትንሽ Gouda ይፈልጋሉ።"
    },
    {
      "start": 147.72,
      "end": 150.08,
      "text": "ጤና ይስጥልኝ! ምን ልስጥዎት?"
    },
    {
      "start": 150.18,
      "end": 151.4,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 151.45,
      "end": 154.86,
      "text": "A: እኔ 200 ግራም Gouda ነኝ።"
    },
    {
      "start": 154.91,
      "end": 157.85,
      "text": "B: አዎ፣ ሊሆን ይችላል።"
    },
    {
      "start": 157.9,
      "end": 162.12,
      "text": "C: 200 ግራም Gouda እፈልግ ነበር፣ እባክዎ።"
    },
    {
      "start": 167.82,
      "end": 174.01,
      "text": "C! „Was darf's sein?“ ማለት በቀላሉ፦ ምን ይፈልጋሉ? ማለት ነው። በ„Ich hätte gern …“"
    },
    {
      "start": 174.06,
      "end": 179.31,
      "text": "(… እፈልግ ነበር) ደግሞ ሁልጊዜ በትሕትና ያዛሉ – በመሸጫው፣ በዳቦ ቤት፣ በካፌ።"
    },
    {
      "start": 179.56,
      "end": 180.96,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 181.01,
      "end": 184.79,
      "text": "200 ግራም Gouda እፈልግ ነበር፣ እባክዎ።"
    },
    {
      "start": 190,
      "end": 195.81,
      "text": "ወይዘሮ Haas አይቡን ትቆርጣለች። ሚዛኑ 230 ግራም ያሳያል።"
    },
    {
      "start": 195.91,
      "end": 198.35,
      "text": "ትንሽ ቢበልጥ ችግር የለውም?"
    },
    {
      "start": 198.45,
      "end": 199.68,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 199.72,
      "end": 202.74,
      "text": "A: አይ፣ አይፈቀድልኝም።"
    },
    {
      "start": 202.79,
      "end": 205.97,
      "text": "B: አዎ፣ ችግር የለውም።"
    },
    {
      "start": 206.02,
      "end": 209.67,
      "text": "C: አዎ፣ እኔ ትንሽ እበልጣለሁ።"
    },
    {
      "start": 215.37,
      "end": 223.63,
      "text": "B! ይህን ዓረፍተ ነገር በጀርመን በእያንዳንዱ መሸጫ ይሰማሉ። ትርጉሙ፦ ካዘዙት ትንሽ ይበልጣል – ችግር የለውም?"
    },
    {
      "start": 223.68,
      "end": 228.05,
      "text": "ካልሆነ በቀላሉ ይበሉ፦ „Nein, bitte genau 200 Gramm.“ (አይ፣ እባክዎ በትክክል 200 ግራም።)"
    },
    {
      "start": 228.3,
      "end": 229.86,
      "text": "ሌላ ነገር አለ?"
    },
    {
      "start": 229.96,
      "end": 232.56,
      "text": "አይ፣ አመሰግናለሁ። ይኸው ነው።"
    },
    {
      "start": 232.66,
      "end": 234.06,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 234.11,
      "end": 236.77,
      "text": "አዎ፣ ችግር የለውም።"
    },
    {
      "start": 240.18,
      "end": 243.43,
      "text": "አይ፣ አመሰግናለሁ። ይኸው ነው።"
    },
    {
      "start": 248.04,
      "end": 253.2,
      "text": "መሄድዎን ይቀጥላሉ። በድንገት ማስታወቂያ ይሰማሉ። በጥንቃቄ ያዳምጡ!"
    },
    {
      "start": 253.3,
      "end": 260.34,
      "text": "ውድ ደንበኞቻችን! የዛሬ ቅናሽ፦ ሙዝ፣ በኪሎ 99 ሳንቲም ብቻ።"
    },
    {
      "start": 260.44,
      "end": 263.12,
      "text": "አንድ ኪሎ ሙዝ ስንት ነው?"
    },
    {
      "start": 263.22,
      "end": 265.98,
      "text": "A: 9.90 ዩሮ"
    },
    {
      "start": 266.03,
      "end": 269.05,
      "text": "B: 1.99 ዩሮ"
    },
    {
      "start": 269.1,
      "end": 271.78,
      "text": "C: 99 ሳንቲም"
    },
    {
      "start": 277.48,
      "end": 283.92,
      "text": "C! 99 ሳንቲም። „Im Angebot“ ማለት፦ ዛሬ ከወትሮው ርካሽ ነው ማለት ነው።"
    },
    {
      "start": 284.17,
      "end": 285.57,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 285.62,
      "end": 288.49,
      "text": "ሙዞቹ በቅናሽ ላይ ናቸው።"
    },
    {
      "start": 292.64,
      "end": 298.22,
      "text": "ባዶ ጠርሙሶችም ይዘዋል – ይህ ምልክት ያለባቸው፦ ተቀማጭ („Pfand“)። የት ይወስዷቸዋል?"
    },
    {
      "start": 298.32,
      "end": 302.54,
      "text": "A: ወደ ጠርሙስ መመለሻ ማሽኑ። ገንዘብ ይመለስልዎታል።"
    },
    {
      "start": 302.59,
      "end": 305.77,
      "text": "B: በመግቢያው ወዳለው ቆሻሻ ማጠራቀሚያ።"
    },
    {
      "start": 305.82,
      "end": 309.15,
      "text": "C: ወደ ገንዘብ መክፈያው – በስጦታ።"
    },
    {
      "start": 314.35,
      "end": 316.56,
      "text": "B፣ ወደ ቆሻሻው!"
    },
    {
      "start": 317.21,
      "end": 323.45,
      "text": "አይ፣ Leo – ያኔ ገንዘብ እየጣልክ ነው! A! ለብዙ ጠርሙሶች 25 ሳንቲም ይመለስልዎታል።"
    },
    {
      "start": 323.5,
      "end": 328.22,
      "text": "ማሽኑ ደረሰኝ ይሰጥዎታል። ያንን በገንዘብ መክፈያው ላይ ይሰጣሉ።"
    },
    {
      "start": 328.47,
      "end": 329.88,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 329.93,
      "end": 332.58,
      "text": "የጠርሙስ መመለሻ ማሽኑ የት ነው?"
    },
    {
      "start": 336.49,
      "end": 340.14,
      "text": "አሁን ገንዘብ መክፈያው ላይ ነዎት። ሁሉንም ነገር በቀበቶው ላይ ያስቀምጣሉ።"
    },
    {
      "start": 340.24,
      "end": 342.53,
      "text": "ሰላም! ነጥብ ይሰበስባሉ?"
    },
    {
      "start": 342.63,
      "end": 343.85,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 343.9,
      "end": 347.23,
      "text": "A: አዎ፣ ቴምብሮችን እሰበስባለሁ።"
    },
    {
      "start": 347.28,
      "end": 350.04,
      "text": "B: ነጥቦችዎን እሰበስባለሁ።"
    },
    {
      "start": 350.09,
      "end": 352.77,
      "text": "C: አይ፣ አመሰግናለሁ።"
    },
    {
      "start": 357.97,
      "end": 361.69,
      "text": "A! ቴምብሮችን እሰበስባለሁ። ከትምህርት ቤት ጀምሮ።"
    },
    {
      "start": 362.34,
      "end": 370.69,
      "text": "ጥሩ ነው፣ Leo – ግን እሷ ያንን ማወቅ አትፈልግም። C! ብዙ ሱፐርማርኬቶች ነጥብ የሚሰበሰብበት ካርድ ወይም መተግበሪያ አላቸው።"
    },
    {
      "start": 370.74,
      "end": 374.79,
      "text": "ከሌለዎት በቀላሉ ይበሉ፦ „Nein, danke.“"
    },
    {
      "start": 375.04,
      "end": 376.45,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 376.5,
      "end": 378.63,
      "text": "አይ፣ አመሰግናለሁ።"
    },
    {
      "start": 381.44,
      "end": 384.2,
      "text": "አዎ፣ ካርዴ ይኸውልዎት።"
    },
    {
      "start": 388.23,
      "end": 390.13,
      "text": "ፌስታል ያስፈልግዎታል?"
    },
    {
      "start": 390.23,
      "end": 391.45,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 391.5,
      "end": 394.75,
      "text": "A: አዎ፣ አንድ ፌስታል ወተት፣ እባክዎ።"
    },
    {
      "start": 394.8,
      "end": 398.76,
      "text": "B: አይ፣ አመሰግናለሁ። ቦርሳ ይዣለሁ።"
    },
    {
      "start": 398.81,
      "end": 402.22,
      "text": "C: አይ፣ እኔ ፌስታል አይደለሁም።"
    },
    {
      "start": 407.92,
      "end": 412.38,
      "text": "B! ማወቁ ጥሩ ነው፦ በጀርመን ፌስታል ሁልጊዜ ማለት ይቻላል ይከፈልበታል።"
    },
    {
      "start": 412.43,
      "end": 415.8,
      "text": "ብዙ ሰዎች የራሳቸውን ቦርሳ ይዘው ይመጣሉ።"
    },
    {
      "start": 416.05,
      "end": 417.46,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 417.51,
      "end": 419.95,
      "text": "ቦርሳ ይዣለሁ።"
    },
    {
      "start": 423.62,
      "end": 429.02,
      "text": "23.47 ዩሮ ነው። በጥሬ ገንዘብ ነው ወይስ በካርድ የሚከፍሉት?"
    },
    {
      "start": 429.12,
      "end": 430.34,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 430.39,
      "end": 432.76,
      "text": "A: በካርድ፣ እባክዎ።"
    },
    {
      "start": 432.81,
      "end": 435.25,
      "text": "B: በ„Bar“ እከፍላለሁ።"
    },
    {
      "start": 435.3,
      "end": 438.71,
      "text": "C: አዎ፣ በጥሬ ገንዘብ ወይም በካርድ።"
    },
    {
      "start": 443.91,
      "end": 445.89,
      "text": "C! አዎ!"
    },
    {
      "start": 446.54,
      "end": 452.38,
      "text": "Leo … ይህ የአዎ ወይም አይ ጥያቄ አይደለም! A! „Bar“ ማለት፦ በኖትና በሳንቲም ማለት ነው። እርግጠኛ ካልሆኑ ደግሞ ይጠይቁ፦ „Kann ich mit Karte zahlen?“"
    },
    {
      "start": 452.43,
      "end": 457.79,
      "text": "(በካርድ መክፈል እችላለሁ?)"
    },
    {
      "start": 458.04,
      "end": 459.44,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 459.49,
      "end": 461.41,
      "text": "በካርድ፣ እባክዎ።"
    },
    {
      "start": 463.99,
      "end": 466.53,
      "text": "በካርድ መክፈል እችላለሁ?"
    },
    {
      "start": 470.33,
      "end": 472.22,
      "text": "ደረሰኙን ይፈልጋሉ?"
    },
    {
      "start": 472.32,
      "end": 473.54,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 473.59,
      "end": 477.16,
      "text": "A: አይ፣ ከረሜላ („Bonbons“) አልወድም።"
    },
    {
      "start": 477.21,
      "end": 480.78,
      "text": "B: አይ፣ አመሰግናለሁ። አያስፈልገኝም።"
    },
    {
      "start": 480.83,
      "end": 483.85,
      "text": "C: አዎ፣ ገንዘብ መክፈያውን እፈልጋለሁ።"
    },
    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! ከረሜላ አልወድም። በጣም ብዙ ስኳር አለው።"
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "Leo! „Bon“ „Bonbon“ አይደለም። „Kassenbon“ ትንሿ ወረቀት ናት – የገዙት ነገር በላዩ ላይ ተጽፏል።"
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B ትክክል ነው። ወይም፦ „Ja, bitte.“ (አዎ፣ እባክዎ።)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "መልካም ቀን ይሁንልዎ!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "አመሰግናለሁ፣ ለእርስዎም!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "አመሰግናለሁ፣ ለእርስዎም!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "በጀርመን ለሱፐርማርኬት ሦስት ምክሮች።"
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "አንደኛ፦ እሁድ ቀን ሁሉም ሱፐርማርኬቶች ማለት ይቻላል ዝግ ናቸው – ስለዚህ ቅዳሜ ይገብዩ!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "ሁለተኛ፦ በገንዘብ መክፈያው ሁሉንም ነገር ራስዎ በቀበቶው ላይ ያስቀምጣሉ።"
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "መለያ በትሩ የሚያሳየው፦ የሚቀጥለው ደንበኛ ከዚህ ይጀምራል።"
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "ሦስተኛ፦ በገንዘብ መክፈያው ነገሮች በፍጥነት ይሄዳሉ።"
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "ዕቃዎችዎን ከገንዘብ መክፈያው በኋላ ተረጋግተው ይሸክፉ – ይህ ፍጹም የተለመደ ነው።"
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo የግብይት ዝርዝር እየጻፈ ነው። ግን የሆነ ነገር ትክክል አይደለም …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "አንድ ጠርሙስ እርጎ።"
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "አንድ ኩባያ እርጎ!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "አንድ ቆርቆሮ ዳቦ።"
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "አንድ ዳቦ – ወይም አንድ ፓኬት ቶስት!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "አንድ ኩባያ ፓስታ።"
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "አንድ ፓኬት ፓስታ!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "አንድ ፓኬት ውሃ።"
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "አንድ ጠርሙስ ውሃ!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "አንድ ፌስታል ቲማቲም።"
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "አንድ ቆርቆሮ ቲማቲም!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (አይቡን የት አገኛለሁ?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "ግሡ ደግሞ ወደ መጨረሻ ይሄዳል፦ „Ich möchte bezahlen mit Karte“ ሳይሆን፦ „Ich möchte mit Karte bezahlen.“ (በካርድ መክፈል እፈልጋለሁ።)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "በገንዘብ መክፈያው ደግሞ፦ „Bon“ ደረሰኙ ነው። „Bonbon“ ከረሜላ ነው።"
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "አሁን ደግሞ ሁሉንም አንድ ጊዜ እንደገና። አሥሩ በጣም አስፈላጊ ዓረፍተ ነገሮች። ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "5 ዩሮ ሊዘረዝሩልኝ ይችላሉ?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "ይቅርታ፣ ዱቄት የት አገኛለሁ?"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "200 ግራም Gouda እፈልግ ነበር፣ እባክዎ።"
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "አዎ፣ ችግር የለውም።"
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "አይ፣ አመሰግናለሁ። ይኸው ነው።"
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "ሙዞቹ በቅናሽ ላይ ናቸው።"
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "የጠርሙስ መመለሻ ማሽኑ የት ነው?"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "ቦርሳ ይዣለሁ።"
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "በካርድ መክፈል እችላለሁ?"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "አመሰግናለሁ፣ ለእርስዎም!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "በሱፐርማርኬት መግዛት በጣም የሚወዱት ምንድን ነው? በአስተያየት መስጫው ላይ ይጻፉት!"
    },
    {
      "start": 669.37,
      "end": 672.39,
      "text": "ቻው፣ በLilyLingua በቅርቡ እንገናኝ!"
    }
  ]
}
