  "subtitles": [
    {
      "start": 0.4,
      "end": 5.17,
      "text": "Aš taip alkanas! Bet mano šaldytuvas tuščias."
    },
    {
      "start": 5.27,
      "end": 7.71,
      "text": "Tada į prekybos centrą!"
    },
    {
      "start": 7.81,
      "end": 10.57,
      "text": "Į prekybos centrą? Viskas vokiškai?"
    },
    {
      "start": 10.67,
      "end": 16.98,
      "text": "Žinoma! Šiandien apsipirksi nuo pradžios iki galo – nuo pirkinių vežimėlio iki kvito."
    },
    {
      "start": 17.03,
      "end": 21.29,
      "text": "Ir kiekvienoje situacijoje tavęs klausiame: ką tu sakai?"
    },
    {
      "start": 21.39,
      "end": 23.76,
      "text": "Ir turi tik penkias sekundes!"
    },
    {
      "start": 27.06,
      "end": 34.36,
      "text": "Nori paimti pirkinių vežimėlį. Bet tam reikia monetos – o tu turi tik penkių eurų banknotą."
    },
    {
      "start": 34.41,
      "end": 36.95,
      "text": "Šalia tavęs stovi vyresnio amžiaus vyras."
    },
    {
      "start": 37.05,
      "end": 38.52,
      "text": "Ką tu sakai?"
    },
    {
      "start": 38.62,
      "end": 42.74,
      "text": "A: Atsiprašau, ar galite man padovanoti penkis eurus?"
    },
    {
      "start": 42.79,
      "end": 47.01,
      "text": "B: Atsiprašau, ar galite man išmainyti penkis eurus?"
    },
    {
      "start": 47.06,
      "end": 50.79,
      "text": "C: Atsiprašau, noriu jūsų vežimėlio."
    },
    {
      "start": 56.49,
      "end": 62.73,
      "text": "B! „Wechseln“ reiškia: duodi banknotą ir gauni atgal monetų. „Schenken“"
    },
    {
      "start": 62.78,
      "end": 68.94,
      "text": "reiškia: gauni nemokamai – tai būtų labai malonu, bet šiek tiek įžūlu."
    },
    {
      "start": 69.19,
      "end": 74.35,
      "text": "Akimirką … taip: du, keturi, penki eurai. Prašom!"
    },
    {
      "start": 74.45,
      "end": 75.84,
      "text": "Labai ačiū!"
    },
    {
      "start": 75.94,
      "end": 77.35,
      "text": "Kartok po manęs!"
    },
    {
      "start": 77.4,
      "end": 80.45,
      "text": "Ar galite man išmainyti penkis eurus?"
    },
    {
      "start": 84.81,
      "end": 91.49,
      "text": "Tau reikia miltų. Bet kur miltai? Darbuotojas kaip tik dėlioja prekes lentynoje."
    },
    {
      "start": 91.59,
      "end": 93.14,
      "text": "Ko klausi?"
    },
    {
      "start": 93.24,
      "end": 96.89,
      "text": "A: Atsiprašau, kur rasti miltų?"
    },
    {
      "start": 96.94,
      "end": 99.38,
      "text": "B: „Wo ist der Mehl?“ (neteisingas artikelis)"
