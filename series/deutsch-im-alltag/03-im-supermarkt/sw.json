  "subtitles": [
    {
      "start": 0.4,
      "end": 5.17,
      "text": "Nina njaa sana! Lakini friji yangu ni tupu."
    },
    {
      "start": 5.27,
      "end": 7.71,
      "text": "Basi twende supermarket!"
    },
    {
      "start": 7.81,
      "end": 10.57,
      "text": "Supermarket? Kwa Kijerumani tupu?"
    },
    {
      "start": 10.67,
      "end": 16.98,
      "text": "Bila shaka! Leo unafanya manunuzi yote – kuanzia toroli la manunuzi hadi risiti."
    },
    {
      "start": 17.03,
      "end": 21.29,
      "text": "Na katika kila hali tunakuuliza: Unasema nini?"
    },
    {
      "start": 21.39,
      "end": 23.76,
      "text": "Na una sekunde tano tu!"
    },
    {
      "start": 27.06,
      "end": 34.36,
      "text": "Unataka toroli la manunuzi. Lakini kwa hilo unahitaji sarafu – na una noti ya euro tano tu."
    },
    {
      "start": 34.41,
      "end": 36.95,
      "text": "Karibu yako amesimama mzee mmoja."
    },
    {
      "start": 37.05,
      "end": 38.52,
      "text": "Unasema nini?"
    },
    {
      "start": 38.62,
      "end": 42.74,
      "text": "A: Samahani, unaweza kunipa euro tano kama zawadi?"
    },
    {
      "start": 42.79,
      "end": 47.01,
      "text": "B: Samahani, unaweza kunibadilishia euro tano?"
    },
    {
      "start": 47.06,
      "end": 50.79,
      "text": "C: Samahani, nataka toroli lako."
    },
    {
      "start": 56.49,
      "end": 62.73,
      "text": "B! „Wechseln“ maana yake: unatoa noti na kupokea sarafu. „Schenken“"
    },
    {
      "start": 62.78,
      "end": 68.94,
      "text": "maana yake: unapewa bure – hilo lingekuwa zuri sana, lakini ni ujasiri kidogo."
    },
    {
      "start": 69.19,
      "end": 74.35,
      "text": "Subiri kidogo … ndiyo: mbili, nne, euro tano. Karibu!"
    },
    {
      "start": 74.45,
      "end": 75.84,
      "text": "Asante sana!"
    },
    {
      "start": 75.94,
      "end": 77.35,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 77.4,
      "end": 80.45,
      "text": "Unaweza kunibadilishia euro tano?"
    },
    {
      "start": 84.81,
      "end": 91.49,
      "text": "Unahitaji unga. Lakini unga uko wapi? Mfanyakazi anapanga rafu."
    },
    {
      "start": 91.59,
      "end": 93.14,
      "text": "Unauliza nini?"
    },
    {
      "start": 93.24,
      "end": 96.89,
      "text": "A: Samahani, unga nitaupata wapi?"
    },
    {
      "start": 96.94,
      "end": 99.38,
      "text": "B: „Wo ist der Mehl?“ (kibainishi si sahihi)"
    },
    {
      "start": 99.43,
      "end": 102.19,
      "text": "C: Umepata unga?"
    },
    {
      "start": 107.39,
      "end": 109.83,
      "text": "B! „Wo ist der Mehl?“"
    },
    {
      "start": 110.48,
      "end": 117.53,
      "text": "Karibu, Leo. Ni „das Mehl“. Lakini A ni bora zaidi: „Entschuldigung, wo finde ich …?“"
    },
    {
      "start": 117.58,
      "end": 121.66,
      "text": "(Samahani, nitapata wapi …?) – hivi ndivyo unavyouliza kwa heshima kuhusu kila kitu supermarket."
    },
    {
      "start": 121.91,
      "end": 125.55,
      "text": "Unga uko kwenye njia namba tatu, chini kabisa kwenye rafu."
    },
    {
      "start": 125.65,
      "end": 126.97,
      "text": "Asante!"
    },
    {
      "start": 127.07,
      "end": 128.48,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 128.53,
      "end": 132.09,
      "text": "Samahani, unga nitaupata wapi?"
    },
    {
      "start": 136.56,
      "end": 139.6,
      "text": "Njia namba tatu, chini kabisa."
    },
    {
      "start": 143.97,
      "end": 147.62,
      "text": "Sasa unaenda kwenye kaunta ya vyakula vibichi. Unataka jibini ya Gouda."
    },
    {
      "start": 147.72,
      "end": 150.08,
      "text": "Habari! Ungependa nini?"
    },
    {
      "start": 150.18,
      "end": 151.4,
      "text": "Unasema nini?"
    },
    {
      "start": 151.45,
      "end": 154.86,
      "text": "A: Mimi ni gramu 200 za Gouda."
    },
    {
      "start": 154.91,
      "end": 157.85,
      "text": "B: Ndiyo, inaruhusiwa kuwa."
    },
    {
      "start": 157.9,
      "end": 162.12,
      "text": "C: Ningependa gramu 200 za Gouda, tafadhali."
    },
    {
      "start": 167.82,
      "end": 174.01,
      "text": "C! „Was darf's sein?“ maana yake tu: Ungependa nini? Na kwa „Ich hätte gern …“"
    },
    {
      "start": 174.06,
      "end": 179.31,
      "text": "(Ningependa …) unaagiza kwa heshima kila wakati – kaunta, kwa muuza mikate, mgahawani."
    },
    {
      "start": 179.56,
      "end": 180.96,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 181.01,
      "end": 184.79,
      "text": "Ningependa gramu 200 za Gouda, tafadhali."
    },
    {
      "start": 190,
      "end": 195.81,
      "text": "Bi Haas anakata jibini. Mzani unaonyesha: gramu 230."
    },
    {
      "start": 195.91,
      "end": 198.35,
      "text": "Ikizidi kidogo ni sawa?"
    },
    {
      "start": 198.45,
      "end": 199.68,
      "text": "Unasema nini?"
    },
    {
      "start": 199.72,
      "end": 202.74,
      "text": "A: Hapana, siruhusiwi."
    },
    {
      "start": 202.79,
      "end": 205.97,
      "text": "B: Ndiyo, ni sawa."
    },
    {
      "start": 206.02,
      "end": 209.67,
      "text": "C: Ndiyo, mimi ni zaidi kidogo."
    },
    {
      "start": 215.37,
      "end": 223.63,
      "text": "B! Sentensi hii unaisikia kwenye kila kaunta nchini Ujerumani. Maana yake: ni zaidi kidogo ya ulichoagiza – ni sawa?"
    },
    {
      "start": 223.68,
      "end": 228.05,
      "text": "Kama sivyo, sema tu: „Nein, bitte genau 200 Gramm.“ (Hapana, tafadhali gramu 200 kamili.)"
    },
    {
      "start": 228.3,
      "end": 229.86,
      "text": "Kingine chochote?"
    },
    {
      "start": 229.96,
      "end": 232.56,
      "text": "Hapana, asante. Ni hivyo tu."
    },
    {
      "start": 232.66,
      "end": 234.06,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 234.11,
      "end": 236.77,
      "text": "Ndiyo, ni sawa."
    },
    {
      "start": 240.18,
      "end": 243.43,
      "text": "Hapana, asante. Ni hivyo tu."
    },
    {
      "start": 248.04,
      "end": 253.2,
      "text": "Unaendelea kutembea. Ghafla unasikia tangazo. Sikiliza kwa makini!"
    },
    {
      "start": 253.3,
      "end": 260.34,
      "text": "Wateja wapendwa! Punguzo la leo: ndizi, kilo moja kwa senti 99 tu."
    },
    {
      "start": 260.44,
      "end": 263.12,
      "text": "Kilo moja ya ndizi ni bei gani?"
    },
    {
      "start": 263.22,
      "end": 265.98,
      "text": "A: €9.90"
    },
    {
      "start": 266.03,
      "end": 269.05,
      "text": "B: €1.99"
    },
    {
      "start": 269.1,
      "end": 271.78,
      "text": "C: senti 99"
    },
    {
      "start": 277.48,
      "end": 283.92,
      "text": "C! Senti 99. „Im Angebot“ maana yake: leo ni bei nafuu kuliko kawaida."
    },
    {
      "start": 284.17,
      "end": 285.57,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 285.62,
      "end": 288.49,
      "text": "Ndizi ziko kwenye punguzo."
    },
    {
      "start": 292.64,
      "end": 298.22,
      "text": "Pia una chupa tupu – zenye alama hii: amana („Pfand“). Zipeleke wapi?"
    },
    {
      "start": 298.32,
      "end": 302.54,
      "text": "A: Kwenye mashine ya kurudisha chupa. Unarudishiwa pesa."
    },
    {
      "start": 302.59,
      "end": 305.77,
      "text": "B: Kwenye pipa la taka mlangoni."
    },
    {
      "start": 305.82,
      "end": 309.15,
      "text": "C: Kwenye kaunta ya malipo – kama zawadi."
    },
    {
      "start": 314.35,
      "end": 316.56,
      "text": "B, kwenye takataka!"
    },
    {
      "start": 317.21,
      "end": 323.45,
      "text": "Hapana, Leo – hivyo unatupa pesa! A! Kwa chupa nyingi unarudishiwa senti 25."
    },
    {
      "start": 323.5,
      "end": 328.22,
      "text": "Mashine inakupa risiti. Unaitoa kwenye kaunta ya malipo."
    },
    {
      "start": 328.47,
      "end": 329.88,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 329.93,
      "end": 332.58,
      "text": "Mashine ya kurudisha chupa iko wapi?"
    },
    {
      "start": 336.49,
      "end": 340.14,
      "text": "Sasa uko kwenye kaunta ya malipo. Unaweka kila kitu kwenye mkanda."
    },
    {
      "start": 340.24,
      "end": 342.53,
      "text": "Habari! Unakusanya pointi?"
    },
    {
      "start": 342.63,
      "end": 343.85,
      "text": "Unasema nini?"
    },
    {
      "start": 343.9,
      "end": 347.23,
      "text": "A: Ndiyo, ninakusanya stempu za posta."
    },
    {
      "start": 347.28,
      "end": 350.04,
      "text": "B: Ninakusanya pointi zako."
    },
    {
      "start": 350.09,
      "end": 352.77,
      "text": "C: Hapana, asante."
    },
    {
      "start": 357.97,
      "end": 361.69,
      "text": "A! Ninakusanya stempu za posta. Tangu shuleni."
    },
    {
      "start": 362.34,
      "end": 370.69,
      "text": "Vizuri, Leo – lakini hilo halimvutii. C! Maduka mengi yana kadi au programu yenye pointi."
    },
    {
      "start": 370.74,
      "end": 374.79,
      "text": "Kama huna, sema tu: „Nein, danke.“"
    },
    {
      "start": 375.04,
      "end": 376.45,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 376.5,
      "end": 378.63,
      "text": "Hapana, asante."
    },
    {
      "start": 381.44,
      "end": 384.2,
      "text": "Ndiyo, kadi yangu hii hapa."
    },
    {
      "start": 388.23,
      "end": 390.13,
      "text": "Unahitaji mfuko?"
    },
    {
      "start": 390.23,
      "end": 391.45,
      "text": "Unasema nini?"
    },
    {
      "start": 391.5,
      "end": 394.75,
      "text": "A: Ndiyo, mfuko wa maziwa, tafadhali."
    },
    {
      "start": 394.8,
      "end": 398.76,
      "text": "B: Hapana, asante. Nina mfuko wangu."
    },
    {
      "start": 398.81,
      "end": 402.22,
      "text": "C: Hapana, mimi si mfuko."
    },
    {
      "start": 407.92,
      "end": 412.38,
      "text": "B! Ni vizuri kujua: nchini Ujerumani mifuko karibu kila mara inalipiwa."
    },
    {
      "start": 412.43,
      "end": 415.8,
      "text": "Watu wengi huja na mfuko wao wenyewe."
    },
    {
      "start": 416.05,
      "end": 417.46,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 417.51,
      "end": 419.95,
      "text": "Nina mfuko wangu."
    },
    {
      "start": 423.62,
      "end": 429.02,
      "text": "Jumla ni €23.47. Unalipa kwa pesa taslimu au kwa kadi?"
    },
    {
      "start": 429.12,
      "end": 430.34,
      "text": "Unasema nini?"
    },
    {
      "start": 430.39,
      "end": 432.76,
      "text": "A: Kwa kadi, tafadhali."
    },
    {
      "start": 432.81,
      "end": 435.25,
      "text": "B: Ninalipa kwa „Bar“."
    },
    {
      "start": 435.3,
      "end": 438.71,
      "text": "C: Ndiyo, taslimu au kadi."
    },
    {
      "start": 443.91,
      "end": 445.89,
      "text": "C! Ndiyo!"
    },
    {
      "start": 446.54,
      "end": 452.38,
      "text": "Leo … hili si swali la ndiyo au hapana! A! „Bar“ maana yake: kwa noti na sarafu. Na kama huna uhakika, uliza: „Kann ich mit Karte zahlen?“"
    },
    {
      "start": 452.43,
      "end": 457.79,
      "text": "(Naweza kulipa kwa kadi?)"
    },
    {
      "start": 458.04,
      "end": 459.44,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 459.49,
      "end": 461.41,
      "text": "Kwa kadi, tafadhali."
    },
    {
      "start": 463.99,
      "end": 466.53,
      "text": "Naweza kulipa kwa kadi?"
    },
    {
      "start": 470.33,
      "end": 472.22,
      "text": "Ungependa risiti?"
    },
    {
      "start": 472.32,
      "end": 473.54,
      "text": "Unasema nini?"
    },
    {
      "start": 473.59,
      "end": 477.16,
      "text": "A: Hapana, sipendi pipi („Bonbons“)."
    },
    {
      "start": 477.21,
      "end": 480.78,
      "text": "B: Hapana, asante. Siihitaji."
    },
    {
      "start": 480.83,
      "end": 483.85,
      "text": "C: Ndiyo, ningependa kaunta ya malipo."
    },
    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! Sipendi pipi. Sukari nyingi mno."
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "Leo! „Bon“ si „Bonbon“. „Kassenbon“ ni karatasi – juu yake kumeandikwa ulichonunua."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B ni sahihi. Au: „Ja, bitte.“ (Ndiyo, tafadhali.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "Siku njema!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "Asante, na kwako pia!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "Rudia baada yangu!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "Asante, na kwako pia!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "Vidokezo vitatu kwa supermarket nchini Ujerumani."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "Kwanza: Jumapili karibu supermarket zote zimefungwa – kwa hiyo nunua Jumamosi!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "Pili: kwenye kaunta ya malipo unaweka kila kitu kwenye mkanda mwenyewe."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "Kitenganishi kinaonyesha: kuanzia hapa ni mteja anayefuata."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "Na tatu: kwenye kaunta ya malipo mambo huenda haraka."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "Panga vitu vyako kwa utulivu baada ya kaunta – hilo ni kawaida kabisa."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo anaandika orodha ya manunuzi. Lakini kuna kitu si sahihi …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "Chupa moja ya mtindi."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "Kikombe kimoja cha mtindi!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "Kopo moja la mkate."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "Mkate mmoja – au pakiti moja ya mkate wa slesi!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "Kikombe kimoja cha tambi."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "Pakiti moja ya tambi!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "Pakiti moja ya maji."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "Chupa moja ya maji!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "Mfuko mmoja wa nyanya."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "Kopo moja la nyanya!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (Jibini nitaipata wapi?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "Na kitenzi kinaenda mwishoni: si „Ich möchte bezahlen mit Karte“, bali: „Ich möchte mit Karte bezahlen.“ (Ningependa kulipa kwa kadi.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "Na kwenye kaunta ya malipo: „Bon“ ni risiti. „Bonbon“ ni pipi."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "Na sasa kila kitu tena mara moja. Sentensi kumi muhimu zaidi. Rudia baada yangu!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "Unaweza kunibadilishia euro tano?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "Samahani, unga nitaupata wapi?"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "Ningependa gramu 200 za Gouda, tafadhali."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "Ndiyo, ni sawa."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "Hapana, asante. Ni hivyo tu."
    },
    {
      "start": 636.07,
