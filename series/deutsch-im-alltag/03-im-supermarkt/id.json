    },
    {
      "start": 398.81,
      "end": 402.22,
      "text": "C: Tidak, saya bukan kantong."
    },
    {
      "start": 407.92,
      "end": 412.38,
      "text": "B! Perlu diketahui: di Jerman kantong hampir selalu harus dibayar."
    },
    {
      "start": 412.43,
      "end": 415.8,
