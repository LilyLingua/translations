    {
      "start": 429.12,
      "end": 430.34,
      "text": "Apa yang kamu katakan?"
    },
    {
      "start": 430.39,
      "end": 432.76,
      "text": "A: Dengan kartu, tolong."
    },
    {
      "start": 432.81,
      "end": 435.25,
      "text": "B: Saya bayar dengan „Bar“."
