    {
      "start": 480.83,
      "end": 483.85,
      "text": "C: Ya, saya mau kasirnya."
    },
    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! Aku tidak suka permen. Terlalu banyak gula."
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "Leo! „Bon“ bukan „Bonbon“. „Kassenbon“ itu kertas kecilnya – di situ tertulis apa yang kamu beli."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B yang benar. Atau: „Ja, bitte.“ (Ya, tolong.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "Selamat siang, semoga harinya menyenangkan!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "Terima kasih, Anda juga!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "Ulangi setelah aku!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "Terima kasih, Anda juga!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "Tiga tips untuk supermarket di Jerman."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "Pertama: hari Minggu hampir semua supermarket tutup – jadi belanjalah hari Sabtu!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "Kedua: di kasir kamu sendiri yang menaruh semua barang di ban berjalan."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "Pembatas barang menunjukkan: mulai dari sini milik pelanggan berikutnya."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "Dan ketiga: di kasir semuanya cepat."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "Kemasi barangmu dengan tenang setelah kasir – itu sangat biasa."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo menulis daftar belanja. Tapi ada yang tidak beres …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "Sebotol yoghurt."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "Satu cup yoghurt!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "Sekaleng roti."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "Satu roti – atau satu bungkus roti tawar!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "Satu cup pasta."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "Satu bungkus pasta!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "Satu bungkus air."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "Sebotol air!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "Sekantong tomat."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "Sekaleng tomat!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (Di mana saya bisa menemukan keju?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "Dan kata kerjanya pindah ke akhir: bukan „Ich möchte bezahlen mit Karte“, tapi: „Ich möchte mit Karte bezahlen.“ (Saya ingin bayar dengan kartu.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "Dan di kasir: „Bon“ itu struk. „Bonbon“ itu permen."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "Dan sekarang semuanya sekali lagi. Sepuluh kalimat terpenting. Ulangi setelah aku!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "Bisakah Anda menukar lima euro untuk saya?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "Permisi, di mana saya bisa menemukan tepung?"
    },
    {
      "start": 614.16,
