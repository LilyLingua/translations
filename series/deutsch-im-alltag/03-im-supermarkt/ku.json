      "text": "Ji kerema xwe 200 gram Gouda dixwazim."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "Erê, baş e."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "Na, spas. Ev bû."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "Mûz bi erzanî ne."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "Otomata şûşeyan li ku ye?"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "Çenteyek bi min re heye."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "Ez dikarim bi kartê bidim?"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "Spas, ji we re jî!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "Tu herî zêde hez dikî ji supermarketê çi bikirî? Di şîroveyan de binivîse!"
    },
    {
