      "start": 526.06,
      "end": 529.75,
      "text": "دوم: سر صندوق همه چیز را خودت روی نوار می‌گذاری."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "جداکننده نشان می‌دهد: از این‌جا خرید مشتری بعدی است."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "و سوم: سر صندوق همه چیز سریع پیش می‌رود."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "بعد از صندوق با آرامش وسایلت را جمع کن – این کاملاً عادی است."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "لئو یک فهرست خرید می‌نویسد. ولی یک چیزی درست نیست…"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "یک بطری ماست."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "یک کاسه ماست!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "یک قوطی کنسرو نان."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "یک نان – یا یک بسته نان تست!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "یک کاسه ماکارونی."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "یک بسته ماکارونی!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "یک بسته آب."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "یک بطری آب!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "یک کیسه گوجه‌فرنگی."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "یک قوطی کنسرو گوجه‌فرنگی!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "«⁦Wo finde ich der Käse?⁩»"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "«⁦Den Käse⁩»! «⁦Wo finde ich den Käse?⁩» (پنیر را کجا پیدا کنم؟)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "و فعل به آخر می‌رود: نه «⁦Ich möchte bezahlen mit Karte⁩»، بلکه: «⁦Ich möchte mit Karte bezahlen.⁩» (می‌خواهم با کارت پرداخت کنم.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "و سر صندوق: «⁦Bon⁩» رسید است. «⁦Bonbon⁩» یک آب‌نبات است."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "و حالا همه چیز یک بار دیگر. ده جمله مهم. تکرار کن!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "می‌توانید پنج یورو برایم خرد کنید؟"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "ببخشید، آرد را کجا پیدا کنم؟"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "لطفاً ۲۰۰ گرم گودا می‌خواستم."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "بله، اشکالی ندارد."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "نه، ممنون. همین بود."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "موزها در حراج هستند."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "دستگاه پس‌گیری بطری کجاست؟"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "کیف همراهم هست."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "می‌توانم با کارت پرداخت کنم؟"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "ممنون، همچنین!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "در سوپرمارکت بیشتر از همه دوست داری چه بخری؟ در کامنت‌ها بنویس!"
    },
    {
      "start": 669.37,
      "end": 672.39,
      "text": "خداحافظ، به‌زودی در LilyLingua می‌بینیمت!"
    }
  ]
}
