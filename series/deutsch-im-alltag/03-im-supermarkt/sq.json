      "text": "B: Mbledh pikët tuaja."
    },
    {
      "start": 350.09,
      "end": 352.77,
      "text": "C: Jo, faleminderit."
    },
    {
      "start": 357.97,
      "end": 361.69,
      "text": "A! Mbledh pulla postare. Që në shkollë."
    },
    {
      "start": 362.34,
      "end": 370.69,
      "text": "Bukur, Leo – por kjo nuk e intereson. C! Shumë supermarkete kanë një kartë ose aplikacion me pikë."
    },
    {
      "start": 370.74,
      "end": 374.79,
      "text": "Nëse nuk ke, thuaj thjesht: „Nein, danke.“"
    },
    {
      "start": 375.04,
      "end": 376.45,
      "text": "Përsërit pas meje!"
    },
    {
      "start": 376.5,
      "end": 378.63,
      "text": "Jo, faleminderit."
    },
    {
      "start": 381.44,
      "end": 384.2,
      "text": "Po, ja karta ime."
    },
    {
      "start": 388.23,
      "end": 390.13,
      "text": "Ju duhet një qese?"
    },
    {
      "start": 390.23,
      "end": 391.45,
      "text": "Çfarë thua?"
    },
    {
      "start": 391.5,
      "end": 394.75,
      "text": "A: Po, një qese qumësht, ju lutem."
    },
    {
      "start": 394.8,
      "end": 398.76,
      "text": "B: Jo, faleminderit. Kam një çantë me vete."
    },
    {
      "start": 398.81,
      "end": 402.22,
      "text": "C: Jo, unë nuk jam qese."
    },
    {
