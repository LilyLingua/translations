      "end": 501.69,
      "text": "Leo! „Bon“ nuk është „Bonbon“. „Kassenbon“ është letra – aty shkruhet çfarë ke blerë."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B është e saktë. Ose: „Ja, bitte.“ (Po, ju lutem.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "Ditë të mbarë!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "Faleminderit, edhe juve!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "Përsërit pas meje!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "Faleminderit, edhe juve!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "Tri këshilla për supermarketin në Gjermani."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "E para: të dielën pothuajse të gjitha supermarketet janë të mbyllura – pra bëj pazar të shtunën!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "E dyta: te arka i vendos vetë të gjitha në shirit."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "Ndarësi tregon: që këtu fillon klienti tjetër."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "Dhe e treta: te arka gjithçka shkon shpejt."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "Paketo me qetësi pas arkës – kjo është krejt normale."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo shkruan një listë blerjesh. Por diçka nuk shkon …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "Një shishe kos."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "Një gotë kos!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "Një kanaçe bukë."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "Një bukë – ose një pako bukë toste!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "Një gotë makarona."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "Një pako makarona!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "Një pako ujë."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "Një shishe ujë!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "Një qese domate."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "Një kanaçe domate!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (Ku e gjej djathin?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "Dhe folja shkon në fund: jo „Ich möchte bezahlen mit Karte“, por: „Ich möchte mit Karte bezahlen.“ (Dua të paguaj me kartë.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "Dhe te arka: „Bon“ është kuponi. „Bonbon“ është karamele."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "Dhe tani gjithçka edhe një herë. Dhjetë fjalitë më të rëndësishme. Përsërit pas meje!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "A mund të ma thyeni pesë euro?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "Më falni, ku e gjej miellin?"
    },
