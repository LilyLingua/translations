    },
    {
      "start": 417.51,
      "end": 419.95,
      "text": "Kam një çantë me vete."
    },
    {
      "start": 423.62,
      "end": 429.02,
      "text": "Bëjnë 23,47 €. Paguani me para në dorë apo me kartë?"
    },
    {
      "start": 429.12,
      "end": 430.34,
      "text": "Çfarë thua?"
