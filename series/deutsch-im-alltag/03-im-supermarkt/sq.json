    },
    {
      "start": 190,
      "end": 195.81,
      "text": "Zonja Haas pret djathin. Peshorja tregon: 230 gram."
    },
    {
      "start": 195.91,
      "end": 198.35,
      "text": "A shkon pak më shumë?"
