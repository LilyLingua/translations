    },
    {
      "start": 317.21,
      "end": 323.45,
      "text": "Jo, Leo – kështu hedh para! A! Për shumë shishe merr mbrapsht 25 cent."
    },
    {
      "start": 323.5,
      "end": 328.22,
      "text": "Automati të jep një kupon. Atë e dorëzon te arka."
    },
    {
      "start": 328.47,
      "end": 329.88,
      "text": "Përsërit pas meje!"
    },
    {
      "start": 329.93,
      "end": 332.58,
      "text": "Ku është automati i kthimit të shisheve?"
    },
    {
      "start": 336.49,
      "end": 340.14,
      "text": "Tani je te arka. I vendos të gjitha në shirit."
