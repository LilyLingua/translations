    },
    {
      "start": 215.37,
      "end": 223.63,
      "text": "B! Këtë fjali e dëgjon në çdo banak në Gjermani. Do të thotë: është pak më shumë se sa porosite – a është në rregull?"
    },
    {
      "start": 223.68,
      "end": 228.05,
      "text": "Nëse jo, thuaj thjesht: „Nein, bitte genau 200 Gramm.“ (Jo, ju lutem saktë 200 gram.)"
    },
    {
      "start": 228.3,
      "end": 229.86,
      "text": "Diçka tjetër?"
    },
    {
      "start": 229.96,
      "end": 232.56,
      "text": "Jo, faleminderit. Kaq ishte."
    },
    {
      "start": 232.66,
      "end": 234.06,
      "text": "Përsërit pas meje!"
    },
    {
      "start": 234.11,
      "end": 236.77,
      "text": "Po, është në rregull."
    },
    {
      "start": 240.18,
      "end": 243.43,
      "text": "Jo, faleminderit. Kaq ishte."
    },
    {
      "start": 248.04,
      "end": 253.2,
      "text": "Vazhdon më tej. Papritur dëgjon një njoftim. Dëgjo me vëmendje!"
    },
    {
      "start": 253.3,
      "end": 260.34,
      "text": "Të nderuar klientë! Sot në ofertë: banane, kilogrami vetëm 99 cent."
    },
    {
      "start": 260.44,
      "end": 263.12,
      "text": "Sa kushton një kilogram banane?"
    },
    {
      "start": 263.22,
      "end": 265.98,
      "text": "A: 9,90 €"
    },
    {
      "start": 266.03,
      "end": 269.05,
      "text": "B: 1,99 €"
    },
    {
      "start": 269.1,
      "end": 271.78,
      "text": "C: 99 cent"
    },
    {
      "start": 277.48,
      "end": 283.92,
      "text": "C! 99 cent. „Im Angebot“ do të thotë: sot më lirë se zakonisht."
    },
    {
      "start": 284.17,
      "end": 285.57,
      "text": "Përsërit pas meje!"
    },
    {
      "start": 285.62,
      "end": 288.49,
      "text": "Bananet janë në ofertë."
    },
    {
      "start": 292.64,
      "end": 298.22,
      "text": "Ke me vete edhe shishe bosh – me këtë shenjë: depozitë („Pfand“). Ku i çon?"
    },
    {
      "start": 298.32,
      "end": 302.54,
      "text": "A: Te automati i kthimit të shisheve. Merr para mbrapsht."
