    },
    {
      "start": 121.91,
      "end": 125.55,
      "text": "Mehl ist in Gang drei, ganz unten im Regal."
    },
    {
      "start": 125.65,
      "end": 126.97,
      "text": "Danke schön!"
    },
    {
      "start": 127.07,
      "end": 128.48,
      "text": "Sprich nach!"
    },
    {
      "start": 128.53,
      "end": 132.09,
      "text": "Entschuldigung, wo finde ich Mehl?"
    },
    {
      "start": 136.56,
      "end": 139.6,
      "text": "Gang drei, ganz unten."
    },
    {
