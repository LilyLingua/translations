    {
      "start": 519.36,
      "end": 525.81,
      "text": "Erstens: Am Sonntag sind fast alle Supermärkte geschlossen – also am Samstag einkaufen!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "Zweitens: An der Kasse legst du alles selbst aufs Band."
