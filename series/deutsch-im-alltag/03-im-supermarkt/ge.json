    {
      "start": 446.54,
      "end": 452.38,
      "text": "ლეო … ეს კი-ან-არა კითხვა არ არის! A! „Bar“ ნიშნავს: კუპიურებითა და მონეტებით. და თუ დარწმუნებული არ ხარ, იკითხე: „Kann ich mit Karte zahlen?“"
    },
    {
      "start": 452.43,
      "end": 457.79,
      "text": "(ბარათით შეიძლება გადახდა?)"
    },
    {
      "start": 458.04,
      "end": 459.44,
      "text": "გაიმეორე!"
    },
    {
      "start": 459.49,
      "end": 461.41,
      "text": "ბარათით, თუ შეიძლება."
    },
    {
      "start": 463.99,
      "end": 466.53,
      "text": "ბარათით შეიძლება გადახდა?"
    },
    {
      "start": 470.33,
      "end": 472.22,
      "text": "ჩეკი გნებავთ?"
    },
    {
      "start": 472.32,
      "end": 473.54,
      "text": "რას იტყვი?"
    },
    {
      "start": 473.59,
      "end": 477.16,
      "text": "A: არა, კანფეტები („Bonbons“) არ მიყვარს."
    },
    {
      "start": 477.21,
      "end": 480.78,
      "text": "B: არა, გმადლობთ. არ მჭირდება."
    },
    {
      "start": 480.83,
      "end": 483.85,
      "text": "C: კი, სალარო მინდა."
    },
    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! კანფეტები არ მიყვარს. ძალიან ბევრი შაქარია."
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "ლეო! „Bon“ არ არის „Bonbon“. „Kassenbon“ ქაღალდია – მასზე წერია, რა იყიდე."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B სწორია. ან: „Ja, bitte.“ (კი, თუ შეიძლება.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "კარგ დღეს გისურვებთ!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "გმადლობთ, თქვენც!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "გაიმეორე!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "გმადლობთ, თქვენც!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "სამი რჩევა გერმანიაში სუპერმარკეტისთვის."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "პირველი: კვირას თითქმის ყველა სუპერმარკეტი დაკეტილია – ამიტომ შაბათს იყიდე!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "მეორე: სალაროსთან ყველაფერს თავად დებ ლენტზე."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "გამყოფი აჩვენებს: აქედან შემდეგი მომხმარებელია."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "და მესამე: სალაროსთან ყველაფერი სწრაფად ხდება."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "სალაროს შემდეგ მშვიდად ჩაალაგე – ეს სრულიად ნორმალურია."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "ლეო საყიდლების სიას წერს. მაგრამ რაღაც არ ემთხვევა …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "ერთი ბოთლი იოგურტი."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "ერთი ჭიქა იოგურტი!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "ერთი ქილა პური."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "ერთი პური – ან ერთი შეკვრა ტოსტის პური!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "ერთი ჭიქა მაკარონი."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "ერთი შეკვრა მაკარონი!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "ერთი შეკვრა წყალი."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "ერთი ბოთლი წყალი!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "ერთი პარკი პომიდორი."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "ერთი ქილა პომიდორი!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (სად ვიპოვო ყველი?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "და ზმნა ბოლოში მიდის: არა „Ich möchte bezahlen mit Karte“, არამედ: „Ich möchte mit Karte bezahlen.“ (ბარათით გადახდა მინდა.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "და სალაროსთან: „Bon“ ჩეკია. „Bonbon“ კანფეტია."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "ახლა კი ყველაფერი კიდევ ერთხელ. ათი ყველაზე მნიშვნელოვანი წინადადება. გაიმეორე!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "ხუთ ევროს დამიხურდავებთ?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "უკაცრავად, სად ვიპოვო ფქვილი?"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "200 გრამი გაუდა მინდა, თუ შეიძლება."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "კი, არა უშავს."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "არა, გმადლობთ. სულ ეს იყო."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "ბანანი აქციაზეა."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "სად არის ბოთლების ჩასაბარებელი აპარატი?"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "ჩანთა მაქვს თან."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "ბარათით შეიძლება გადახდა?"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "გმადლობთ, თქვენც!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "რა გიყვარს ყველაზე მეტად სუპერმარკეტში საყიდლად? დაწერე კომენტარებში!"
    },
    {
      "start": 669.37,
      "end": 672.39,
      "text": "ნახვამდის და მალე შევხვდებით LilyLingua-ზე!"
    }
  ]
}
