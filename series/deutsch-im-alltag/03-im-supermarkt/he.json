      "start": 536.87,
      "end": 540.71,
      "text": "תארוז בנחת אחרי הקופה – זה לגמרי רגיל."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "לאו כותב רשימת קניות. אבל משהו שם לא מסתדר …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "בקבוק יוגורט."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "גביע יוגורט!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "קופסת שימורים של לחם."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "לחם – או חבילת לחם טוסט!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "גביע פסטה."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "חבילת פסטה!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "חבילת מים."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "בקבוק מים!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "שקית עגבניות."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "קופסת שימורים של עגבניות!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "«⁦Wo finde ich der Käse?⁩»"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "«⁦Den Käse⁩»! «⁦Wo finde ich den Käse?⁩» (איפה אני מוצא את הגבינה?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "והפועל הולך לסוף: לא «⁦Ich möchte bezahlen mit Karte⁩», אלא: «⁦Ich möchte mit Karte bezahlen.⁩» (הייתי רוצה לשלם בכרטיס.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "ובקופה: «⁦Bon⁩» זו הקבלה. «⁦Bonbon⁩» זו סוכרייה."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "ועכשיו הכול עוד פעם אחת. עשרת המשפטים הכי חשובים. חזור אחריי!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "אתה יכול לפרוט לי חמישה יורו?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "סליחה, איפה אני מוצא קמח?"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "הייתי רוצה 200 גרם גאודה, בבקשה."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "כן, זה בסדר."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "לא, תודה. זה הכול."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "הבננות במבצע."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "איפה מכונת החזרת הבקבוקים?"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "יש לי תיק איתי."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "אפשר לשלם בכרטיס?"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "תודה, גם לך!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "מה אתה הכי אוהב לקנות בסופרמרקט? כתוב בתגובות!"
    },
    {
      "start": 669.37,
      "end": 672.39,
      "text": "ביי ולהתראות בקרוב ב־LilyLingua!"
    }
  ]
}
