  "subtitles": [
    {
      "start": 0.4,
      "end": 5.17,
      "text": "ብጣዕሚ ጠምየ! ግን ፍሪጀይ ባዶ እዩ።"
    },
    {
      "start": 5.27,
      "end": 7.71,
      "text": "ሽዑ ናብ ሱፐርማርኬት ንኺድ!"
