    },
    {
      "start": 407.92,
      "end": 412.38,
      "text": "B! Ɛyɛ sɛ wobɛhunu: wɔ Gyaaman, wotua kotokuo ho ka bere nyinaa."
    },
    {
      "start": 412.43,
      "end": 415.8,
      "text": "Nnipa pii de wɔn ankasa kotokuo ba."
    },
    {
      "start": 416.05,
      "end": 417.46,
      "text": "Ka di m'akyi!"
    },
    {
      "start": 417.51,
