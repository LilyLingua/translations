    },
    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! Mempɛ ɛswiiti. Asikyire dɔɔso."
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "Leo! „Bon“ nyɛ „Bonbon“. „Kassenbon“ yɛ krataa ketewa no – ɛkyerɛ deɛ woatɔ."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B na ɛteɛ. Anaa: „Ja, bitte.“ (Aane, mepa wo kyɛw.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "Da pa!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "Meda wo ase, wo nso saa ara!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "Ka di m'akyi!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "Meda wo ase, wo nso saa ara!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "Afotuo mmiɛnsa ma supermarket wɔ Gyaaman."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "Nea edi kan: Kwasiada, supermarket fa pii to mu – enti tɔ nneɛma Memeneda!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "Nea ɛtɔ so mmienu: wɔ sika tuabea, wo ara wode biribiara gu ɔhama no so."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "Dua a ɛtetew mu no kyerɛ: ɛha na adetɔni a ɔdi hɔ no deɛ fi aseɛ."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "Na nea ɛtɔ so mmiɛnsa: sika tuabea hɔ deɛ, ɛkɔ ntɛm."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "Wie tua a, gu wo nneɛma wɔ akyi brɛoo – ɛyɛ biribi a ɛtaa si."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo rekyerɛw nneɛma a ɔbɛtɔ. Nanso biribi nteɛ …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "Yogurt toa baako."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "Yogurt kɔpo baako!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "Paanoo kankyee baako."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "Paanoo baako – anaa toast pakete baako!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "Macaroni kɔpo baako."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "Macaroni pakete baako!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "Nsuo pakete baako."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "Nsuo toa baako!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "Ntoosi kotokuo baako."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "Ntoosi kankyee baako!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (Ɛhe na mehunu kyiisi no?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "Na adeyɛ asɛmfua no kɔ awieeɛ: ɛnyɛ „Ich möchte bezahlen mit Karte“, na: „Ich möchte mit Karte bezahlen.“ (Mepɛ sɛ mede kaad tua.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "Na wɔ sika tuabea: „Bon“ ne rasiid. „Bonbon“ yɛ ɛswiiti."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "Na seesei, ne nyinaa bio. Kasamu titire du no. Ka di m'akyi!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "Wobɛtumi asesa euro enum ama me?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "Kafra, ɛhe na mehunu esiam?"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "Mepa wo kyɛw, mepɛ Gouda kyiisi gram 200."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "Aane, ɛyɛ."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "Daabi, meda wo ase. Ɛno ara ne no."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "Kwadu no bo so atew."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "Ɛhe na toa san gye mfiri no wɔ?"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "Mekura kotokuo."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "Metumi de kaad atua?"
    },
    {
      "start": 659.66,
      "end": 662,
      "text": "Meda wo ase, wo nso saa ara!"
    },
    {
      "start": 665.05,
      "end": 669.27,
      "text": "Dɛn na ɛyɛ wo dɛ sɛ wotɔ wɔ supermarket mu? Kyerɛw wɔ comments mu!"
    },
    {
      "start": 669.37,
      "end": 672.39,
      "text": "Bye, na yɛbɛhyia bio wɔ LilyLingua!"
    }
  ]
}
