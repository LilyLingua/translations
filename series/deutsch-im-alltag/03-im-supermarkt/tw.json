    },
    {
      "start": 357.97,
      "end": 361.69,
      "text": "A! Meboaboa stamps ano. Efi sukuu bere."
    },
    {
      "start": 362.34,
      "end": 370.69,
      "text": "Ɛyɛ fɛ, Leo – nanso ɛnyɛ ɛno na ɔpɛ sɛ ɔte. C! Supermarket pii wɔ kaad anaa app a points wɔ so."
    },
    {
      "start": 370.74,
      "end": 374.79,
      "text": "Sɛ wonni bi a, ka kɛkɛ: „Nein, danke.“"
    },
    {
      "start": 375.04,
      "end": 376.45,
      "text": "Ka di m'akyi!"
    },
    {
      "start": 376.5,
      "end": 378.63,
      "text": "Daabi, meda wo ase."
    },
    {
      "start": 381.44,
      "end": 384.2,
      "text": "Aane, me kaad ni."
    },
    {
      "start": 388.23,
      "end": 390.13,
      "text": "Wohia kotokuo?"
    },
    {
      "start": 390.23,
      "end": 391.45,
      "text": "Dɛn na wobɛka?"
    },
    {
      "start": 391.5,
