    },
    {
      "start": 317.21,
      "end": 323.45,
      "text": "Daabi, Leo – ɛno de wotow sika gu! A! Toa pii no, wonya cent 25 san."
    },
    {
      "start": 323.5,
      "end": 328.22,
      "text": "Mfiri no ma wo krataa ketewa. Wode ma wɔ sika tuabea."
    },
    {
      "start": 328.47,
      "end": 329.88,
      "text": "Ka di m'akyi!"
    },
    {
      "start": 329.93,
      "end": 332.58,
      "text": "Ɛhe na toa san gye mfiri no wɔ?"
    },
    {
      "start": 336.49,
      "end": 340.14,
      "text": "Seesei wowɔ sika tuabea. Wode biribiara gu ɔhama a ɛkeka no so."
    },
    {
      "start": 340.24,
