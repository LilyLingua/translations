  "subtitles": [
    {
      "start": 0.4,
      "end": 5.17,
      "text": "Tako sam gladan! Ali frižider mi je prazan."
    },
    {
      "start": 5.27,
      "end": 7.71,
      "text": "Onda pravac u supermarket!"
    },
    {
      "start": 7.81,
      "end": 10.57,
      "text": "Supermarket? Sve na njemačkom?"
    },
    {
      "start": 10.67,
      "end": 16.98,
      "text": "Naravno! Danas obavljaš cijelu kupovinu – od kolica do računa."
    },
    {
      "start": 17.03,
      "end": 21.29,
      "text": "I u svakoj situaciji te pitamo: Šta kažeš?"
    },
    {
      "start": 21.39,
      "end": 23.76,
      "text": "I imaš samo pet sekundi!"
    },
    {
      "start": 27.06,
      "end": 34.36,
      "text": "Hoćeš kolica. Ali za to ti treba kovanica – a imaš samo novčanicu od pet eura."
    },
    {
      "start": 34.41,
      "end": 36.95,
      "text": "Pored tebe stoji stariji gospodin."
    },
    {
      "start": 37.05,
      "end": 38.52,
      "text": "Šta kažeš?"
    },
    {
      "start": 38.62,
      "end": 42.74,
      "text": "A: Izvinite, možete li mi pokloniti pet eura?"
    },
    {
      "start": 42.79,
      "end": 47.01,
      "text": "B: Izvinite, možete li mi usitniti pet eura?"
    },
    {
      "start": 47.06,
      "end": 50.79,
      "text": "C: Izvinite, hoću vaša kolica."
    },
    {
      "start": 56.49,
      "end": 62.73,
      "text": "B! „Wechseln“ znači: daješ novčanicu i dobiješ kovanice. „Schenken“"
    },
    {
      "start": 62.78,
      "end": 68.94,
      "text": "znači: dobiješ besplatno – to bi bilo jako lijepo, ali malo drsko."
    },
    {
      "start": 69.19,
      "end": 74.35,
      "text": "Trenutak … da: dva, četiri, pet eura. Izvolite!"
    },
    {
      "start": 74.45,
      "end": 75.84,
      "text": "Hvala puno!"
    },
    {
      "start": 75.94,
      "end": 77.35,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 77.4,
      "end": 80.45,
      "text": "Možete li mi usitniti pet eura?"
    },
    {
      "start": 84.81,
      "end": 91.49,
      "text": "Treba ti brašno. Ali gdje je brašno? Jedan radnik upravo slaže policu."
    },
    {
      "start": 91.59,
      "end": 93.14,
      "text": "Šta pitaš?"
    },
    {
      "start": 93.24,
      "end": 96.89,
      "text": "A: Izvinite, gdje mogu naći brašno?"
    },
    {
      "start": 96.94,
      "end": 99.38,
      "text": "B: „Wo ist der Mehl?“ (pogrešan član)"
    },
    {
      "start": 99.43,
      "end": 102.19,
      "text": "C: Jeste li našli brašno?"
    },
    {
      "start": 107.39,
      "end": 109.83,
      "text": "B! „Wo ist der Mehl?“"
    },
    {
      "start": 110.48,
      "end": 117.53,
      "text": "Skoro, Leo. Kaže se „das Mehl“. Ali A je još bolje: „Entschuldigung, wo finde ich …?“"
    },
    {
      "start": 117.58,
      "end": 121.66,
      "text": "(Izvinite, gdje mogu naći …?) – tako pristojno pitaš za sve u supermarketu."
    },
    {
      "start": 121.91,
      "end": 125.55,
      "text": "Brašno je u prolazu tri, skroz dolje na polici."
    },
    {
      "start": 125.65,
      "end": 126.97,
      "text": "Hvala lijepa!"
    },
    {
      "start": 127.07,
      "end": 128.48,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 128.53,
      "end": 132.09,
      "text": "Izvinite, gdje mogu naći brašno?"
    },
    {
      "start": 136.56,
      "end": 139.6,
      "text": "Prolaz tri, skroz dolje."
    },
    {
      "start": 143.97,
      "end": 147.62,
      "text": "Sada ideš do pulta sa svježim proizvodima. Hoćeš goudu."
    },
    {
      "start": 147.72,
      "end": 150.08,
      "text": "Dobar dan! Šta želite?"
    },
    {
      "start": 150.18,
      "end": 151.4,
      "text": "Šta kažeš?"
    },
    {
      "start": 151.45,
      "end": 154.86,
      "text": "A: Ja sam 200 grama goude."
    },
    {
      "start": 154.91,
      "end": 157.85,
      "text": "B: Da, smije biti."
    },
    {
      "start": 157.9,
      "end": 162.12,
      "text": "C: Molio bih 200 grama goude, molim."
    },
    {
      "start": 167.82,
      "end": 174.01,
      "text": "C! „Was darf's sein?“ znači jednostavno: Šta želite? A s „Ich hätte gern …“"
    },
    {
      "start": 174.06,
      "end": 179.31,
      "text": "(Molio bih …) uvijek pristojno naručuješ – na pultu, u pekari, u kafiću."
    },
    {
      "start": 179.56,
      "end": 180.96,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 181.01,
      "end": 184.79,
      "text": "Molio bih 200 grama goude, molim."
    },
    {
      "start": 190,
      "end": 195.81,
      "text": "Gospođa Haas reže sir. Vaga pokazuje: 230 grama."
    },
    {
      "start": 195.91,
      "end": 198.35,
      "text": "Može li malo više?"
    },
    {
      "start": 198.45,
      "end": 199.68,
      "text": "Šta kažeš?"
    },
    {
      "start": 199.72,
      "end": 202.74,
      "text": "A: Ne, ne smijem."
    },
    {
      "start": 202.79,
      "end": 205.97,
      "text": "B: Da, u redu je."
    },
    {
      "start": 206.02,
      "end": 209.67,
      "text": "C: Da, ja sam malo više."
    },
    {
      "start": 215.37,
      "end": 223.63,
      "text": "B! Ovu rečenicu čuješ na svakom pultu u Njemačkoj. Znači: malo je više nego što si naručio – je li to u redu?"
    },
    {
      "start": 223.68,
      "end": 228.05,
      "text": "Ako nije, samo reci: „Nein, bitte genau 200 Gramm.“ (Ne, molim tačno 200 grama.)"
    },
    {
      "start": 228.3,
      "end": 229.86,
      "text": "Još nešto?"
    },
    {
      "start": 229.96,
      "end": 232.56,
      "text": "Ne, hvala. To je sve."
    },
    {
      "start": 232.66,
      "end": 234.06,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 234.11,
      "end": 236.77,
      "text": "Da, u redu je."
    },
    {
      "start": 240.18,
      "end": 243.43,
      "text": "Ne, hvala. To je sve."
    },
    {
      "start": 248.04,
      "end": 253.2,
      "text": "Ideš dalje. Odjednom čuješ obavještenje. Slušaj pažljivo!"
    },
    {
      "start": 253.3,
      "end": 260.34,
      "text": "Dragi kupci! Danas na akciji: banane, kilogram za samo 99 centi."
    },
    {
      "start": 260.44,
      "end": 263.12,
      "text": "Koliko košta kilogram banana?"
    },
    {
      "start": 263.22,
      "end": 265.98,
      "text": "A: 9,90 €"
    },
    {
      "start": 266.03,
      "end": 269.05,
      "text": "B: 1,99 €"
    },
    {
      "start": 269.1,
      "end": 271.78,
      "text": "C: 99 centi"
    },
    {
      "start": 277.48,
      "end": 283.92,
      "text": "C! 99 centi. „Im Angebot“ znači: danas jeftinije nego inače."
    },
    {
      "start": 284.17,
      "end": 285.57,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 285.62,
      "end": 288.49,
      "text": "Banane su na akciji."
    },
    {
      "start": 292.64,
      "end": 298.22,
      "text": "Imaš i prazne boce – s ovim znakom: povratna naknada („Pfand“). Kamo s njima?"
    },
    {
      "start": 298.32,
      "end": 302.54,
      "text": "A: Na automat za povrat boca. Dobiješ novac nazad."
    },
    {
      "start": 302.59,
      "end": 305.77,
      "text": "B: U kantu za smeće na ulazu."
    },
    {
      "start": 305.82,
      "end": 309.15,
      "text": "C: Na kasu – kao poklon."
    },
    {
      "start": 314.35,
      "end": 316.56,
      "text": "B, u smeće!"
    },
    {
      "start": 317.21,
      "end": 323.45,
      "text": "Ne, Leo – tako bacaš novac! A! Za mnoge boce dobiješ 25 centi nazad."
    },
    {
      "start": 323.5,
      "end": 328.22,
      "text": "Automat ti da bon. Njega predaš na kasi."
    },
    {
      "start": 328.47,
      "end": 329.88,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 329.93,
      "end": 332.58,
      "text": "Gdje je automat za povrat boca?"
    },
    {
      "start": 336.49,
      "end": 340.14,
      "text": "Sada si na kasi. Stavljaš sve na traku."
    },
    {
      "start": 340.24,
      "end": 342.53,
      "text": "Zdravo! Skupljate li bodove?"
    },
    {
      "start": 342.63,
      "end": 343.85,
      "text": "Šta kažeš?"
    },
    {
      "start": 343.9,
      "end": 347.23,
      "text": "A: Da, skupljam poštanske marke."
    },
    {
      "start": 347.28,
      "end": 350.04,
      "text": "B: Skupljam vaše bodove."
    },
    {
      "start": 350.09,
      "end": 352.77,
      "text": "C: Ne, hvala."
    },
    {
      "start": 357.97,
      "end": 361.69,
      "text": "A! Skupljam poštanske marke. Još od škole."
    },
    {
      "start": 362.34,
      "end": 370.69,
      "text": "Lijepo, Leo – ali to ona ne želi znati. C! Mnogi supermarketi imaju karticu ili aplikaciju s bodovima."
    },
    {
      "start": 370.74,
      "end": 374.79,
      "text": "Ako je nemaš, samo reci: „Nein, danke.“"
    },
    {
      "start": 375.04,
      "end": 376.45,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 376.5,
      "end": 378.63,
      "text": "Ne, hvala."
    },
    {
      "start": 381.44,
      "end": 384.2,
      "text": "Da, izvolite moju karticu."
    },
    {
      "start": 388.23,
      "end": 390.13,
      "text": "Treba li vam kesa?"
    },
    {
      "start": 390.23,
      "end": 391.45,
      "text": "Šta kažeš?"
    },
    {
      "start": 391.5,
      "end": 394.75,
      "text": "A: Da, jednu kesu mlijeka, molim."
    },
    {
      "start": 394.8,
      "end": 398.76,
      "text": "B: Ne, hvala. Imam torbu sa sobom."
    },
    {
      "start": 398.81,
      "end": 402.22,
      "text": "C: Ne, ja nisam kesa."
    },
    {
      "start": 407.92,
      "end": 412.38,
      "text": "B! Dobro je znati: u Njemačkoj se kese skoro uvijek plaćaju."
    },
    {
      "start": 412.43,
      "end": 415.8,
      "text": "Mnogi ljudi donose svoju torbu."
    },
    {
      "start": 416.05,
      "end": 417.46,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 417.51,
      "end": 419.95,
      "text": "Imam torbu sa sobom."
    },
    {
      "start": 423.62,
      "end": 429.02,
      "text": "To je 23,47 €. Plaćate li gotovinom ili karticom?"
    },
    {
      "start": 429.12,
      "end": 430.34,
      "text": "Šta kažeš?"
    },
    {
      "start": 430.39,
      "end": 432.76,
      "text": "A: Karticom, molim."
    },
    {
      "start": 432.81,
      "end": 435.25,
      "text": "B: Plaćam sa „Bar“."
    },
    {
      "start": 435.3,
      "end": 438.71,
      "text": "C: Da, gotovina ili kartica."
    },
    {
      "start": 443.91,
      "end": 445.89,
      "text": "C! Da!"
    },
    {
      "start": 446.54,
      "end": 452.38,
      "text": "Leo … ovo nije pitanje da ili ne! A! „Bar“ znači: novčanicama i kovanicama. A ako nisi siguran, pitaj: „Kann ich mit Karte zahlen?“"
    },
    {
      "start": 452.43,
      "end": 457.79,
      "text": "(Mogu li platiti karticom?)"
    },
    {
      "start": 458.04,
      "end": 459.44,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 459.49,
      "end": 461.41,
      "text": "Karticom, molim."
    },
    {
      "start": 463.99,
      "end": 466.53,
      "text": "Mogu li platiti karticom?"
    },
    {
      "start": 470.33,
      "end": 472.22,
      "text": "Želite li račun?"
    },
    {
      "start": 472.32,
      "end": 473.54,
      "text": "Šta kažeš?"
    },
    {
      "start": 473.59,
      "end": 477.16,
      "text": "A: Ne, ne volim bombone („Bonbons“)."
    },
    {
      "start": 477.21,
      "end": 480.78,
      "text": "B: Ne, hvala. Ne treba mi."
    },
    {
      "start": 480.83,
      "end": 483.85,
      "text": "C: Da, hoću kasu."
    },
    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! Ne volim bombone. Previše šećera."
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "Leo! „Bon“ nije „Bonbon“. „Kassenbon“ je papirić – na njemu piše šta si kupio."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B je tačno. Ili: „Ja, bitte.“ (Da, molim.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "Ugodan dan!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "Hvala, i vama!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "Ponovi za mnom!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "Hvala, i vama!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "Tri savjeta za supermarket u Njemačkoj."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "Prvo: nedjeljom su skoro svi supermarketi zatvoreni – zato kupuj u subotu!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "Drugo: na kasi sam stavljaš sve na traku."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "Pregrada pokazuje: odavde je sljedeći kupac."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "I treće: na kasi ide brzo."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "Pakuj mirno iza kase – to je sasvim normalno."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo piše spisak za kupovinu. Ali nešto tu ne štima …"
    },
    {
      "start": 546.7,
      "end": 548.6,
      "text": "Jedna boca jogurta."
    },
    {
      "start": 548.8,
      "end": 551.01,
      "text": "Jedna čašica jogurta!"
    },
    {
      "start": 551.66,
      "end": 553.63,
      "text": "Jedna konzerva hljeba."
    },
    {
      "start": 553.83,
      "end": 557.01,
      "text": "Jedan hljeb – ili jedno pakovanje tost hljeba!"
    },
    {
      "start": 557.66,
      "end": 559.55,
      "text": "Jedna čašica tjestenine."
    },
    {
      "start": 559.75,
      "end": 561.96,
      "text": "Jedno pakovanje tjestenine!"
    },
    {
      "start": 562.61,
      "end": 564.43,
      "text": "Jedno pakovanje vode."
    },
    {
      "start": 564.63,
      "end": 566.68,
      "text": "Jedna boca vode!"
    },
    {
      "start": 567.33,
      "end": 569.15,
      "text": "Jedna kesa paradajza."
    },
    {
      "start": 569.35,
      "end": 571.64,
      "text": "Jedna konzerva paradajza!"
    },
    {
      "start": 572.29,
      "end": 574.42,
      "text": "„Wo finde ich der Käse?“"
    },
    {
      "start": 574.57,
      "end": 577.82,
      "text": "„Den Käse“! „Wo finde ich den Käse?“ (Gdje mogu naći sir?)"
    },
    {
      "start": 578.27,
      "end": 586.65,
      "text": "A glagol ide na kraj: ne „Ich möchte bezahlen mit Karte“, nego: „Ich möchte mit Karte bezahlen.“ (Želim platiti karticom.)"
    },
    {
      "start": 587.1,
      "end": 592.91,
      "text": "I na kasi: „Bon“ je račun. „Bonbon“ je slatkiš."
    },
    {
      "start": 593.36,
      "end": 598.94,
      "text": "A sada sve još jednom. Deset najvažnijih rečenica. Ponovi za mnom!"
    },
    {
      "start": 598.99,
      "end": 602.14,
      "text": "Možete li mi usitniti pet eura?"
    },
    {
      "start": 606.12,
      "end": 609.69,
      "text": "Izvinite, gdje mogu naći brašno?"
    },
    {
      "start": 614.16,
      "end": 617.93,
      "text": "Molio bih 200 grama goude, molim."
    },
    {
      "start": 622.64,
      "end": 625.29,
      "text": "Da, u redu je."
    },
    {
      "start": 628.71,
      "end": 631.96,
      "text": "Ne, hvala. To je sve."
    },
    {
      "start": 636.07,
      "end": 638.82,
      "text": "Banane su na akciji."
    },
    {
      "start": 642.36,
      "end": 645.01,
      "text": "Gdje je automat za povrat boca?"
    },
    {
      "start": 648.42,
      "end": 650.87,
      "text": "Imam torbu sa sobom."
    },
    {
      "start": 654.04,
      "end": 656.49,
      "text": "Mogu li platiti karticom?"
    },
    {
      "start": 659.66,
      "end": 662,
