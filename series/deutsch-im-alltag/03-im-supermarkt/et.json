    {
      "start": 489.05,
      "end": 492.69,
      "text": "A! Mulle ei meeldi kommid. Liiga palju suhkrut."
    },
    {
      "start": 493.34,
      "end": 501.69,
      "text": "Leo! „Bon“ ei ole „Bonbon“. „Kassenbon“ on pabeririba – sellel on kirjas, mida sa ostsid."
    },
    {
      "start": 501.74,
      "end": 504.9,
      "text": "B on õige. Või: „Ja, bitte.“ (Jah, palun.)"
    },
    {
      "start": 505.15,
      "end": 506.71,
      "text": "Ilusat päeva!"
    },
    {
      "start": 506.81,
      "end": 508.71,
      "text": "Aitäh, teile ka!"
    },
    {
      "start": 508.81,
      "end": 510.21,
      "text": "Korda minu järel!"
    },
    {
      "start": 510.26,
      "end": 512.6,
      "text": "Aitäh, teile ka!"
    },
    {
      "start": 516.16,
      "end": 519.31,
      "text": "Kolm nõuannet Saksamaa supermarketi jaoks."
    },
    {
      "start": 519.36,
      "end": 525.81,
      "text": "Esiteks: pühapäeval on peaaegu kõik supermarketid suletud – nii et käi poes laupäeval!"
    },
    {
      "start": 526.06,
      "end": 529.75,
      "text": "Teiseks: kassas paned sa kõik ise lindile."
    },
    {
      "start": 529.8,
      "end": 533.86,
      "text": "Eraldaja näitab: siit algab järgmise kliendi kaup."
    },
    {
      "start": 534.11,
      "end": 536.82,
      "text": "Ja kolmandaks: kassas käib kõik kiiresti."
    },
    {
      "start": 536.87,
      "end": 540.71,
      "text": "Paki oma asjad rahulikult pärast kassat – see on täiesti tavaline."
    },
    {
      "start": 541.06,
      "end": 546.45,
      "text": "Leo kirjutab ostunimekirja. Aga midagi on valesti …"
