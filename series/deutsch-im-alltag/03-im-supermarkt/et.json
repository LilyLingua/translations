    {
      "start": 263.22,
      "end": 265.98,
      "text": "A: 9,90 €"
    },
    {
      "start": 266.03,
      "end": 269.05,
      "text": "B: 1,99 €"
    },
    {
      "start": 269.1,
      "end": 271.78,
      "text": "C: 99 senti"
    },
    {
      "start": 277.48,
      "end": 283.92,
      "text": "C! 99 senti. „Im Angebot“ tähendab: täna tavalisest odavam."
    },
    {
      "start": 284.17,
      "end": 285.57,
      "text": "Korda minu järel!"
    },
    {
      "start": 285.62,
      "end": 288.49,
      "text": "Banaanid on pakkumisel."
    },
    {
      "start": 292.64,
      "end": 298.22,
      "text": "Sul on kaasas ka tühjad pudelid – selle märgiga: pandipakend („Pfand“). Kuhu need lähevad?"
    },
    {
      "start": 298.32,
      "end": 302.54,
      "text": "A: Taaraautomaati. Sa saad raha tagasi."
    },
    {
      "start": 302.59,
      "end": 305.77,
      "text": "B: Prügikasti sissepääsu juures."
    },
    {
      "start": 305.82,
      "end": 309.15,
      "text": "C: Kassasse – kingituseks."
    },
    {
      "start": 314.35,
      "end": 316.56,
      "text": "B, prügikasti!"
    },
    {
      "start": 317.21,
      "end": 323.45,
      "text": "Ei, Leo – siis viskad sa raha minema! A! Paljude pudelite eest saad sa 25 senti tagasi."
    },
    {
      "start": 323.5,
      "end": 328.22,
      "text": "Automaat annab sulle tšeki. Selle annad sa kassas ära."
    },
    {
      "start": 328.47,
      "end": 329.88,
      "text": "Korda minu järel!"
    },
    {
      "start": 329.93,
      "end": 332.58,
      "text": "Kus on taaraautomaat?"
    },
    {
      "start": 336.49,
      "end": 340.14,
      "text": "Nüüd oled sa kassas. Sa paned kõik lindile."
    },
    {
      "start": 340.24,
      "end": 342.53,
      "text": "Tere! Kas te kogute punkte?"
    },
    {
      "start": 342.63,
      "end": 343.85,
      "text": "Mida sa ütled?"
    },
    {
      "start": 343.9,
      "end": 347.23,
      "text": "A: Jah, ma kogun postmarke."
    },
    {
      "start": 347.28,
      "end": 350.04,
      "text": "B: Ma kogun teie punkte."
    },
    {
      "start": 350.09,
      "end": 352.77,
      "text": "C: Ei, aitäh."
    },
    {
      "start": 357.97,
      "end": 361.69,
      "text": "A! Ma kogun postmarke. Juba koolist saati."
    },
    {
      "start": 362.34,
      "end": 370.69,
      "text": "Tore, Leo – aga seda ta teada ei taha. C! Paljudel supermarketitel on punktidega kaart või äpp."
    },
    {
      "start": 370.74,
      "end": 374.79,
      "text": "Kui sul seda ei ole, ütle lihtsalt: „Nein, danke.“"
    },
    {
      "start": 375.04,
      "end": 376.45,
      "text": "Korda minu järel!"
    },
    {
      "start": 376.5,
      "end": 378.63,
      "text": "Ei, aitäh."
    },
    {
      "start": 381.44,
      "end": 384.2,
      "text": "Jah, siin on minu kaart."
    },
    {
      "start": 388.23,
      "end": 390.13,
      "text": "Kas teil on kotti vaja?"
    },
    {
      "start": 390.23,
      "end": 391.45,
      "text": "Mida sa ütled?"
    },
    {
      "start": 391.5,
      "end": 394.75,
      "text": "A: Jah, üks kott piima, palun."
    },
    {
      "start": 394.8,
