    },
    {
      "start": 407.92,
      "end": 412.38,
      "text": "B! Hea teada: Saksamaal maksavad kilekotid peaaegu alati raha."
    },
    {
      "start": 412.43,
      "end": 415.8,
      "text": "Paljud inimesed toovad oma koti kaasa."
    },
    {
      "start": 416.05,
      "end": 417.46,
