      "start": 613.24,
      "end": 618.18,
      "text": "Grip („Grippe“) çok daha kötüdür: yüksek ateş, yatakta yatarsın."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "Ve şimdi her şey bir kez daha. En önemli on cümle. Tekrar et!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "Randevu almak istiyorum."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "İşte kartım."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "Bunu lütfen daha yavaş söyleyebilir misiniz?"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "Başım ağrıyor ve ateşim var."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "Karnım ağrıyor."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "Üç günden beri."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "Penisiline alerjim var."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "Rapora ihtiyacım var."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "Günde üç kez yemekten sonra."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "Geçmiş olsun!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "Senin için en zor durum hangisiydi? Yorumlara yaz!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "Gelecek sefer resmi daireye gidiyoruz. Orada gerçekten yardıma ihtiyacım var."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "LilyLingua'da görüşmek üzere!"
    }
  ]
}
