      "text": "تکرار کن!"
    },
    {
      "start": 524.76,
      "end": 527.8,
      "text": "روزی سه بار بعد از غذا."
    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "ان‌شاءالله زود خوب شوید!"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "اگر مطب بسته باشد چه؟ دو شماره را به خاطر بسپار."
    },
    {
      "start": 540.07,
      "end": 549.69,
      "text": "۱۱۶ ۱۱۷: خدمات پزشک کشیک – وقتی شب یا آخر هفته به دکتر نیاز داری، ولی اورژانسی نیست."
    },
    {
      "start": 549.94,
      "end": 558.63,
      "text": "و ۱۱۲: شمارهٔ اورژانس – برای آمبولانس و آتش‌نشانی، مثلاً بعد از تصادف یا وقتی تنگی نفس شدید داری."
    },
    {
      "start": 558.98,
      "end": 563.99,
      "text": "در کلاس جمله‌های قشنگ یاد می‌گیری. اما آلمانی‌ها واقعاً چه می‌گویند؟"
    },
    {
      "start": 564.24,
      "end": 566.37,
      "text": "گلودرد دارم."
    },
    {
      "start": 566.57,
      "end": 568.62,
      "text": "گلویم می‌خارد."
    },
    {
      "start": 569.27,
      "end": 571.01,
      "text": "مریض هستم."
    },
    {
      "start": 571.21,
      "end": 573.02,
      "text": "گرفتار شدم."
    },
    {
      "start": 573.67,
      "end": 575.73,
      "text": "مریضی به من سرایت کرد."
    },
    {
      "start": 575.93,
      "end": 578.14,
      "text": "یک چیزی گرفته‌ام."
    },
    {
      "start": 578.79,
      "end": 581.54,
      "text": "خیلی خسته و ضعیفم."
    },
    {
      "start": 581.75,
      "end": 583.95,
      "text": "کاملاً بی‌حالم."
    },
    {
      "start": 584.6,
      "end": 586.81,
      "text": "کمردرد دارم."
    },
    {
      "start": 587.01,
      "end": 588.75,
      "text": "کمرم گرفته."
    },
    {
      "start": 589.4,
      "end": 592.42,
      "text": "برر، من خیلی سرد هستم!"
    },
    {
      "start": 592.57,
      "end": 598.54,
      "text": "لئو … تو که آدم سردی نیستی. منظورت این است: «⁦Mir ist kalt.⁩» (سردم است.)"
    },
    {
      "start": 598.99,
      "end": 603.9,
      "text": "و دقت کن: «⁦Mir ist schlecht⁩» یعنی «⁦حالم بد است⁩» به‌طور کلی نیست."
    },
    {
      "start": 603.95,
      "end": 607.52,
      "text": "یعنی: حالت تهوع دارم، شاید بالا بیاورم."
    },
    {
      "start": 607.97,
      "end": 613.19,
      "text": "آنفولانزا یا سرماخوردگی؟ آبریزش بینی و سرفه معمولاً سرماخوردگی است («⁦Erkältung⁩»)."
    },
    {
      "start": 613.24,
      "end": 618.18,
      "text": "آنفولانزا («⁦Grippe⁩») خیلی بدتر است: تب بالا، در رختخواب می‌مانی."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "و حالا همه چیز یک بار دیگر. ده جملهٔ مهم. تکرار کن!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "می‌خواستم یک وقت بگیرم."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "این کارت من است."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "می‌شود لطفاً آهسته‌تر بگویید؟"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "سردرد و تب دارم."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "شکمم درد می‌کند."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "از سه روز پیش."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "به پنی‌سیلین حساسیت دارم."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "گواهی استعلاجی لازم دارم."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "روزی سه بار بعد از غذا."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "ان‌شاءالله زود خوب شوید!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "کدام موقعیت برایت از همه سخت‌تر بود؟ در کامنت‌ها بنویس!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "دفعهٔ بعد به اداره می‌رویم. آنجا واقعاً کمک لازم دارم."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "به امید دیدار در LilyLingua!"
    }
  ]
}
