    {
      "start": 71.45,
      "end": 74.39,
      "text": "ቆጸራ ክሕዝ ደልየ ነይረ።"
    },
    {
      "start": 78.64,
      "end": 82.36,
      "text": "ናብ ክሊኒክ ትበጽሑ። ኣብ መቐበሊ ይሓቱኹም፦"
    },
    {
      "start": 82.46,
      "end": 85.22,
