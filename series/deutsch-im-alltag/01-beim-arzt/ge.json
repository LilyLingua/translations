      "start": 456.55,
      "end": 463.95,
      "text": "მთავარია: დამსაქმებელს მაინც თავად შეატყობინე – უმჯობესია პირველივე დღეს, დილით."
    },
    {
      "start": 464.2,
      "end": 467.04,
      "text": "კი, გთხოვთ. ჩემი დამსაქმებლისთვის."
    },
    {
      "start": 467.14,
      "end": 469.5,
      "text": "პარასკევამდე ავად გწერთ."
    },
    {
      "start": 469.6,
      "end": 471.01,
      "text": "გამიმეორე!"
    },
    {
      "start": 471.06,
      "end": 473.82,
      "text": "მჭირდება ავადმყოფობის ფურცელი."
    },
    {
      "start": 477.85,
      "end": 483.25,
      "text": "რეცეპტს გამოგიწერ. ტაბლეტები სამჯერ დღეში ჭამის შემდეგ მიიღე."
    },
    {
      "start": 483.35,
      "end": 486.68,
      "text": "ყურადღებით მოუსმინე! როდის უნდა მიიღო ტაბლეტები?"
    },
    {
      "start": 486.78,
      "end": 490.27,
      "text": "A: დღეში ერთხელ, დაძინებამდე."
    },
    {
      "start": 490.32,
      "end": 494.77,
      "text": "B: დილით, შუადღეს და საღამოს – ჭამის შემდეგ."
    },
    {
      "start": 494.82,
      "end": 498.39,
      "text": "C: სამჯერ დღეში – ჭამამდე."
    },
    {
      "start": 504.09,
      "end": 509.39,
      "text": "B! „Dreimal täglich“ ნიშნავს სამჯერ დღეში. და „nach dem Essen“"
    },
    {
      "start": 509.44,
      "end": 512.93,
      "text": "– ანუ ჯერ ჭამე, მერე ტაბლეტი."
    },
    {
      "start": 513.18,
      "end": 515.47,
      "text": "დიდი მადლობა. ნახვამდის!"
    },
    {
      "start": 515.57,
      "end": 517.05,
      "text": "გამოჯანმრთელებას გისურვებ!"
    },
    {
      "start": 517.15,
      "end": 523.2,
      "text": "„Gute Besserung“ – ასე ეუბნებიან ავადმყოფს. ნიშნავს: მალე გამოჯანმრთელდი!"
    },
    {
      "start": 523.3,
      "end": 524.71,
      "text": "გამიმეორე!"
    },
    {
      "start": 524.76,
      "end": 527.8,
      "text": "სამჯერ დღეში ჭამის შემდეგ."
    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "გამოჯანმრთელებას გისურვებ!"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "თუ პრაქტიკა დახურულია? დაიმახსოვრე ორი ნომერი."
    },
    {
      "start": 540.07,
      "end": 549.69,
      "text": "116 117: სამედიცინო მორიგე სამსახური – როცა ღამით ან შაბათ-კვირას ექიმი გჭირდება, მაგრამ გადაუდებელი არ არის."
    },
    {
      "start": 549.94,
      "end": 558.63,
      "text": "და 112: გადაუდებელი დახმარების ნომერი – სასწრაფოსა და სახანძროსთვის, მაგალითად ავარიის ან სუნთქვის გაჭირვების დროს."
    },
    {
      "start": 558.98,
      "end": 563.99,
      "text": "გაკვეთილზე ლამაზ წინადადებებს სწავლობ. მაგრამ რას ამბობენ გერმანელები სინამდვილეში?"
    },
    {
      "start": 564.24,
      "end": 566.37,
      "text": "ყელი მტკივა."
    },
    {
      "start": 566.57,
      "end": 568.62,
      "text": "ყელი მექავება."
    },
    {
      "start": 569.27,
      "end": 571.01,
      "text": "ავად ვარ."
    },
    {
      "start": 571.21,
      "end": 573.02,
      "text": "მეც დამემართა. (დავიწვინე.)"
    },
    {
      "start": 573.67,
      "end": 575.73,
      "text": "დავინფიცირდი."
    },
    {
      "start": 575.93,
      "end": 578.14,
      "text": "რაღაც შემეყარა."
    },
    {
      "start": 578.79,
      "end": 581.54,
      "text": "ძალიან დაღლილი და სუსტი ვარ."
    },
    {
      "start": 581.75,
      "end": 583.95,
      "text": "სულ ძალაგამოცლილი ვარ."
    },
    {
      "start": 584.6,
      "end": 586.81,
      "text": "ზურგი მტკივა."
    },
    {
      "start": 587.01,
      "end": 588.75,
      "text": "ზურგში მაქვს."
    },
    {
      "start": 589.4,
      "end": 592.42,
      "text": "ბრ... როგორ მცივა!"
    },
    {
      "start": 592.57,
      "end": 598.54,
      "text": "ლეო... შენ ხომ ცივი ადამიანი არ ხარ. გინდა თქვა: „Mir ist kalt.“ (ცივა.)"
    },
    {
      "start": 598.99,
      "end": 603.9,
      "text": "და ფრთხილად: „Mir ist schlecht“ არ ნიშნავს „ცუდად ვარ“."
    },
    {
      "start": 603.95,
      "end": 607.52,
      "text": "ნიშნავს: შეიძლება გული ამერიოს."
    },
    {
      "start": 607.97,
      "end": 613.19,
      "text": "გრიპი თუ გაციება? სურდო და ხველება უმეტესად გაციებაა."
    },
    {
      "start": 613.24,
      "end": 618.18,
      "text": "გრიპი ბევრად მძიმეა: მაღალი სიცხე, საწოლში წოლა."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "ახლა ყველაფერი კიდევ ერთხელ. ათი ყველაზე მნიშვნელოვანი წინადადება. გამიმეორე!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "მინდა ჩაწერა."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "აი ჩემი ბარათი."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "შეგიძლიათ ნელა თქვათ?"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "თავი მტკივა და სიცხე მაქვს."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "მუცელი მტკივა."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "სამი დღეა."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "ალერგიული ვარ პენიცილინის მიმართ."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "მჭირდება ავადმყოფობის ფურცელი."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "სამჯერ დღეში ჭამის შემდეგ."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "გამოჯანმრთელებას გისურვებ!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "რომელი სიტუაცია იყო შენთვის ყველაზე რთული? დაწერე კომენტარებში!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "შემდეგ ჯერზე სამსახურებში მივდივართ. იქ მართლა დახმარება მჭირდება."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "მალე შევხვდებით LilyLingua-ზე!"
    }
  ]
}
