    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "お大事に！"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "もしクリニックが閉まっていたら？ 2つの番号を覚えておきましょう。"
