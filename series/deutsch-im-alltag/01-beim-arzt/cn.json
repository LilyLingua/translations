    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "我头疼，还发烧。"
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "我肚子疼。"
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "三天了。"
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "我对青霉素过敏。"
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "我需要病假条。"
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "一天三次，饭后吃。"
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "祝你早日康复！"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "你觉得哪种情况最难？在评论区写下来！"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "下次我们去办事大厅。那我真的需要帮忙。"
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "LilyLingua，下次见！"
    }
  ]
}
