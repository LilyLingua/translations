    },
    {
      "start": 523.3,
      "end": 524.71,
      "text": "תחזור אחרי!"
    },
    {
      "start": 524.76,
      "end": 527.8,
      "text": "שלוש פעמים ביום אחרי האוכל."
    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "החלמה מהירה!"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "ומה אם המרפאה סגורה? תזכור שני מספרים."
    },
    {
      "start": 540.07,
      "end": 549.69,
      "text": "116 117: שירות רופא תורן – אם אתה צריך רופא בלילה או בסוף השבוע, אבל זה לא מקרה חירום."
    },
    {
      "start": 549.94,
      "end": 558.63,
      "text": "ו-112: מספר החירום – לאמבולנס ולכבאות, למשל אחרי תאונה או כשיש קוצר נשימה חמור."
    },
    {
      "start": 558.98,
      "end": 563.99,
      "text": "בקורס לומדים משפטים יפים. אבל מה גרמנים באמת אומרים?"
    },
    {
      "start": 564.24,
      "end": 566.37,
      "text": "יש לי כאב גרון."
    },
    {
      "start": 566.57,
      "end": 568.62,
      "text": "הגרון שלי שורט."
    },
    {
      "start": 569.27,
      "end": 571.01,
      "text": "אני חולה."
    },
    {
      "start": 571.21,
      "end": 573.02,
      "text": "תפס אותי."
    },
    {
      "start": 573.67,
      "end": 575.73,
      "text": "נדבקתי."
    },
    {
      "start": 575.93,
      "end": 578.14,
      "text": "תפסתי משהו."
    },
    {
      "start": 578.79,
      "end": 581.54,
      "text": "אני מאוד עייף וחלש."
    },
    {
      "start": 581.75,
      "end": 583.95,
      "text": "אני גמור לגמרי."
    },
    {
      "start": 584.6,
      "end": 586.81,
      "text": "יש לי כאב גב."
    },
    {
      "start": 587.01,
      "end": 588.75,
      "text": "הגב שלי עושה בעיות."
    },
    {
      "start": 589.4,
      "end": 592.42,
      "text": "בררר, כל כך קר לי!"
    },
    {
      "start": 592.57,
      "end": 598.54,
      "text": "ליאו... אתה לא בן אדם קר. אתה מתכוון: «⁦Mir ist kalt.⁩» (קר לי.)"
    },
    {
      "start": 598.99,
      "end": 603.9,
      "text": "ושים לב: «⁦Mir ist schlecht⁩» לא אומר «⁦לא טוב לי⁩»."
    },
    {
      "start": 603.95,
      "end": 607.52,
      "text": "זה אומר: אולי אני הולך להקיא."
    },
    {
      "start": 607.97,
      "end": 613.19,
      "text": "שפעת או התקררות? נזלת ושיעול זה בדרך כלל התקררות."
    },
    {
      "start": 613.24,
      "end": 618.18,
      "text": "שפעת הרבה יותר קשה: חום גבוה, שוכבים במיטה."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "ועכשיו הכל שוב. עשרת המשפטים הכי חשובים. תחזור אחרי!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "אני רוצה לקבוע תור."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "הנה הכרטיס שלי."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "אפשר בבקשה לאט יותר?"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "יש לי כאב ראש וחום."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "הבטן שלי כואבת."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "מזה שלושה ימים."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "אני אלרגי נגד פניצילין."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "אני צריך אישור מחלה."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "שלוש פעמים ביום אחרי האוכל."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "החלמה מהירה!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "איזה מצב היה הכי קשה בשבילך? כתוב בתגובות!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "בפעם הבאה הולכים למשרד ממשלתי. שם אני באמת צריך עזרה."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "נתראה בקרוב ב-LilyLingua!"
    }
  ]
}
