  "subtitles": [
    {
      "start": 0.4,
      "end": 5.4,
      "text": "Tu sergi. Turi eiti pas gydytoją. Bet … vokiškai?"
    },
    {
      "start": 5.5,
      "end": 10.74,
      "text": "O ne. Pas gydytoją praėjusį kartą pasakiau: „Ich bin Kopfschmerzen.“ (Aš esu galvos skausmas.)"
    },
    {
      "start": 10.84,
      "end": 18.61,
      "text": "Būtent todėl šiandien esame čia. Patirsi visą apsilankymą pas gydytoją – nuo pirmojo skambučio iki recepto."
    },
    {
      "start": 18.66,
      "end": 22.9,
      "text": "Ir kiekvienoje situacijoje tavęs klausiame: ką tu sakai?"
    },
    {
      "start": 23,
      "end": 25.21,
      "text": "Ir turi tik penkias sekundes!"
    },
    {
      "start": 28.51,
      "end": 32.23,
      "text": "Skambini į gydytojo kabinetą. Kažkas atsiliepia."
    },
    {
      "start": 32.33,
      "end": 36.87,
      "text": "Dr. Yilmaz praktika, kalba Schulz. Kuo galiu jums padėti?"
    },
    {
      "start": 36.97,
      "end": 38.19,
      "text": "Ką tu sakai?"
    },
    {
      "start": 38.24,
      "end": 41.34,
      "text": "A: Aš noriu daktaras. Dabar."
    },
    {
      "start": 41.39,
      "end": 45.5,
      "text": "B: Laba diena, norėčiau užsiregistruoti vizitui."
    },
    {
      "start": 45.55,
      "end": 49.43,
      "text": "C: Labas, aš sergu. Iki."
    },
    {
      "start": 55.13,
      "end": 59.11,
      "text": "B! „Ich möchte gern …“ (norėčiau …) yra mandagu ir visada tinka."
    },
    {
      "start": 59.16,
      "end": 63.35,
      "text": "„Ich will“ (aš noriu) telefonu greitai skamba nemandagiai."
    },
    {
      "start": 63.6,
      "end": 66.86,
      "text": "Laba diena, norėčiau užsiregistruoti vizitui."
    },
    {
      "start": 66.96,
      "end": 69.9,
      "text": "Žinoma. Ar tinka šiandien dešimtą valandą?"
    },
    {
      "start": 70,
      "end": 71.4,
      "text": "Kartok po manęs!"
    },
    {
      "start": 71.45,
      "end": 74.39,
      "text": "Norėčiau užsiregistruoti vizitui."
    },
    {
      "start": 78.64,
      "end": 82.36,
      "text": "Ateini į kabinetą. Registratūroje tavęs klausia:"
    },
    {
      "start": 82.46,
      "end": 85.22,
      "text": "Ar turite su savimi sveikatos draudimo kortelę?"
    },
    {
      "start": 85.32,
      "end": 86.54,
      "text": "Ką tu sakai?"
    },
    {
      "start": 86.59,
      "end": 89.92,
      "text": "A: Ne, aš apdraustas ne."
    },
    {
      "start": 89.97,
      "end": 93.07,
      "text": "B: Taip, aš alkanas."
    },
    {
      "start": 93.12,
      "end": 96.22,
      "text": "C: Taip, štai mano kortelė."
    },
    {
      "start": 101.92,
      "end": 108.09,
      "text": "C! „Versichertenkarte“ – kai kas sako ir „Gesundheitskarte“ arba „Krankenkassenkarte“."
    },
    {
      "start": 108.14,
      "end": 113.24,
      "text": "Tai visada ta pati kortelė. Pasiimk ją į kiekvieną vizitą pas gydytoją."
    },
    {
      "start": 113.49,
      "end": 115.7,
      "text": "Taip, štai mano kortelė."
    },
    {
      "start": 115.8,
      "end": 117.05,
      "text": "Ačiū."
    },
    {
      "start": 117.14,
      "end": 118.55,
      "text": "Kartok po manęs!"
    },
    {
      "start": 118.6,
      "end": 121.36,
      "text": "Taip, štai mano kortelė."
    },
    {
      "start": 125.39,
      "end": 129.43,
      "text": "Moteris kalba labai greitai. Tu ne viską supranti."
    },
    {
      "start": 129.53,
      "end": 133.65,
      "text": "Prašom užpildyti formą ir tada atsisėsti laukiamajame."
    },
    {
      "start": 133.75,
      "end": 134.97,
      "text": "Ką tu sakai?"
    },
    {
      "start": 135.02,
      "end": 139.4,
      "text": "A: Atsiprašau, ar galėtumėte pasakyti lėčiau?"
    },
    {
      "start": 139.44,
      "end": 141.5,
      "text": "B: Ką?"
    },
    {
      "start": 141.55,
      "end": 144.31,
      "text": "C: Pasiimsiu vietą su savimi."
    },
    {
      "start": 150,
      "end": 158.17,
      "text": "A! „Was?“ (Ką?) skamba nemandagiai. Šis klausimas tave išgelbės visur: „Können Sie das bitte langsamer sagen?“"
    },
    {
      "start": 158.22,
      "end": 160.94,
      "text": "Galima ir trumpiau: „Wie bitte?“ (Atsiprašau, kaip?)"
    },
    {
      "start": 161.19,
      "end": 164.84,
      "text": "Atsiprašau, ar galėtumėte pasakyti lėčiau?"
    },
    {
      "start": 164.94,
      "end": 172.19,
      "text": "Žinoma. Prašom užpildyti šią formą. Tada palaukite ten, laukiamajame."
    },
    {
      "start": 172.29,
      "end": 173.69,
      "text": "Kartok po manęs!"
    },
    {
      "start": 173.74,
      "end": 177.1,
      "text": "Ar galėtumėte pasakyti lėčiau?"
    },
    {
      "start": 181.83,
      "end": 185.39,
      "text": "Tu esi pas gydytoją kabinete. Jis klausia:"
    },
    {
      "start": 185.49,
      "end": 188.17,
      "text": "Laba diena. Tai kas jums negerai?"
    },
    {
      "start": 188.27,
      "end": 189.49,
      "text": "Ką tu sakai?"
    },
    {
      "start": 189.54,
      "end": 192.64,
      "text": "A: Man nieko netrūksta, ačiū."
    },
    {
      "start": 192.69,
      "end": 196.26,
      "text": "B: Man skauda galvą ir karščiuoju."
    },
    {
      "start": 196.31,
      "end": 199.15,
      "text": "C: Aš esu galvos skausmas."
    },
    {
      "start": 204.84,
      "end": 212.25,
      "text": "B! Atsargiai: „Was fehlt Ihnen?“ reiškia ne „Ko jums trūksta?“, o „Kokia jūsų problema?“"
    },
    {
      "start": 212.3,
      "end": 218.18,
      "text": "Jei sakai „Mir fehlt nichts“, esi sveikas – ir iš tikrųjų pas gydytoją ne vietoje."
    },
    {
      "start": 218.43,
      "end": 221.19,
      "text": "Man skauda galvą ir karščiuoju."
    },
    {
      "start": 221.29,
      "end": 223.42,
      "text": "O, labai gaila."
    },
    {
      "start": 223.52,
      "end": 224.93,
      "text": "Kartok po manęs!"
    },
    {
      "start": 224.98,
      "end": 228.54,
      "text": "Man skauda galvą ir karščiuoju."
    },
    {
      "start": 233.51,
      "end": 237.16,
      "text": "Ar jums skauda ir pilvą? Kur skauda?"
    },
    {
      "start": 237.25,
      "end": 240.43,
      "text": "Tau skauda pilvą. Ką tu sakai?"
    },
    {
      "start": 240.53,
      "end": 243.47,
      "text": "A: Aš skaudu pilve."
    },
    {
      "start": 243.52,
      "end": 246.36,
      "text": "B: Pilvas yra skauda."
    },
    {
      "start": 246.41,
      "end": 250.05,
      "text": "C: Štai čia, man skauda pilvą."
    },
    {
      "start": 255.75,
      "end": 263.48,
      "text": "C! Štai kaip: kūno dalis plius „tut weh“ (skauda). Jei daugiau nei viena: „Meine Füße tun weh.“ (Man skauda kojas.)"
    },
    {
      "start": 263.73,
      "end": 266.33,
      "text": "Štai čia, man skauda pilvą."
    },
    {
      "start": 266.43,
      "end": 267.83,
      "text": "Kartok po manęs!"
    },
    {
      "start": 267.88,
      "end": 270.54,
      "text": "Man skauda pilvą."
    },
    {
      "start": 273.95,
      "end": 276.89,
      "text": "Man skauda kojas."
    },
    {
      "start": 281.13,
      "end": 283.5,
      "text": "Nuo kada jaučiate šiuos simptomus?"
    },
    {
      "start": 283.6,
      "end": 284.82,
      "text": "Ką tu sakai?"
    },
    {
      "start": 284.87,
      "end": 287.55,
      "text": "A: Prieš tris dienas ilgai."
    },
    {
      "start": 287.6,
      "end": 290.12,
      "text": "B: Jau tris diena."
    },
    {
      "start": 290.17,
      "end": 292.85,
      "text": "C: Jau tris dienas."
    },
    {
      "start": 298.55,
      "end": 303.6,
      "text": "C! Po „seit“ (nuo, jau) eina naudininkas – todėl „Tagen“ su n. Taip pat „seit einer Woche“"
    },
    {
      "start": 303.65,
      "end": 307.97,
      "text": "(jau savaitę), „seit gestern“ (nuo vakar)."
    },
    {
      "start": 308.22,
      "end": 309.96,
      "text": "Jau tris dienas."
    },
    {
      "start": 310.06,
      "end": 311.47,
      "text": "Kartok po manęs!"
    },
    {
      "start": 311.52,
      "end": 313.75,
      "text": "Jau tris dienas."
    },
    {
      "start": 316.69,
      "end": 318.61,
      "text": "Jau savaitę."
    },
    {
      "start": 321.68,
      "end": 325.48,
      "text": "Pasiklausysiu jūsų krūtinės. Prašom nusirengti iki pusės."
    },
    {
      "start": 325.58,
      "end": 327.32,
      "text": "Ką darai dabar?"
    },
    {
      "start": 327.42,
      "end": 331.14,
      "text": "A: Nusivelki megztinį ir marškinėlius."
    },
    {
      "start": 331.19,
      "end": 334.03,
      "text": "B: Nusimauni kelnes."
    },
    {
      "start": 334.08,
      "end": 337.81,
      "text": "C: Eini namo – juk esi laisvas."
    },
    {
      "start": 343,
      "end": 347.38,
      "text": "Tai … C, taip? Aš laisvas – einu namo!"
    },
    {
      "start": 348.03,
      "end": 357.15,
      "text": "Ne, Leo. A! „Oberkörper“ – tai viršutinė kūno dalis. „Frei machen“ čia reiškia: nusirengti."
    },
    {
      "start": 357.2,
      "end": 362.23,
      "text": "Tada dažnai išgirsi: „Tief einatmen … und ausatmen.“ (Giliai įkvėpkite … ir iškvėpkite.)"
    },
    {
      "start": 362.48,
      "end": 367.41,
      "text": "Giliai įkvėpkite … ir iškvėpkite. Gerai."
    },
    {
      "start": 367.51,
      "end": 368.91,
      "text": "Kartok po manęs!"
    },
    {
      "start": 368.96,
      "end": 372.74,
      "text": "įkvėpti – iškvėpti"
    },
    {
      "start": 377.95,
      "end": 380.39,
      "text": "Ar jūs kam nors alergiškas?"
    },
    {
      "start": 380.49,
      "end": 381.71,
      "text": "Ką tu sakai?"
    },
    {
      "start": 381.76,
      "end": 385.64,
      "text": "A: Taip, aš alergiškas dėl penicilino."
    },
    {
      "start": 385.69,
      "end": 389.73,
      "text": "B: Taip, aš alergiškas penicilinui."
    },
    {
      "start": 389.78,
      "end": 393.19,
      "text": "C: Nelabai mėgstu penicilino."
    },
    {
      "start": 398.89,
      "end": 401.38,
      "text": "B! Alergiškas esi „gegen“ kažką. O jei alergijos neturi: „Nein, ich habe keine Allergien.“"
    },
    {
      "start": 401.43,
      "end": 406.61,
      "text": "(Ne, alergijų neturiu.)"
    },
    {
      "start": 406.86,
      "end": 409.96,
      "text": "Taip, aš alergiškas penicilinui."
    },
    {
      "start": 410.06,
      "end": 413.7,
      "text": "Gerai, kad pasakėte. Tada gausite ką nors kita."
    },
    {
      "start": 413.81,
      "end": 415.21,
      "text": "Kartok po manęs!"
    },
    {
      "start": 415.26,
      "end": 418.31,
      "text": "Aš alergiškas penicilinui."
    },
    {
      "start": 422.17,
      "end": 424.51,
      "text": "Alergijų neturiu."
    },
    {
      "start": 428.06,
      "end": 432.1,
      "text": "Rytoj negali dirbti. Gydytojas klausia:"
    },
    {
      "start": 432.2,
      "end": 434.41,
      "text": "Ar jums reikia nedarbingumo pažymėjimo?"
    },
    {
      "start": 434.51,
      "end": 435.73,
      "text": "Ką tu sakai?"
    },
    {
      "start": 435.78,
      "end": 438.8,
      "text": "A: Ne, aš rašau pats."
    },
    {
      "start": 438.85,
      "end": 442.03,
      "text": "B: Taip, aš rašau sergu."
    },
    {
      "start": 442.08,
      "end": 445.8,
      "text": "C: Taip, prašom. Mano darbdaviui."
    },
    {
      "start": 451.5,
      "end": 456.5,
      "text": "C! „Krankschreibung“ (nedarbingumo pažymėjimas) parodo: tu sergi ir negali dirbti."
    },
    {
      "start": 456.55,
      "end": 463.95,
      "text": "Svarbu: vis tiek pats pranešk darbdaviui – geriausia pirmą dieną, anksti ryte."
    },
    {
      "start": 464.2,
      "end": 467.04,
      "text": "Taip, prašom. Mano darbdaviui."
    },
    {
      "start": 467.14,
      "end": 469.5,
      "text": "Išrašysiu jums nedarbingumą iki penktadienio."
    },
    {
      "start": 469.6,
      "end": 471.01,
      "text": "Kartok po manęs!"
    },
    {
      "start": 471.06,
      "end": 473.82,
      "text": "Man reikia nedarbingumo pažymėjimo."
    },
    {
      "start": 477.85,
      "end": 483.25,
      "text": "Išrašysiu jums receptą. Gerkite tabletes tris kartus per dieną po valgio."
    },
    {
      "start": 483.35,
      "end": 486.68,
      "text": "Klausykis atidžiai! Kada geri tabletes?"
    },
    {
      "start": 486.78,
      "end": 490.27,
      "text": "A: Kartą per dieną, prieš miegą."
    },
    {
      "start": 490.32,
      "end": 494.77,
      "text": "B: Ryte, per pietus ir vakare – po valgio."
    },
    {
      "start": 494.82,
      "end": 498.39,
      "text": "C: Tris kartus per dieną – prieš valgį."
    },
    {
      "start": 504.09,
      "end": 509.39,
      "text": "B! „Dreimal täglich“ reiškia tris kartus per dieną. O „nach dem Essen“"
    },
    {
      "start": 509.44,
      "end": 512.93,
      "text": "– taigi pirma pavalgai, paskui geri tabletę."
    },
    {
      "start": 513.18,
      "end": 515.47,
      "text": "Labai ačiū. Viso gero!"
    },
    {
      "start": 515.57,
      "end": 517.05,
      "text": "Greitai pasveikite!"
    },
    {
      "start": 517.15,
      "end": 523.2,
      "text": "„Gute Besserung“ – taip sakoma sergantiems žmonėms. Tai reiškia: greitai pasveik!"
    },
    {
      "start": 523.3,
      "end": 524.71,
      "text": "Kartok po manęs!"
    },
    {
      "start": 524.76,
      "end": 527.8,
      "text": "Tris kartus per dieną po valgio."
    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "Greitai pasveikite!"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "O jei kabinetas uždarytas? Įsimink du numerius."
    },
    {
      "start": 540.07,
      "end": 549.69,
      "text": "116 117: budinčių gydytojų tarnyba – kai gydytojo reikia naktį ar savaitgalį, bet tai nėra skubus atvejis."
    },
    {
      "start": 549.94,
      "end": 558.63,
      "text": "Ir 112: skubiosios pagalbos numeris – greitajai ir ugniagesiams, pavyzdžiui, po nelaimingo atsitikimo arba esant stipriam dusuliui."
    },
    {
      "start": 558.98,
      "end": 563.99,
      "text": "Kursuose mokaisi gražių sakinių. Bet ką vokiečiai sako iš tikrųjų?"
    },
    {
      "start": 564.24,
      "end": 566.37,
      "text": "Man skauda gerklę."
    },
    {
      "start": 566.57,
      "end": 568.62,
      "text": "Man perši gerklę."
    },
    {
      "start": 569.27,
      "end": 571.01,
      "text": "Aš sergu."
    },
    {
      "start": 571.21,
      "end": 573.02,
      "text": "Mane pagavo. (Kažkuo susirgau.)"
    },
    {
      "start": 573.67,
      "end": 575.73,
      "text": "Užsikrėčiau."
    },
    {
      "start": 575.93,
      "end": 578.14,
      "text": "Kažką pasigavau."
    },
    {
      "start": 578.79,
      "end": 581.54,
      "text": "Esu labai pavargęs ir silpnas."
    },
    {
      "start": 581.75,
      "end": 583.95,
      "text": "Esu visiškai išsekęs."
    },
    {
      "start": 584.6,
      "end": 586.81,
      "text": "Man skauda nugarą."
    },
    {
      "start": 587.01,
      "end": 588.75,
      "text": "Nugara šoktelėjo."
    },
    {
      "start": 589.4,
      "end": 592.42,
      "text": "Brrr, aš toks šaltas!"
    },
    {
      "start": 592.57,
      "end": 598.54,
      "text": "Leo … tu juk ne šaltas žmogus. Turi omenyje: „Mir ist kalt.“ (Man šalta.)"
    },
    {
      "start": 598.99,
      "end": 603.9,
      "text": "Ir atsargiai: „Mir ist schlecht“ nereiškia „man nesiseka“."
    },
    {
      "start": 603.95,
      "end": 607.52,
      "text": "Tai reiškia: man bloga, galiu vemti."
    },
    {
      "start": 607.97,
      "end": 613.19,
      "text": "Gripas ar peršalimas? Sloga ir kosulys dažniausiai yra peršalimas („Erkältung“)."
    },
    {
      "start": 613.24,
      "end": 618.18,
      "text": "Gripas („Grippe“) daug sunkesnis: aukšta temperatūra, guli lovoje."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "O dabar viskas dar kartą. Dešimt svarbiausių sakinių. Kartok po manęs!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "Norėčiau užsiregistruoti vizitui."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "Štai mano kortelė."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "Ar galėtumėte pasakyti lėčiau?"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "Man skauda galvą ir karščiuoju."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "Man skauda pilvą."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "Jau tris dienas."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "Aš alergiškas penicilinui."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "Man reikia nedarbingumo pažymėjimo."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "Tris kartus per dieną po valgio."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "Greitai pasveikite!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "Kuri situacija tau buvo sunkiausia? Parašyk komentaruose!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "Kitą kartą einame į įstaigą. Ten man tikrai reikia pagalbos."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "Greitai pasimatysime LilyLingua!"
    }
  ]
}
