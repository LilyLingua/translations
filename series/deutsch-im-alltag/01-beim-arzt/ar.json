  "subtitles": [
    {
      "start": 0.4,
      "end": 5.4,
      "text": "أنت مريض. يجب أن تذهب إلى الطبيب. لكن … بالألمانية؟"
    },
    {
      "start": 5.5,
      "end": 10.74,
      "text": "أوه لا. في المرة الماضية قلت عند الطبيب: «⁦Ich bin Kopfschmerzen.⁩» (أنا صداع.)"
    },
    {
      "start": 10.84,
      "end": 18.61,
      "text": "لهذا السبب بالضبط نحن هنا اليوم. ستعيش زيارة كاملة للطبيب – من أول مكالمة حتى الوصفة الطبية."
    },
    {
      "start": 18.66,
      "end": 22.9,
      "text": "وفي كل موقف نسألك: ماذا تقول؟"
    },
    {
      "start": 23,
      "end": 25.21,
      "text": "ولديك خمس ثوانٍ فقط!"
    },
    {
      "start": 28.51,
      "end": 32.23,
      "text": "تتصل بعيادة الطبيب. شخص ما يرد."
    },
    {
      "start": 32.33,
      "end": 36.87,
      "text": "عيادة الدكتور يلماز، معك شولتس. كيف يمكنني مساعدتك؟"
    },
    {
      "start": 36.97,
      "end": 38.19,
      "text": "ماذا تقول؟"
    },
    {
      "start": 38.24,
      "end": 41.34,
      "text": "A: أريد دكتور. الآن."
    },
    {
      "start": 41.39,
      "end": 45.5,
      "text": "B: مرحبًا، أودّ أن أحجز موعدًا."
    },
    {
      "start": 45.55,
      "end": 49.43,
      "text": "C: مرحبًا، أنا مريض. إلى اللقاء."
    },
    {
      "start": 55.13,
      "end": 59.11,
      "text": "⁦B!⁩ «⁦Ich möchte gern …⁩» (أودّ …) مهذّبة ومناسبة دائمًا."
    },
    {
      "start": 59.16,
      "end": 63.35,
      "text": "أما «⁦Ich will⁩» (أريد) فتبدو بسرعة غير لطيفة على الهاتف."
    },
    {
      "start": 63.6,
      "end": 66.86,
      "text": "مرحبًا، أودّ أن أحجز موعدًا."
    },
    {
      "start": 66.96,
      "end": 69.9,
      "text": "بكل سرور. هل تناسبك الساعة العاشرة اليوم؟"
    },
    {
      "start": 70,
      "end": 71.4,
      "text": "كرّر!"
    },
    {
      "start": 71.45,
      "end": 74.39,
      "text": "أودّ أن أحجز موعدًا."
    },
    {
      "start": 78.64,
      "end": 82.36,
      "text": "تصل إلى العيادة. في الاستقبال يسألونك:"
    },
    {
      "start": 82.46,
      "end": 85.22,
      "text": "هل معك بطاقة التأمين الصحي؟"
    },
    {
      "start": 85.32,
      "end": 86.54,
      "text": "ماذا تقول؟"
    },
    {
      "start": 86.59,
      "end": 89.92,
      "text": "A: لا، أنا مؤمَّن لا."
    },
    {
      "start": 89.97,
      "end": 93.07,
      "text": "B: نعم، أنا جائع."
    },
    {
      "start": 93.12,
      "end": 96.22,
      "text": "C: نعم، هذه بطاقتي."
    },
    {
      "start": 101.92,
      "end": 108.09,
      "text": "⁦C!⁩ «⁦Versichertenkarte⁩» – البعض يقول أيضًا «⁦Gesundheitskarte⁩» أو «⁦Krankenkassenkarte⁩»."
    },
    {
      "start": 108.14,
      "end": 113.24,
      "text": "المقصود دائمًا البطاقة نفسها. خذها معك في كل زيارة للطبيب."
    },
    {
      "start": 113.49,
      "end": 115.7,
      "text": "نعم، هذه بطاقتي."
    },
    {
      "start": 115.8,
      "end": 117.05,
      "text": "شكرًا جزيلًا."
    },
    {
      "start": 117.14,
      "end": 118.55,
      "text": "كرّر!"
    },
    {
      "start": 118.6,
      "end": 121.36,
      "text": "نعم، هذه بطاقتي."
    },
    {
      "start": 125.39,
      "end": 129.43,
      "text": "المرأة تتكلم بسرعة كبيرة. لا تفهم كل شيء."
    },
    {
      "start": 129.53,
      "end": 133.65,
      "text": "من فضلك املأ الاستمارة، ثم اجلس في غرفة الانتظار."
    },
    {
      "start": 133.75,
      "end": 134.97,
      "text": "ماذا تقول؟"
    },
    {
      "start": 135.02,
      "end": 139.4,
      "text": "A: عفوًا، هل يمكنك أن تقولي ذلك ببطء أكثر من فضلك؟"
    },
    {
      "start": 139.44,
      "end": 141.5,
      "text": "B: ماذا؟"
    },
    {
      "start": 141.55,
      "end": 144.31,
      "text": "C: سآخذ المقعد معي."
    },
    {
      "start": 150,
      "end": 158.17,
      "text": "⁦A!⁩ «⁦Was?⁩» (ماذا؟) تبدو غير مهذبة."
    },
    {
      "start": 158.22,
      "end": 160.94,
      "text": "هذا السؤال ينقذك في كل مكان: «⁦Können Sie das bitte langsamer sagen?⁩» ويمكن أيضًا باختصار: «⁦Wie bitte?⁩» (عفوًا؟)"
    },
    {
      "start": 161.19,
      "end": 164.84,
      "text": "عفوًا، هل يمكنك أن تقولي ذلك ببطء أكثر من فضلك؟"
    },
    {
      "start": 164.94,
      "end": 172.19,
      "text": "طبعًا. من فضلك املأ هذه الاستمارة. ثم انتظر هناك في غرفة الانتظار."
    },
    {
      "start": 172.29,
      "end": 173.69,
      "text": "كرّر!"
    },
    {
      "start": 173.74,
      "end": 177.1,
      "text": "هل يمكنك أن تقولي ذلك ببطء أكثر من فضلك؟"
    },
    {
      "start": 181.83,
      "end": 185.39,
      "text": "أنت عند الطبيب في غرفة الفحص. يسألك:"
    },
    {
      "start": 185.49,
      "end": 188.17,
      "text": "مرحبًا. ممَّ تشكو؟"
    },
    {
      "start": 188.27,
      "end": 189.49,
      "text": "ماذا تقول؟"
    },
    {
      "start": 189.54,
      "end": 192.64,
      "text": "A: لا أشكو من شيء، شكرًا."
    },
    {
      "start": 192.69,
      "end": 196.26,
      "text": "B: عندي صداع وحمّى."
    },
    {
      "start": 196.31,
      "end": 199.15,
      "text": "C: أنا صداع."
    },
    {
      "start": 204.84,
      "end": 212.25,
      "text": "⁦B!⁩ انتبه: «⁦Was fehlt Ihnen?⁩» لا تعني «⁦ماذا ينقصك؟⁩» بل «⁦ما مشكلتك؟⁩»."
    },
    {
      "start": 212.3,
      "end": 218.18,
      "text": "من يقول «⁦Mir fehlt nichts⁩» فهو بصحة جيدة – وفي الحقيقة لا داعي لوجوده عند الطبيب."
    },
    {
      "start": 218.43,
      "end": 221.19,
      "text": "عندي صداع وحمّى."
    },
    {
      "start": 221.29,
      "end": 223.42,
      "text": "أوه، سلامتك."
    },
    {
      "start": 223.52,
      "end": 224.93,
      "text": "كرّر!"
    },
    {
      "start": 224.98,
      "end": 228.54,
      "text": "عندي صداع وحمّى."
    },
    {
      "start": 233.51,
      "end": 237.16,
      "text": "هل عندك أيضًا ألم في البطن؟ أين يؤلمك؟"
    },
    {
      "start": 237.25,
      "end": 240.43,
      "text": "بطنك يؤلمك. ماذا تقول؟"
    },
    {
      "start": 240.53,
      "end": 243.47,
      "text": "A: أنا أؤلم في البطن."
    },
    {
      "start": 243.52,
      "end": 246.36,
      "text": "B: البطن هو ألم."
    },
    {
      "start": 246.41,
      "end": 250.05,
      "text": "C: هنا، بطني يؤلمني."
    },
    {
      "start": 255.75,
      "end": 263.48,
      "text": "⁦C!⁩ هكذا تقولها: جزء الجسم + «⁦tut weh⁩» (يؤلم). وبالجمع: «⁦Meine Füße tun weh.⁩» (قدماي تؤلمانني.)"
    },
    {
      "start": 263.73,
      "end": 266.33,
      "text": "هنا، بطني يؤلمني."
    },
    {
      "start": 266.43,
      "end": 267.83,
      "text": "كرّر!"
    },
    {
      "start": 267.88,
      "end": 270.54,
      "text": "بطني يؤلمني."
    },
    {
      "start": 273.95,
      "end": 276.89,
      "text": "قدماي تؤلمانني."
    },
    {
      "start": 281.13,
      "end": 283.5,
      "text": "منذ متى عندك هذه الأعراض؟"
    },
    {
      "start": 283.6,
      "end": 284.82,
      "text": "ماذا تقول؟"
    },
    {
      "start": 284.87,
      "end": 287.55,
      "text": "A: قبل ثلاثة أيام طوال."
    },
    {
      "start": 287.6,
      "end": 290.12,
      "text": "B: منذ ثلاثة يوم."
    },
    {
      "start": 290.17,
      "end": 292.85,
      "text": "C: منذ ثلاثة أيام."
    },
    {
      "start": 298.55,
      "end": 303.6,
      "text": "⁦C!⁩ بعد «⁦seit⁩» (منذ) تأتي حالة الـDativ – لذلك «⁦Tagen⁩» مع n."
    },
    {
      "start": 303.65,
      "end": 307.97,
      "text": "وكذلك: «⁦seit einer Woche⁩» (منذ أسبوع)، «⁦seit gestern⁩» (منذ أمس)."
    },
    {
      "start": 308.22,
      "end": 309.96,
      "text": "منذ ثلاثة أيام."
    },
    {
      "start": 310.06,
      "end": 311.47,
      "text": "كرّر!"
    },
    {
      "start": 311.52,
      "end": 313.75,
      "text": "منذ ثلاثة أيام."
    },
    {
      "start": 316.69,
      "end": 318.61,
      "text": "منذ أسبوع."
    },
    {
      "start": 321.68,
      "end": 325.48,
      "text": "سأستمع إلى صدرك. من فضلك اكشف الجزء العلوي من جسمك."
    },
    {
      "start": 325.58,
      "end": 327.32,
      "text": "ماذا تفعل الآن؟"
    },
    {
      "start": 327.42,
      "end": 331.14,
      "text": "A: تخلع الكنزة والقميص."
    },
    {
      "start": 331.19,
      "end": 334.03,
      "text": "B: تخلع البنطال."
    },
    {
      "start": 334.08,
      "end": 337.81,
      "text": "C: تذهب إلى البيت – فأنت حرّ."
    },
    {
      "start": 343,
      "end": 347.38,
      "text": "إذن … C، صح؟ أنا حرّ – سأذهب إلى البيت!"
    },
    {
      "start": 348.03,
      "end": 357.15,
      "text": "لا يا ليو. A! «⁦Oberkörper⁩» هو الجزء العلوي من الجسم. «⁦Frei machen⁩» تعني هنا: اخلع ملابسك."
    },
    {
      "start": 357.2,
      "end": 362.23,
      "text": "بعدها تسمع غالبًا: «⁦Tief einatmen … und ausatmen.⁩» (خذ نفسًا عميقًا … ثم أخرجه.)"
    },
    {
      "start": 362.48,
      "end": 367.41,
      "text": "خذ نفسًا عميقًا … ثم أخرجه. جيد."
    },
    {
      "start": 367.51,
      "end": 368.91,
      "text": "كرّر!"
    },
    {
      "start": 368.96,
      "end": 372.74,
      "text": "شهيق – زفير"
    },
    {
      "start": 377.95,
      "end": 380.39,
      "text": "هل عندك حساسية من شيء؟"
    },
    {
      "start": 380.49,
      "end": 381.71,
      "text": "ماذا تقول؟"
    },
    {
      "start": 381.76,
      "end": 385.64,
      "text": "A: نعم، عندي حساسية لأجل البنسلين."
    },
    {
      "start": 385.69,
      "end": 389.73,
      "text": "B: نعم، عندي حساسية من البنسلين."
    },
    {
      "start": 389.78,
      "end": 393.19,
      "text": "C: لا أحب البنسلين كثيرًا."
    },
    {
      "start": 398.89,
      "end": 401.38,
      "text": "⁦B!⁩ تكون الحساسية «⁦gegen⁩» شيء ما."
    },
    {
      "start": 401.43,
      "end": 406.61,
      "text": "وإذا لم تكن عندك حساسية: «⁦Nein, ich habe keine Allergien.⁩» (لا، ليس عندي حساسية.)"
    },
    {
      "start": 406.86,
      "end": 409.96,
      "text": "نعم، عندي حساسية من البنسلين."
    },
    {
      "start": 410.06,
      "end": 413.7,
      "text": "جيد أنك أخبرتني. إذن ستأخذ دواءً آخر."
    },
    {
      "start": 413.81,
      "end": 415.21,
      "text": "كرّر!"
    },
    {
      "start": 415.26,
      "end": 418.31,
      "text": "عندي حساسية من البنسلين."
    },
    {
      "start": 422.17,
      "end": 424.51,
      "text": "ليس عندي حساسية."
    },
    {
      "start": 428.06,
      "end": 432.1,
      "text": "لا تستطيع العمل غدًا. الطبيب يسأل:"
    },
    {
      "start": 432.2,
      "end": 434.41,
      "text": "هل تحتاج إلى إجازة مرضية؟"
    },
    {
      "start": 434.51,
      "end": 435.73,
      "text": "ماذا تقول؟"
    },
    {
      "start": 435.78,
      "end": 438.8,
      "text": "A: لا، أكتب بنفسي."
    },
    {
      "start": 438.85,
      "end": 442.03,
      "text": "B: نعم، أكتب مريض."
    },
    {
      "start": 442.08,
      "end": 445.8,
      "text": "C: نعم، من فضلك. لصاحب العمل."
    },
    {
      "start": 451.5,
      "end": 456.5,
      "text": "⁦C!⁩ «⁦Krankschreibung⁩» (الإجازة المرضية) تثبت أنك مريض ولا تستطيع العمل."
    },
    {
      "start": 456.55,
      "end": 463.95,
      "text": "مهم: أخبر صاحب العمل بنفسك أيضًا – والأفضل في اليوم الأول، في الصباح الباكر."
    },
    {
      "start": 464.2,
      "end": 467.04,
      "text": "نعم، من فضلك. لصاحب العمل."
    },
    {
      "start": 467.14,
      "end": 469.5,
      "text": "سأعطيك إجازة مرضية حتى يوم الجمعة."
    },
    {
      "start": 469.6,
      "end": 471.01,
      "text": "كرّر!"
    },
    {
      "start": 471.06,
      "end": 473.82,
      "text": "أحتاج إلى إجازة مرضية."
    },
    {
      "start": 477.85,
      "end": 483.25,
      "text": "سأكتب لك وصفة طبية. خذ الحبوب ثلاث مرات يوميًا بعد الأكل."
    },
    {
      "start": 483.35,
      "end": 486.68,
      "text": "استمع جيدًا! متى تأخذ الحبوب؟"
    },
    {
      "start": 486.78,
      "end": 490.27,
      "text": "A: مرة واحدة يوميًا، قبل النوم."
    },
    {
      "start": 490.32,
      "end": 494.77,
      "text": "B: صباحًا وظهرًا ومساءً – بعد الأكل."
    },
    {
      "start": 494.82,
      "end": 498.39,
      "text": "C: ثلاث مرات يوميًا – قبل الأكل."
    },
    {
      "start": 504.09,
      "end": 509.39,
      "text": "⁦B!⁩ «⁦Dreimal täglich⁩» تعني ثلاث مرات في اليوم."
    },
    {
      "start": 509.44,
      "end": 512.93,
      "text": "و«⁦nach dem Essen⁩» – أي أولًا تأكل، ثم تأخذ الحبة."
    },
    {
      "start": 513.18,
      "end": 515.47,
      "text": "شكرًا جزيلًا. إلى اللقاء!"
    },
    {
      "start": 515.57,
      "end": 517.05,
      "text": "سلامتك، شفاك الله!"
    },
    {
      "start": 517.15,
      "end": 523.2,
      "text": "«⁦Gute Besserung⁩» – هذا ما نقوله للمرضى. معناها: أتمنى لك الشفاء العاجل!"
    },
    {
      "start": 523.3,
      "end": 524.71,
      "text": "كرّر!"
    },
    {
      "start": 524.76,
      "end": 527.8,
      "text": "ثلاث مرات يوميًا بعد الأكل."
    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "سلامتك، شفاك الله!"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "وإذا كانت العيادة مغلقة؟ احفظ رقمين."
    },
    {
      "start": 540.07,
      "end": 549.69,
      "text": "116 117: خدمة الطبيب المناوب – عندما تحتاج إلى طبيب في الليل أو في عطلة نهاية الأسبوع، لكن الحالة ليست طارئة."
    },
    {
      "start": 549.94,
      "end": 558.63,
      "text": "و112: رقم الطوارئ – للإسعاف والإطفاء، مثلًا بعد حادث أو عند ضيق شديد في التنفس."
    },
    {
      "start": 558.98,
      "end": 563.99,
      "text": "في الدورة تتعلم جملًا جميلة. لكن ماذا يقول الألمان فعلًا؟"
    },
    {
      "start": 564.24,
      "end": 566.37,
      "text": "عندي ألم في الحلق."
    },
    {
      "start": 566.57,
      "end": 568.62,
      "text": "حلقي يحكّني."
    },
    {
      "start": 569.27,
      "end": 571.01,
      "text": "أنا مريض."
    },
    {
      "start": 571.21,
      "end": 573.02,
      "text": "أصابني المرض."
    },
    {
      "start": 573.67,
      "end": 575.73,
      "text": "انتقلت إليّ العدوى."
    },
    {
      "start": 575.93,
      "end": 578.14,
      "text": "التقطت شيئًا."
    },
    {
      "start": 578.79,
      "end": 581.54,
      "text": "أنا متعب جدًا وضعيف."
    },
    {
      "start": 581.75,
      "end": 583.95,
      "text": "أنا منهك تمامًا."
    },
    {
      "start": 584.6,
      "end": 586.81,
      "text": "عندي ألم في الظهر."
    },
    {
      "start": 587.01,
      "end": 588.75,
      "text": "ظهري يوجعني."
    },
    {
      "start": 589.4,
      "end": 592.42,
      "text": "برر، أنا بارد جدًا!"
    },
    {
      "start": 592.57,
      "end": 598.54,
      "text": "ليو … أنت لست شخصًا باردًا. تقصد: «⁦Mir ist kalt.⁩» (أشعر بالبرد.)"
    },
    {
      "start": 598.99,
      "end": 603.9,
      "text": "وانتبه: «⁦Mir ist schlecht⁩» لا تعني «⁦حالي سيئ⁩»."
    },
    {
      "start": 603.95,
      "end": 607.52,
      "text": "معناها: أشعر بالغثيان، ربما سأتقيأ."
    },
    {
      "start": 607.97,
      "end": 613.19,
      "text": "إنفلونزا أم زكام؟ سيلان الأنف والسعال غالبًا زكام («⁦Erkältung⁩»)."
    },
    {
      "start": 613.24,
      "end": 618.18,
      "text": "أما الإنفلونزا («⁦Grippe⁩») فأسوأ بكثير: حمّى عالية، وتبقى في السرير."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "والآن كل شيء مرة أخرى. أهم عشر جمل. كرّر!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "أودّ أن أحجز موعدًا."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "هذه بطاقتي."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "هل يمكنك أن تقولي ذلك ببطء أكثر من فضلك؟"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "عندي صداع وحمّى."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "بطني يؤلمني."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "منذ ثلاثة أيام."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "عندي حساسية من البنسلين."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "أحتاج إلى إجازة مرضية."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "ثلاث مرات يوميًا بعد الأكل."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "سلامتك، شفاك الله!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "أي موقف كان الأصعب بالنسبة لك؟ اكتبه في التعليقات!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "في المرة القادمة نذهب إلى الدائرة الحكومية. هناك أحتاج فعلًا إلى المساعدة."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "إلى اللقاء قريبًا مع LilyLingua!"
    }
  ]
}
