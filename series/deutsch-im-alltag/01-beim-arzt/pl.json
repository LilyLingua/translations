  "subtitles": [
    {
      "start": 0.4,
      "end": 5.4,
      "text": "Jesteś chory. Musisz iść do lekarza. Ale … po niemiecku?"
    },
    {
      "start": 5.5,
      "end": 10.74,
      "text": "O nie. Ostatnio u lekarza powiedziałem: „Ich bin Kopfschmerzen.“ (Jestem bólem głowy.)"
    },
    {
      "start": 10.84,
      "end": 18.61,
      "text": "Właśnie dlatego jesteśmy dziś tutaj. Przeżyjesz całą wizytę u lekarza – od pierwszego telefonu do recepty."
    },
    {
      "start": 18.66,
      "end": 22.9,
      "text": "I w każdej sytuacji pytamy cię: Co mówisz?"
    },
    {
      "start": 23,
      "end": 25.21,
      "text": "A masz tylko pięć sekund!"
    },
    {
      "start": 28.51,
      "end": 32.23,
      "text": "Dzwonisz do przychodni. Ktoś odbiera."
    },
    {
      "start": 32.33,
      "end": 36.87,
      "text": "Gabinet dr. Yilmaza, przy telefonie Schulz. W czym mogę pomóc?"
    },
    {
      "start": 36.97,
      "end": 38.19,
      "text": "Co mówisz?"
    },
    {
      "start": 38.24,
      "end": 41.34,
      "text": "A: Chcę doktor. Teraz."
    },
    {
      "start": 41.39,
      "end": 45.5,
      "text": "B: Dzień dobry, chciałbym się umówić na wizytę."
    },
    {
      "start": 45.55,
      "end": 49.43,
      "text": "C: Cześć, jestem chory. Na razie."
    },
    {
      "start": 55.13,
      "end": 59.11,
      "text": "B! „Ich möchte gern …“ (Chciałbym …) jest uprzejme i zawsze pasuje."
    },
    {
      "start": 59.16,
      "end": 63.35,
      "text": "„Ich will“ (Chcę) przez telefon szybko brzmi nieuprzejmie."
    },
    {
      "start": 63.6,
      "end": 66.86,
      "text": "Dzień dobry, chciałbym się umówić na wizytę."
    },
    {
      "start": 66.96,
      "end": 69.9,
      "text": "Oczywiście. Czy pasuje dziś o dziesiątej?"
    },
    {
      "start": 70,
      "end": 71.4,
      "text": "Powtórz!"
    },
    {
      "start": 71.45,
      "end": 74.39,
      "text": "Chciałbym się umówić na wizytę."
    },
    {
      "start": 78.64,
      "end": 82.36,
      "text": "Przychodzisz do przychodni. W rejestracji pytają cię:"
    },
    {
      "start": 82.46,
      "end": 85.22,
      "text": "Ma pan/pani przy sobie kartę ubezpieczenia?"
    },
    {
      "start": 85.32,
      "end": 86.54,
      "text": "Co mówisz?"
    },
    {
      "start": 86.59,
      "end": 89.92,
      "text": "A: Nie, ja jestem ubezpieczony nie."
    },
    {
      "start": 89.97,
      "end": 93.07,
      "text": "B: Tak, jestem głodny."
    },
    {
      "start": 93.12,
      "end": 96.22,
      "text": "C: Tak, oto moja karta."
    },
    {
      "start": 101.92,
      "end": 108.09,
      "text": "C! „Versichertenkarte“ – niektórzy mówią też „Gesundheitskarte“ albo „Krankenkassenkarte“."
    },
    {
      "start": 108.14,
      "end": 113.24,
      "text": "Zawsze chodzi o tę samą kartę. Zabieraj ją na każdą wizytę."
    },
    {
      "start": 113.49,
      "end": 115.7,
      "text": "Tak, oto moja karta."
    },
    {
      "start": 115.8,
      "end": 117.05,
      "text": "Dziękuję bardzo."
    },
    {
      "start": 117.14,
      "end": 118.55,
      "text": "Powtórz!"
    },
    {
      "start": 118.6,
      "end": 121.36,
      "text": "Tak, oto moja karta."
    },
    {
      "start": 125.39,
      "end": 129.43,
      "text": "Pani mówi bardzo szybko. Nie rozumiesz wszystkiego."
    },
    {
      "start": 129.53,
      "end": 133.65,
      "text": "Proszę wypełnić formularz, a potem usiąść w poczekalni."
    },
    {
      "start": 133.75,
      "end": 134.97,
      "text": "Co mówisz?"
    },
    {
      "start": 135.02,
      "end": 139.4,
      "text": "A: Przepraszam, czy może pani powiedzieć to wolniej?"
    },
    {
      "start": 139.44,
      "end": 141.5,
      "text": "B: Co?"
    },
    {
      "start": 141.55,
      "end": 144.31,
      "text": "C: Biorę to miejsce ze sobą."
    },
    {
      "start": 150,
      "end": 158.17,
      "text": "A! „Was?“ (Co?) brzmi niegrzecznie. To pytanie ratuje cię wszędzie: „Können Sie das bitte langsamer sagen?“"
    },
    {
      "start": 158.22,
      "end": 160.94,
      "text": "Krócej też można: „Wie bitte?“ (Słucham?)"
    },
    {
      "start": 161.19,
      "end": 164.84,
      "text": "Przepraszam, czy może pani powiedzieć to wolniej?"
    },
    {
      "start": 164.94,
      "end": 172.19,
      "text": "Oczywiście. Proszę wypełnić ten formularz. Potem proszę poczekać tam, w poczekalni."
    },
    {
      "start": 172.29,
      "end": 173.69,
      "text": "Powtórz!"
    },
    {
      "start": 173.74,
      "end": 177.1,
      "text": "Czy może pani powiedzieć to wolniej?"
    },
    {
      "start": 181.83,
      "end": 185.39,
      "text": "Jesteś u lekarza w gabinecie. On pyta:"
    },
    {
      "start": 185.49,
      "end": 188.17,
      "text": "Dzień dobry. Co panu/pani dolega?"
    },
    {
      "start": 188.27,
      "end": 189.49,
      "text": "Co mówisz?"
    },
    {
      "start": 189.54,
      "end": 192.64,
      "text": "A: Nic mi nie dolega, dziękuję."
    },
    {
      "start": 192.69,
      "end": 196.26,
      "text": "B: Boli mnie głowa i mam gorączkę."
    },
    {
      "start": 196.31,
      "end": 199.15,
      "text": "C: Jestem bólem głowy."
    },
    {
      "start": 204.84,
      "end": 212.25,
      "text": "B! Uwaga: „Was fehlt Ihnen?“ nie znaczy „Czego panu brakuje?“, tylko „Jaki ma pan problem?“."
    },
    {
      "start": 212.3,
      "end": 218.18,
      "text": "Kto mówi „Mir fehlt nichts“, jest zdrowy – i właściwie nie ma czego szukać u lekarza."
    },
    {
      "start": 218.43,
      "end": 221.19,
      "text": "Boli mnie głowa i mam gorączkę."
    },
    {
      "start": 221.29,
      "end": 223.42,
      "text": "Och, przykro mi."
    },
    {
      "start": 223.52,
      "end": 224.93,
      "text": "Powtórz!"
    },
    {
      "start": 224.98,
      "end": 228.54,
      "text": "Boli mnie głowa i mam gorączkę."
    },
    {
      "start": 233.51,
      "end": 237.16,
      "text": "Czy boli pana/panią też brzuch? Gdzie boli?"
    },
    {
      "start": 237.25,
      "end": 240.43,
      "text": "Boli cię brzuch. Co mówisz?"
    },
    {
      "start": 240.53,
      "end": 243.47,
      "text": "A: Ja robię ból w brzuchu."
    },
    {
      "start": 243.52,
      "end": 246.36,
      "text": "B: Brzuch jest bolący."
    },
    {
      "start": 246.41,
      "end": 250.05,
      "text": "C: Tutaj, boli mnie brzuch."
    },
    {
      "start": 255.75,
      "end": 263.48,
      "text": "C! Tak to działa: część ciała + „tut weh“ (boli). W liczbie mnogiej: „Meine Füße tun weh.“ (Bolą mnie stopy.)"
    },
    {
      "start": 263.73,
      "end": 266.33,
      "text": "Tutaj, boli mnie brzuch."
    },
    {
      "start": 266.43,
      "end": 267.83,
      "text": "Powtórz!"
    },
    {
      "start": 267.88,
      "end": 270.54,
      "text": "Boli mnie brzuch."
    },
    {
      "start": 273.95,
      "end": 276.89,
      "text": "Bolą mnie stopy."
    },
    {
      "start": 281.13,
      "end": 283.5,
      "text": "Od kiedy ma pan/pani te dolegliwości?"
    },
    {
      "start": 283.6,
      "end": 284.82,
      "text": "Co mówisz?"
    },
    {
      "start": 284.87,
      "end": 287.55,
      "text": "A: Trzy dni temu przez."
    },
    {
      "start": 287.6,
      "end": 290.12,
      "text": "B: Od trzy dzień."
    },
    {
      "start": 290.17,
      "end": 292.85,
      "text": "C: Od trzech dni."
    },
    {
      "start": 298.55,
      "end": 303.6,
      "text": "C! Po „seit“ (od) stoi celownik (Dativ) – dlatego „Tagen“ z n. Tak samo: „seit einer Woche“"
    },
    {
      "start": 303.65,
      "end": 307.97,
      "text": "(od tygodnia), „seit gestern“ (od wczoraj)."
    },
    {
      "start": 308.22,
      "end": 309.96,
      "text": "Od trzech dni."
    },
    {
      "start": 310.06,
      "end": 311.47,
      "text": "Powtórz!"
    },
    {
      "start": 311.52,
      "end": 313.75,
      "text": "Od trzech dni."
    },
    {
      "start": 316.69,
      "end": 318.61,
      "text": "Od tygodnia."
    },
    {
      "start": 321.68,
      "end": 325.48,
      "text": "Osłucham pana/panią. Proszę się rozebrać do pasa."
    },
    {
      "start": 325.58,
      "end": 327.32,
      "text": "Co teraz robisz?"
    },
    {
      "start": 327.42,
      "end": 331.14,
      "text": "A: Zdejmujesz sweter i T-shirt."
    },
    {
      "start": 331.19,
      "end": 334.03,
      "text": "B: Zdejmujesz spodnie."
    },
    {
      "start": 334.08,
      "end": 337.81,
      "text": "C: Idziesz do domu – przecież jesteś wolny."
    },
    {
      "start": 343,
      "end": 347.38,
      "text": "No to … C, prawda? Jestem wolny – idę do domu!"
    },
    {
      "start": 348.03,
      "end": 357.15,
      "text": "Nie, Leo. A! „Oberkörper“ to górna część ciała. „Frei machen“ znaczy tu: rozebrać się. Potem często słyszysz: „Tief einatmen …"
    },
    {
      "start": 357.2,
      "end": 362.23,
      "text": "und ausatmen.“ (Proszę głęboko wdychać … i wydychać.)"
    },
    {
      "start": 362.48,
      "end": 367.41,
      "text": "Głęboki wdech … i wydech. Dobrze."
    },
    {
      "start": 367.51,
      "end": 368.91,
      "text": "Powtórz!"
    },
    {
      "start": 368.96,
      "end": 372.74,
      "text": "wdech – wydech"
    },
    {
      "start": 377.95,
      "end": 380.39,
      "text": "Czy jest pan/pani na coś uczulony/a?"
    },
    {
      "start": 380.49,
      "end": 381.71,
      "text": "Co mówisz?"
    },
    {
      "start": 381.76,
      "end": 385.64,
      "text": "A: Tak, jestem uczulony dla penicyliny."
    },
    {
      "start": 385.69,
      "end": 389.73,
      "text": "B: Tak, jestem uczulony na penicylinę."
    },
    {
      "start": 389.78,
      "end": 393.19,
      "text": "C: Nie przepadam za penicyliną."
    },
    {
      "start": 398.89,
      "end": 401.38,
      "text": "B! Jest się uczulonym „gegen“ coś. A jeśli nie masz alergii: „Nein, ich habe keine Allergien.“"
    },
    {
      "start": 401.43,
      "end": 406.61,
      "text": "(Nie, nie mam alergii.)"
    },
    {
      "start": 406.86,
      "end": 409.96,
      "text": "Tak, jestem uczulony na penicylinę."
    },
    {
      "start": 410.06,
      "end": 413.7,
      "text": "Dobrze, że pan/pani to mówi. W takim razie dostanie pan/pani coś innego."
    },
    {
      "start": 413.81,
      "end": 415.21,
      "text": "Powtórz!"
    },
    {
      "start": 415.26,
      "end": 418.31,
      "text": "Jestem uczulony na penicylinę."
    },
    {
      "start": 422.17,
      "end": 424.51,
      "text": "Nie mam alergii."
    },
    {
      "start": 428.06,
      "end": 432.1,
      "text": "Jutro nie możesz pracować. Lekarz pyta:"
    },
    {
      "start": 432.2,
      "end": 434.41,
      "text": "Potrzebuje pan/pani zwolnienia lekarskiego?"
    },
    {
      "start": 434.51,
      "end": 435.73,
      "text": "Co mówisz?"
    },
    {
      "start": 435.78,
      "end": 438.8,
      "text": "A: Nie, piszę sam."
    },
    {
      "start": 438.85,
      "end": 442.03,
      "text": "B: Tak, piszę chory."
    },
    {
      "start": 442.08,
      "end": 445.8,
      "text": "C: Tak, poproszę. Dla mojego pracodawcy."
    },
    {
      "start": 451.5,
      "end": 456.5,
      "text": "C! „Krankschreibung“ (zwolnienie lekarskie) pokazuje, że jesteś chory i nie możesz pracować."
    },
    {
      "start": 456.55,
      "end": 463.95,
      "text": "Ważne: mimo to sam poinformuj pracodawcę – najlepiej pierwszego dnia, wcześnie rano."
    },
    {
      "start": 464.2,
      "end": 467.04,
      "text": "Tak, poproszę. Dla mojego pracodawcy."
    },
    {
      "start": 467.14,
      "end": 469.5,
      "text": "Daję panu/pani zwolnienie do piątku."
    },
    {
      "start": 469.6,
      "end": 471.01,
      "text": "Powtórz!"
    },
    {
      "start": 471.06,
      "end": 473.82,
      "text": "Potrzebuję zwolnienia lekarskiego."
    },
    {
      "start": 477.85,
      "end": 483.25,
      "text": "Wypiszę panu/pani receptę. Proszę brać tabletki trzy razy dziennie po jedzeniu."
    },
    {
      "start": 483.35,
      "end": 486.68,
      "text": "Słuchaj uważnie! Kiedy bierzesz tabletki?"
    },
    {
      "start": 486.78,
      "end": 490.27,
      "text": "A: Raz dziennie, przed snem."
    },
    {
      "start": 490.32,
      "end": 494.77,
      "text": "B: Rano, w południe i wieczorem – po jedzeniu."
    },
    {
      "start": 494.82,
      "end": 498.39,
      "text": "C: Trzy razy dziennie – przed jedzeniem."
    },
    {
      "start": 504.09,
      "end": 509.39,
      "text": "B! „Dreimal täglich“ to trzy razy dziennie. A „nach dem Essen“"
    },
    {
      "start": 509.44,
      "end": 512.93,
      "text": "– czyli najpierw jedzenie, potem tabletka."
    },
    {
      "start": 513.18,
      "end": 515.47,
      "text": "Dziękuję bardzo. Do widzenia!"
    },
    {
      "start": 515.57,
      "end": 517.05,
      "text": "Szybkiego powrotu do zdrowia!"
    },
    {
      "start": 517.15,
      "end": 523.2,
      "text": "„Gute Besserung“ – tak mówi się do chorych. Znaczy: szybko wracaj do zdrowia!"
    },
    {
      "start": 523.3,
      "end": 524.71,
      "text": "Powtórz!"
    },
    {
      "start": 524.76,
      "end": 527.8,
      "text": "Trzy razy dziennie po jedzeniu."
    },
    {
      "start": 531.66,
      "end": 533.48,
      "text": "Szybkiego powrotu do zdrowia!"
    },
    {
      "start": 536.43,
      "end": 540.02,
      "text": "A jeśli przychodnia jest zamknięta? Zapamiętaj dwa numery."
    },
    {
      "start": 540.07,
      "end": 549.69,
      "text": "116 117: dyżurna pomoc lekarska – gdy potrzebujesz lekarza w nocy lub w weekend, ale to nie jest nagły wypadek."
    },
    {
      "start": 549.94,
      "end": 558.63,
      "text": "I 112: numer alarmowy – do karetki i straży pożarnej, na przykład po wypadku albo przy silnej duszności."
    },
    {
      "start": 558.98,
      "end": 563.99,
      "text": "Na kursie uczysz się ładnych zdań. Ale co Niemcy mówią naprawdę?"
    },
    {
      "start": 564.24,
      "end": 566.37,
      "text": "Boli mnie gardło."
    },
    {
      "start": 566.57,
      "end": 568.62,
      "text": "Drapie mnie w gardle."
    },
    {
      "start": 569.27,
      "end": 571.01,
      "text": "Jestem chory."
    },
    {
      "start": 571.21,
      "end": 573.02,
      "text": "Dopadło mnie."
    },
    {
      "start": 573.67,
      "end": 575.73,
      "text": "Zaraziłem się."
    },
    {
      "start": 575.93,
      "end": 578.14,
      "text": "Coś złapałem."
    },
    {
      "start": 578.79,
      "end": 581.54,
      "text": "Jestem bardzo zmęczony i słaby."
    },
    {
      "start": 581.75,
      "end": 583.95,
      "text": "Jestem kompletnie wykończony."
    },
    {
      "start": 584.6,
      "end": 586.81,
      "text": "Boli mnie kręgosłup."
    },
    {
      "start": 587.01,
      "end": 588.75,
      "text": "Coś mi strzyknęło w plecach."
    },
    {
      "start": 589.4,
      "end": 592.42,
      "text": "Brrr, jestem taki zimny!"
    },
    {
      "start": 592.57,
      "end": 598.54,
      "text": "Leo … przecież nie jesteś zimnym człowiekiem. Masz na myśli: „Mir ist kalt.“ (Jest mi zimno.)"
    },
    {
      "start": 598.99,
      "end": 603.9,
      "text": "I uwaga: „Mir ist schlecht“ nie znaczy „Źle się czuję“"
    },
    {
      "start": 603.95,
      "end": 607.52,
      "text": "ogólnie. Znaczy: mam mdłości, może zwymiotuję."
    },
    {
      "start": 607.97,
      "end": 613.19,
      "text": "Grypa czy przeziębienie? Katar i kaszel to zwykle przeziębienie („Erkältung“)."
    },
    {
      "start": 613.24,
      "end": 618.18,
      "text": "Grypa („Grippe“) jest dużo gorsza: wysoka gorączka, leżysz w łóżku."
    },
    {
      "start": 618.63,
      "end": 624.13,
      "text": "A teraz wszystko jeszcze raz. Dziesięć najważniejszych zdań. Powtórz!"
    },
    {
      "start": 624.18,
      "end": 627.22,
      "text": "Chciałbym się umówić na wizytę."
    },
    {
      "start": 631.09,
      "end": 633.22,
      "text": "Oto moja karta."
    },
    {
      "start": 636.03,
      "end": 639.39,
      "text": "Czy może pani powiedzieć to wolniej?"
    },
    {
      "start": 643.61,
      "end": 647.28,
      "text": "Boli mnie głowa i mam gorączkę."
    },
    {
      "start": 651.87,
      "end": 654.52,
      "text": "Boli mnie brzuch."
    },
    {
      "start": 657.94,
      "end": 659.96,
      "text": "Od trzech dni."
    },
    {
      "start": 662.66,
      "end": 665.81,
      "text": "Jestem uczulony na penicylinę."
    },
    {
      "start": 669.79,
      "end": 672.55,
      "text": "Potrzebuję zwolnienia lekarskiego."
    },
    {
      "start": 676.08,
      "end": 679.23,
      "text": "Trzy razy dziennie po jedzeniu."
    },
    {
      "start": 683.22,
      "end": 685.03,
      "text": "Szybkiego powrotu do zdrowia!"
    },
    {
      "start": 687.49,
      "end": 692.25,
      "text": "Która sytuacja była dla ciebie najtrudniejsza? Napisz w komentarzach!"
    },
    {
      "start": 692.36,
      "end": 696.24,
      "text": "Następnym razem idziemy do urzędu. Tam naprawdę potrzebuję pomocy."
    },
    {
      "start": 696.34,
      "end": 698.62,
      "text": "Do zobaczenia w LilyLingua!"
    }
  ]
}
