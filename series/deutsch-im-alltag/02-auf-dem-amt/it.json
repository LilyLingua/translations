    {
      "start": 560.52,
      "end": 562.08,
      "text": "Di cosa hai bisogno?"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "Per favore, tieni pronti i tuoi documenti."
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "Per favore, tieni i tuoi fogli in mano."
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "Compila il modulo completamente."
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "Scrivi qualcosa ovunque."
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "L’elaborazione dura circa due settimane."
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "Ci vogliono circa due settimane."
