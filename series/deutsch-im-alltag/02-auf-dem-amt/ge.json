  "subtitles": [
    {
      "start": 0.4,
      "end": 3.97,
      "text": "გადავედი! ახალი ბინა, ახალი ქალაქი…"
    },
    {
      "start": 4.07,
      "end": 7.56,
      "text": "სუპერ! და – უკვე დარეგისტრირდი?"
    },
    {
      "start": 7.66,
      "end": 11.22,
      "text": "დარეგისტრირდი? სად? ფიტნეს კლუბში?"
    },
    {
      "start": 11.32,
      "end": 20,
      "text": "არა, ლეო. სამსახურში! დღეს შენ გაივლი მთელ Bürgeramt-ში შეხვედრას – შესვლიდან დამადასტურებელ ცნებამდე."
    },
    {
      "start": 20.05,
      "end": 24.32,
      "text": "და ყველა სიტუაციაში გკითხავთ: რას იტყვი?"
    },
    {
      "start": 24.42,
      "end": 26.79,
      "text": "და მხოლოდ ხუთი წამი გაქვს!"
    },
    {
      "start": 30.09,
      "end": 34.39,
      "text": "მოსული ხარ Bürgeramt-ში. საინფორმაციო მაგიდასთან კაცი ზის."
    },
    {
      "start": 34.49,
      "end": 37.24,
      "text": "დილა მშვიდობისა. რა საქმე გაქვს?"
    },
    {
      "start": 37.34,
      "end": 38.57,
      "text": "რას იტყვი?"
    },
    {
      "start": 38.62,
      "end": 42.18,
      "text": "A: დილა მშვიდობისა. მინდა დავრეგისტრირდე."
    },
    {
      "start": 42.23,
      "end": 44.91,
      "text": "B: მე ვარ საქმე."
    },
    {
      "start": 44.96,
      "end": 47.41,
      "text": "C: მინდა სამსახური."
    },
    {
      "start": 53.11,
      "end": 57.71,
      "text": "A! „Anliegen“ ნიშნავს: რატომ ხარ აქ? რა გჭირდება?"
    },
    {
      "start": 57.76,
      "end": 61.32,
      "text": "სამსახურში ამ სიტყვას ხშირად გაიგებ."
    },
    {
      "start": 61.57,
      "end": 64.52,
      "text": "დილა მშვიდობისა. მინდა დავრეგისტრირდე."
    },
    {
      "start": 64.61,
      "end": 66.51,
      "text": "შეხვედრა გაქვს?"
    },
    {
      "start": 66.61,
      "end": 68.51,
      "text": "დიახ, ცხრა საათზე."
    },
    {
      "start": 68.61,
      "end": 70.01,
      "text": "გამიმეორე!"
    },
    {
      "start": 70.06,
      "end": 72.3,
      "text": "მინდა დავრეგისტრირდე."
    },
    {
      "start": 75.23,
      "end": 78.28,
      "text": "შეხვედრა მაქვს ცხრა საათზე."
    },
    {
      "start": 82.64,
      "end": 86.86,
      "text": "კარგი. მაშინ აიღე ნომერი და იქ დაელოდე."
    },
    {
      "start": 86.96,
      "end": 88.7,
      "text": "ახლა რას აკეთებ?"
    },
    {
      "start": 88.8,
      "end": 91.09,
      "text": "A: ბინას იცვლი."
    },
    {
      "start": 91.14,
      "end": 94.23,
      "text": "B: თმას ქაჩავ."
    },
    {
      "start": 94.28,
      "end": 98.74,
      "text": "C: ავტომატიდან ნომრიანი ფურცელი იღებ."
    },
    {
      "start": 103.94,
      "end": 108.24,
      "text": "ანუ ა! ბინას ვიცვლი. მეც ახლახანს გადავედი…"
    },
    {
      "start": 108.89,
      "end": 115.64,
      "text": "არა, ლეო. ც! „Eine Nummer ziehen“ ნიშნავს: იღებ ფურცელს შენი რიგის ნომრით."
    },
    {
      "start": 115.69,
      "end": 121.65,
      "text": "„Umziehen“ სულ სხვა რამეა – ეს ნიშნავს: ახალ ბინაში გადასვლას."
    },
    {
      "start": 121.9,
      "end": 123.31,
      "text": "გამიმეორე!"
    },
    {
      "start": 123.36,
      "end": 125.7,
      "text": "ნომერს ვიღებ."
    },
    {
      "start": 129.25,
      "end": 134.26,
      "text": "ელოდები. უცებ განცხადებას ისმენ. ყურადღებით მოუსმინე!"
    },
    {
      "start": 134.36,
      "end": 138.6,
      "text": "ნომერი 147, გთხოვთ, მიდით 12-ე მაგიდასთან."
    },
    {
      "start": 138.7,
      "end": 143.24,
      "text": "შენი ნომერია 147. სად მიდიხარ?"
    },
    {
      "start": 143.34,
      "end": 146.83,
      "text": "A: 147-ე მაგიდასთან."
    },
    {
      "start": 146.88,
      "end": 149.4,
      "text": "B: 12-ე მაგიდასთან."
    },
    {
      "start": 149.45,
      "end": 152.13,
      "text": "C: 14-ე ოთახში."
    },
    {
      "start": 157.83,
      "end": 160.75,
      "text": "B! ჯერ მოდის შენი ნომერი, მერე მაგიდა."
    },
    {
      "start": 160.8,
      "end": 164.61,
      "text": "ბევრ სამსახურში ეს ეკრანზეც წერია."
    },
    {
      "start": 164.86,
      "end": 166.26,
      "text": "გამიმეორე!"
    },
    {
      "start": 166.31,
      "end": 170.61,
      "text": "147 – 12-ე მაგიდა"
    },
    {
      "start": 176.42,
      "end": 180.3,
      "text": "მიდიხარ 12-ე მაგიდასთან. იქ ქალი ზის."
    },
    {
      "start": 180.4,
      "end": 184.28,
      "text": "დილა მშვიდობისა. დაჯექი, გთხოვ. რით შემიძლია დაგეხმარო?"
    },
    {
      "start": 184.38,
      "end": 185.6,
      "text": "რას იტყვი?"
    },
    {
      "start": 185.65,
      "end": 188.49,
      "text": "A: მინდა თქვენ დაგარეგისტრიროთ."
    },
    {
      "start": 188.54,
      "end": 192.11,
      "text": "B: მინდა ჩემი ახალი ბინა დავარეგისტრირო."
    },
    {
      "start": 192.16,
      "end": 195.41,
      "text": "C: ახლა აქ ვცხოვრობ. ნახვამდის!"
    },
    {
      "start": 201.11,
      "end": 206.75,
      "text": "B! ბინას არეგისტრირებ – ან საკუთარ თავს: „Ich möchte mich anmelden.“"
    },
    {
      "start": 206.8,
      "end": 210.84,
      "text": "მაგრამ არა „Sie“ – ქალბატონი კრუგერი უკვე დარეგისტრირებულია."
    },
    {
      "start": 211.09,
      "end": 213.69,
      "text": "მინდა ჩემი ახალი ბინა დავარეგისტრირო."
    },
    {
      "start": 213.79,
      "end": 216.55,
      "text": "სიხარულით. როდის გადმოხვედი?"
    },
    {
      "start": 216.65,
      "end": 218.47,
      "text": "პირველ ოქტომბერს."
    },
    {
      "start": 218.57,
      "end": 219.97,
      "text": "გამიმეორე!"
    },
    {
      "start": 220.03,
      "end": 223.38,
      "text": "მინდა ჩემი ახალი ბინა დავარეგისტრირო."
    },
    {
      "start": 227.61,
      "end": 231.07,
      "text": "პირველ ოქტომბერს გადმოვედი."
    },
    {
      "start": 235.92,
      "end": 238.67,
      "text": "ბინის მფლობელის დამადასტურებელი გაქვს თან?"
    },
    {
      "start": 238.77,
      "end": 242.34,
      "text": "ოჰ, გრძელი სიტყვაა! რას იტყვი?"
    },
    {
      "start": 242.44,
      "end": 245.77,
      "text": "A: არა, ბინას არ ვაძლევ."
    },
    {
      "start": 245.82,
      "end": 249.31,
      "text": "B: დიახ, ჩემს ბინას მოგცემ."
    },
    {
      "start": 249.36,
      "end": 253.58,
      "text": "C: დიახ, აი ჩემი მფლობელის დამადასტურებელი."
    },
    {
      "start": 259.28,
      "end": 267.17,
      "text": "C! Wohnungsgeberbestätigung არის ფორმა შენი მფლობელისგან. ამაზე წერია: მართლა ამ ბინაში ცხოვრობ."
    },
    {
      "start": 267.22,
      "end": 270.92,
      "text": "ამ ქაღალდის გარეშე რეგისტრაცია თითქმის შეუძლებელია."
    },
    {
      "start": 271.17,
      "end": 274.51,
      "text": "დიახ, აი ჩემი მფლობელის დამადასტურებელი."
    },
    {
      "start": 274.61,
      "end": 276.01,
      "text": "გამიმეორე!"
    },
    {
      "start": 276.06,
      "end": 279.52,
      "text": "აი ჩემი მფლობელის დამადასტურებელი."
    },
    {
      "start": 284.37,
      "end": 287.31,
      "text": "და შენი პირადობა ან პასპორტი, გთხოვ."
    },
    {
      "start": 287.41,
      "end": 288.63,
      "text": "რას იტყვი?"
    },
    {
      "start": 288.68,
      "end": 291.36,
      "text": "A: აი ჩემი პასპორტი."
    },
    {
      "start": 291.41,
      "end": 294.17,
      "text": "B: აი არიან ჩემი პასპორტი."
    },
    {
      "start": 294.22,
      "end": 296.98,
      "text": "C: მე ვარ პასპორტი."
    },
    {
      "start": 302.68,
      "end": 305.5,
      "text": "A! ერთი პასპორტი – ანუ „არის“, არა „არიან“."
    },
    {
      "start": 305.55,
      "end": 310.94,
      "text": "პასპორტი ან პირადობა სამსახურში თითქმის ყოველთვის გჭირდება."
    },
    {
      "start": 310.99,
      "end": 318.08,
      "text": "თუ დაგავიწყდა, გულწრფელად თქვი: „ბოდიში, სამწუხაროდ დამავიწყდა.“"
    },
    {
      "start": 318.33,
      "end": 320.14,
      "text": "აი ჩემი პასპორტი."
    },
    {
      "start": 320.25,
      "end": 321.65,
      "text": "გამიმეორე!"
    },
    {
      "start": 321.7,
      "end": 323.94,
      "text": "აი ჩემი პასპორტი."
    },
    {
      "start": 326.87,
      "end": 330.65,
      "text": "ბოდიში, სამწუხაროდ დამავიწყდა."
    },
    {
      "start": 335.85,
      "end": 338.14,
      "text": "როგორ იწერება შენი გვარი?"
    },
    {
      "start": 338.24,
      "end": 341.34,
      "text": "შენი გვარია Nowak. რას იტყვი?"
    },
    {
      "start": 341.44,
      "end": 344.12,
      "text": "A: კალმით."
    },
    {
      "start": 344.17,
      "end": 349.33,
      "text": "B: ვასახელებ ასოებით: N – O – W – A – K."
    },
    {
      "start": 349.38,
      "end": 352.4,
      "text": "C: ძალიან ლამაზად იწერება."
    },
    {
      "start": 358.1,
      "end": 365.79,
      "text": "B! „Wie schreibt man …?“ ნიშნავს: რომელი ასოებით? მერე ასო-ასო ამბობ."
    },
    {
      "start": 365.84,
      "end": 370.31,
      "text": "ივარჯიშე შენი სახელის ასოებით თქმა გერმანულად – ყველგან დაგჭირდება!"
    },
    {
      "start": 370.56,
      "end": 373.58,
      "text": "N – O – W – A – K."
    },
    {
      "start": 373.68,
      "end": 374.88,
      "text": "გმადლობთ."
    },
    {
      "start": 374.94,
      "end": 376.35,
      "text": "გამიმეორე!"
    },
    {
      "start": 376.4,
      "end": 382.11,
      "text": "ვასახელებ ასოებით: N – O – W – A – K."
    },
    {
      "start": 389.54,
      "end": 391.36,
      "text": "დაქორწინებული ხარ?"
    },
    {
      "start": 391.45,
      "end": 394.71,
      "text": "დაქორწინებული არ ხარ. რას იტყვი?"
    },
    {
      "start": 394.81,
      "end": 397.83,
      "text": "A: არა, არ ვარ დაქორწინებული."
    },
    {
      "start": 397.88,
      "end": 400.98,
      "text": "B: არა, სამწუხაროდ ვარ."
    },
    {
      "start": 401.02,
      "end": 404.12,
      "text": "C: არა, ვარ დაქორწინებული."
    },
    {
      "start": 409.82,
      "end": 419.92,
      "text": "A! „Ledig“ ნიშნავს: არ ხარ დაქორწინებული. ფრთხილად: „leider“ ჟღერს მსგავსად, მაგრამ სულ სხვა რამეს ნიშნავს – „leider“"
    },
    {
      "start": 419.97,
      "end": 421.31,
      "text": "არის: სამწუხაროდ."
    },
    {
      "start": 421.56,
      "end": 423.69,
      "text": "არა, არ ვარ დაქორწინებული."
    },
    {
      "start": 423.79,
      "end": 425.19,
      "text": "გამიმეორე!"
    },
    {
      "start": 425.24,
      "end": 427.16,
      "text": "არ ვარ დაქორწინებული."
    },
    {
      "start": 429.74,
      "end": 431.87,
      "text": "დაქორწინებული ვარ."
    },
    {
      "start": 435.18,
      "end": 440.11,
      "text": "გთხოვ, გადაამოწმე მონაცემები. თუ ყველაფერი სწორია, აქ მოაწერე ხელი."
    },
    {
      "start": 440.21,
      "end": 441.43,
      "text": "რას იტყვი?"
    },
    {
      "start": 441.48,
      "end": 444.5,
      "text": "A: მაგიდის ქვეშ მოვაწერ ხელს."
    },
    {
      "start": 444.55,
      "end": 447.56,
      "text": "B: ხელის მოწერა არ მიყვარს."
    },
    {
      "start": 447.62,
      "end": 451.57,
      "text": "C: ყველაფერი სწორია. ზუსტად სად მოვაწერო ხელი?"
    },
    {
      "start": 457.27,
      "end": 463.38,
      "text": "C! „Unterschreiben“ ნიშნავს: ხელით აწერ შენს სახელს – შენი ხელმოწერაა."
    },
    {
      "start": 463.43,
      "end": 467.71,
      "text": "და კარგი რჩევა: ყოველთვის წაიკითხე, რა წერია ფორმაზე."
    },
    {
      "start": 467.96,
      "end": 471.06,
      "text": "ყველაფერი სწორია. ზუსტად სად მოვაწერო ხელი?"
    },
    {
      "start": 471.16,
      "end": 473.06,
      "text": "აქ ქვემოთ, გთხოვ."
    },
    {
      "start": 473.16,
      "end": 474.56,
      "text": "გამიმეორე!"
    },
    {
      "start": 474.61,
      "end": 476.74,
      "text": "სად მოვაწერო ხელი?"
    },
    {
      "start": 480.06,
      "end": 483.7,
      "text": "მორჩა. აი შენი რეგისტრაციის ცნობა."
    },
    {
      "start": 483.8,
      "end": 486.48,
      "text": "მზად ხარ! რას იტყვი?"
    },
    {
      "start": 486.58,
      "end": 489.34,
      "text": "A: გმადლობთ, დაგიკავშირდებით."
    },
    {
      "start": 489.39,
      "end": 493.19,
      "text": "B: დიდი მადლობა! კიდევ რამე მჭირდება?"
    },
    {
      "start": 493.24,
      "end": 495.76,
      "text": "C: არაფერი მაკლია!"
    },
    {
      "start": 501.46,
      "end": 509.79,
      "text": "B! და ფრთხილად ა-ზე: „Ich melde mich“ არ ნიშნავს „ვირეგისტრირები“, არამედ: მერე დაგირეკავ."
    },
    {
      "start": 509.84,
      "end": 514.72,
      "text": "და ც შეიძლება გახსოვს – ეს მხოლოდ ექიმთან ჯდება!"
    },
    {
      "start": 514.97,
      "end": 518.07,
      "text": "დიდი მადლობა! კიდევ რამე მჭირდება?"
    },
    {
      "start": 518.17,
      "end": 522.55,
      "text": "არა, ეს ყველაფერი იყო. კარგად შეინახე ცნობა."
    },
    {
      "start": 522.65,
      "end": 524.05,
      "text": "გამიმეორე!"
    },
    {
      "start": 524.1,
      "end": 526.76,
      "text": "კიდევ რამე მჭირდება?"
    },
    {
      "start": 530.67,
      "end": 537.19,
      "text": "სამი რჩევა რეგისტრაციისთვის. პირველი: გადმოსვლიდან ორი კვირის განმავლობაში დარეგისტრირდი."
    },
    {
      "start": 537.44,
      "end": 543.41,
      "text": "მეორე: ბევრ ქალაქში შეხვედრა გჭირდება – ხშირად ონლაინაც შეგიძლია დაჯავშნო."
    },
    {
      "start": 543.66,
      "end": 549.73,
      "text": "და მესამე: რეგისტრაციის ცნობა ხშირად ისევ დაგჭირდება, მაგალითად ბანკისთვის."
    },
    {
      "start": 549.78,
      "end": 551.23,
      "text": "ასე რომ, კარგად შეინახე!"
    },
    {
      "start": 551.58,
      "end": 558.25,
      "text": "სამსახურში გერმანული ზოგჯერ ძალიან რთულად ჟღერს. ლეო ხმამაღლა კითხულობს – მე კი მარტივად ვამბობ."
    },
    {
      "start": 558.5,
      "end": 560.32,
      "text": "რა საქმე გაქვს?"
    },
    {
      "start": 560.52,
      "end": 562.08,
      "text": "რა გჭირდება?"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "გთხოვ, მზად გქონდეს დოკუმენტები."
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "გთხოვ, ქაღალდები ხელში გეჭიროს."
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "შეავსე ფორმა სრულად."
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "ყველგან რაღაც დაწერე."
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "დამუშავებას დაახლოებით ორი კვირა სჭირდება."
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "ეს დაახლოებით ორი კვირა გაგრძელდება."
    },
    {
      "start": 581.69,
      "end": 584.13,
      "text": "დოკუმენტები მოგვიანებით წარმოადგინე."
    },
    {
      "start": 584.34,
      "end": 587.17,
      "text": "ქაღალდები მერე მოიტანე."
    },
    {
      "start": 587.82,
      "end": 589.79,
      "text": "დღეს ტანსაცმელს ვიცვლი!"
    },
    {
      "start": 589.95,
      "end": 597.9,
      "text": "აა, სხვა ტანსაცმელს იცვამ? თუ გულისხმობ: „Ich ziehe um“ – ანუ ახალ ბინაში გადადიხარ?"
    },
    {
      "start": 598.35,
      "end": 603.18,
      "text": "და სამსახურში: არა „Ich bin leider“, არამედ „Ich bin ledig“"
    },
    {
      "start": 603.23,
      "end": 605.99,
      "text": "(არ ვარ დაქორწინებული) – თუ არ ხარ დაქორწინებული."
    },
    {
      "start": 606.44,
      "end": 613.77,
      "text": "და „Ich melde mich“ ნიშნავს: მერე დაგირეკავ. სამსახურში უნდა თქვა: „Ich melde mich an.“ (ვირეგისტრირები.)"
    },
    {
      "start": 614.22,
      "end": 619.88,
      "text": "ახლა ყველაფერი კიდევ ერთხელ. ათი ყველაზე მნიშვნელოვანი წინადადება. გამიმეორე!"
    },
    {
      "start": 619.93,
      "end": 622.17,
      "text": "მინდა დავრეგისტრირდე."
    },
    {
      "start": 625.1,
      "end": 628.25,
      "text": "შეხვედრა მაქვს ცხრა საათზე."
    },
    {
      "start": 632.23,
      "end": 634.47,
      "text": "ნომერს ვიღებ."
    },
    {
      "start": 637.4,
      "end": 640.55,
      "text": "მინდა ჩემი ახალი ბინა დავარეგისტრირო."
    },
    {
      "start": 644.54,
      "end": 648,
      "text": "აი ჩემი მფლობელის დამადასტურებელი."
    },
    {
      "start": 652.34,
      "end": 654.79,
      "text": "აი ჩემი პასპორტი."
    },
    {
      "start": 657.96,
      "end": 660.9,
      "text": "ჩემს სახელს ასოებით ვამბობ."
    },
    {
      "start": 664.65,
      "end": 666.57,
      "text": "არ ვარ დაქორწინებული."
    },
    {
      "start": 669.14,
      "end": 671.27,
      "text": "სად მოვაწერო ხელი?"
    },
    {
      "start": 674.08,
      "end": 676.74,
      "text": "კიდევ რამე მჭირდება?"
    },
    {
      "start": 680.15,
      "end": 684.61,
      "text": "რომელი სიტყვა იყო შენთვის ყველაზე რთული? დაწერე კომენტარებში!"
    },
    {
      "start": 684.71,
      "end": 687.65,
      "text": "ნახვამდის და მალე შევხვდებით LilyLingua-ზე!"
    }
  ]
}
