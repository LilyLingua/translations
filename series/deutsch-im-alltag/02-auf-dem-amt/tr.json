  "subtitles": [
    {
      "start": 0.4,
      "end": 3.97,
      "text": "Taşındım! Yeni ev, yeni şehir…"
    },
    {
      "start": 4.07,
      "end": 7.56,
      "text": "Süper! Peki – adres kaydını yaptırdın mı?"
    },
    {
      "start": 7.66,
      "end": 11.22,
      "text": "Kayıt mı? Nerede? Spor salonunda mı?"
    },
    {
      "start": 11.32,
      "end": 20,
      "text": "Hayır Leo. Resmi dairede! Bugün „Bürgeramt“ta baştan sona bir randevu yaşayacaksın – girişten ikamet belgesine kadar."
    },
    {
      "start": 20.05,
      "end": 24.32,
      "text": "Ve her durumda sana soruyoruz: Ne dersin?"
    },
    {
      "start": 24.42,
      "end": 26.79,
      "text": "Ve sadece beş saniyen var!"
    },
    {
      "start": 30.09,
      "end": 34.39,
      "text": "Bürgeramt'a geliyorsun. Danışma masasında bir adam oturuyor."
    },
    {
      "start": 34.49,
      "end": 37.24,
      "text": "Günaydın. Ne için gelmiştiniz?"
    },
    {
      "start": 37.34,
      "end": 38.57,
      "text": "Ne dersin?"
    },
    {
      "start": 38.62,
      "end": 42.18,
      "text": "A: Günaydın. Adres kaydı yaptırmak istiyorum."
    },
    {
      "start": 42.23,
      "end": 44.91,
      "text": "B: Ben bir işlemim."
    },
    {
      "start": 44.96,
      "end": 47.41,
      "text": "C: Bir daire istiyorum."
    },
    {
      "start": 53.11,
      "end": 57.71,
      "text": "A! „Anliegen“ şu demek: Neden buradasınız? Neye ihtiyacınız var?"
    },
    {
      "start": 57.76,
      "end": 61.32,
      "text": "Resmi dairelerde bu kelimeyi çok sık duyarsın."
    },
    {
      "start": 61.57,
      "end": 64.52,
      "text": "Günaydın. Adres kaydı yaptırmak istiyorum."
    },
    {
      "start": 64.61,
      "end": 66.51,
      "text": "Randevunuz var mı?"
    },
    {
      "start": 66.61,
      "end": 68.51,
      "text": "Evet, saat dokuzda."
    },
    {
      "start": 68.61,
      "end": 70.01,
      "text": "Tekrar et!"
    },
    {
      "start": 70.06,
      "end": 72.3,
      "text": "Adres kaydı yaptırmak istiyorum."
    },
    {
      "start": 75.23,
      "end": 78.28,
      "text": "Saat dokuzda randevum var."
    },
    {
      "start": 82.64,
      "end": 86.86,
      "text": "Tamam. O zaman lütfen bir numara alın ve orada bekleyin."
    },
    {
      "start": 86.96,
      "end": 88.7,
      "text": "Şimdi ne yaparsın?"
    },
    {
      "start": 88.8,
      "end": 91.09,
      "text": "A: Taşınırsın."
    },
    {
      "start": 91.14,
      "end": 94.23,
      "text": "B: Birinin saçını çekersin."
    },
    {
      "start": 94.28,
      "end": 98.74,
      "text": "C: Makineden numaralı bir kâğıt alırsın."
    },
    {
      "start": 103.94,
      "end": 108.24,
      "text": "O zaman A! Taşınıyorum. Zaten yeni taşındım…"
    },
    {
      "start": 108.89,
      "end": 115.64,
      "text": "Hayır Leo. C! „Eine Nummer ziehen“ şu demek: Sıra numaralı bir kâğıt alırsın."
    },
    {
      "start": 115.69,
      "end": 121.65,
      "text": "„Umziehen“ bambaşka bir şey – yeni bir eve taşınmak demek."
    },
    {
      "start": 121.9,
      "end": 123.31,
      "text": "Tekrar et!"
    },
    {
      "start": 123.36,
      "end": 125.7,
      "text": "Bir numara alıyorum."
    },
    {
      "start": 129.25,
      "end": 134.26,
      "text": "Bekliyorsun. Birden bir anons duyuyorsun. İyi dinle!"
    },
    {
      "start": 134.36,
      "end": 138.6,
      "text": "147 numara, lütfen 12 numaralı masaya."
    },
    {
      "start": 138.7,
      "end": 143.24,
      "text": "Senin numaran 147. Nereye gidersin?"
    },
    {
      "start": 143.34,
      "end": 146.83,
      "text": "A: 147 numaralı masaya."
    },
    {
      "start": 146.88,
      "end": 149.4,
      "text": "B: 12 numaralı masaya."
    },
    {
      "start": 149.45,
      "end": 152.13,
      "text": "C: 14 numaralı odaya."
    },
    {
      "start": 157.83,
      "end": 160.75,
      "text": "B! Önce senin numaran, sonra masa gelir."
    },
    {
      "start": 160.8,
      "end": 164.61,
      "text": "Birçok dairede bu bir ekranda da yazar."
    },
    {
      "start": 164.86,
      "end": 166.26,
      "text": "Tekrar et!"
    },
    {
      "start": 166.31,
      "end": 170.61,
      "text": "147 – 12 numaralı masa"
    },
    {
      "start": 176.42,
      "end": 180.3,
      "text": "12 numaralı masaya gidiyorsun. Orada bir kadın oturuyor."
    },
    {
      "start": 180.4,
      "end": 184.28,
      "text": "Günaydın. Buyurun oturun. Size nasıl yardımcı olabilirim?"
    },
    {
      "start": 184.38,
      "end": 185.6,
      "text": "Ne dersin?"
    },
    {
      "start": 185.65,
      "end": 188.49,
      "text": "A: Sizi kaydettirmek istiyorum."
    },
    {
      "start": 188.54,
      "end": 192.11,
      "text": "B: Yeni evimin kaydını yaptırmak istiyorum."
    },
    {
      "start": 192.16,
      "end": 195.41,
      "text": "C: Artık burada oturuyorum. Hoşça kalın!"
    },
    {
      "start": 201.11,
      "end": 206.75,
      "text": "B! Evinin kaydını yaptırırsın – ya da kendini: „Ich möchte mich anmelden.“"
    },
    {
      "start": 206.8,
      "end": 210.84,
      "text": "Ama „Sie“ (sizi) değil – Bayan Krüger zaten kayıtlı."
    },
    {
      "start": 211.09,
      "end": 213.69,
      "text": "Yeni evimin kaydını yaptırmak istiyorum."
    },
    {
      "start": 213.79,
      "end": 216.55,
      "text": "Tabii. Ne zaman taşındınız?"
    },
    {
      "start": 216.65,
      "end": 218.47,
      "text": "Bir Ekim'de."
    },
    {
      "start": 218.57,
      "end": 219.97,
      "text": "Tekrar et!"
    },
    {
      "start": 220.03,
      "end": 223.38,
      "text": "Yeni evimin kaydını yaptırmak istiyorum."
    },
    {
      "start": 227.61,
      "end": 231.07,
      "text": "Bir Ekim'de taşındım."
    },
    {
      "start": 235.92,
      "end": 238.67,
      "text": "Ev sahibi onay belgesi yanınızda mı?"
    },
    {
      "start": 238.77,
      "end": 242.34,
      "text": "Ooo, ne uzun kelime! Ne dersin?"
    },
    {
      "start": 242.44,
      "end": 245.77,
      "text": "A: Hayır, ben ev vermiyorum."
    },
    {
      "start": 245.82,
      "end": 249.31,
      "text": "B: Evet, size evimi veriyorum."
    },
    {
      "start": 249.36,
      "end": 253.58,
      "text": "C: Evet, işte ev sahibimden aldığım onay belgesi."
    },
    {
      "start": 259.28,
      "end": 267.17,
      "text": "C! „Wohnungsgeberbestätigung“ ev sahibinden alınan bir formdur. Bu evde gerçekten oturduğunu gösterir."
    },
    {
      "start": 267.22,
      "end": 270.92,
      "text": "Bu belge olmadan kayıt genellikle olmaz."
    },
    {
      "start": 271.17,
      "end": 274.51,
      "text": "Evet, işte ev sahibimden aldığım onay belgesi."
    },
    {
      "start": 274.61,
      "end": 276.01,
      "text": "Tekrar et!"
    },
    {
      "start": 276.06,
      "end": 279.52,
      "text": "İşte ev sahibimden aldığım onay belgesi."
    },
    {
      "start": 284.37,
      "end": 287.31,
      "text": "Ve kimliğiniz ya da pasaportunuz, lütfen."
    },
    {
      "start": 287.41,
      "end": 288.63,
      "text": "Ne dersin?"
    },
    {
      "start": 288.68,
      "end": 291.36,
      "text": "A: İşte pasaportum."
    },
    {
      "start": 291.41,
      "end": 294.17,
      "text": "B: İşte pasaportumlar."
    },
    {
      "start": 294.22,
      "end": 296.98,
      "text": "C: Ben pasaportum."
    },
    {
      "start": 302.68,
      "end": 305.5,
      "text": "A! Bir pasaport – yani „ist“, „sind“ değil. Resmi dairede neredeyse her zaman pasaport ya da kimlik kartı gerekir."
    },
    {
      "start": 305.55,
      "end": 310.94,
      "text": "Unuttuysan dürüstçe söyle: „Entschuldigung, den habe ich leider vergessen.“"
    },
    {
      "start": 310.99,
      "end": 318.08,
      "text": "(Özür dilerim, maalesef unuttum.)"
    },
    {
      "start": 318.33,
      "end": 320.14,
      "text": "İşte pasaportum."
    },
    {
      "start": 320.25,
      "end": 321.65,
      "text": "Tekrar et!"
    },
    {
      "start": 321.7,
      "end": 323.94,
      "text": "İşte pasaportum."
    },
    {
      "start": 326.87,
      "end": 330.65,
      "text": "Özür dilerim, maalesef unuttum."
    },
    {
      "start": 335.85,
      "end": 338.14,
      "text": "Soyadınız nasıl yazılıyor?"
    },
    {
      "start": 338.24,
      "end": 341.34,
      "text": "Adın Nowak. Ne dersin?"
    },
    {
      "start": 341.44,
      "end": 344.12,
      "text": "A: Tükenmez kalemle."
    },
    {
      "start": 344.17,
      "end": 349.33,
      "text": "B: Harf harf söylüyorum: N – O – W – A – K."
    },
    {
      "start": 349.38,
      "end": 352.4,
      "text": "C: Çok güzel yazılıyor."
    },
    {
      "start": 358.1,
      "end": 365.79,
      "text": "B! „Wie schreibt man …?“ şu demek: Hangi harfler? O zaman harf harf söylersin."
    },
    {
      "start": 365.84,
      "end": 370.31,
      "text": "Adını Almanca harflerle çalış – her yerde lazım olur!"
    },
    {
      "start": 370.56,
      "end": 373.58,
      "text": "N – O – W – A – K."
    },
    {
      "start": 373.68,
      "end": 374.88,
      "text": "Teşekkürler."
    },
    {
      "start": 374.94,
      "end": 376.35,
      "text": "Tekrar et!"
    },
    {
      "start": 376.4,
      "end": 382.11,
      "text": "Harf harf söylüyorum: N – O – W – A – K."
    },
    {
      "start": 389.54,
      "end": 391.36,
      "text": "Evli misiniz?"
    },
    {
      "start": 391.45,
      "end": 394.71,
      "text": "Evli değilsin. Ne dersin?"
    },
    {
      "start": 394.81,
      "end": 397.83,
      "text": "A: Hayır, bekârım."
    },
    {
      "start": 397.88,
      "end": 400.98,
      "text": "B: Hayır, ben maalesefim."
    },
    {
      "start": 401.02,
      "end": 404.12,
      "text": "C: Hayır, ben evlenmek."
    },
    {
      "start": 409.82,
      "end": 419.92,
      "text": "A! „Ledig“ evli değil demek. Dikkat: „leider“ benzer duyulur ama bambaşka bir anlamı var – „leider“"
    },
    {
      "start": 419.97,
      "end": 421.31,
      "text": "maalesef demek."
    },
    {
      "start": 421.56,
      "end": 423.69,
      "text": "Hayır, bekârım."
    },
    {
      "start": 423.79,
      "end": 425.19,
      "text": "Tekrar et!"
    },
    {
      "start": 425.24,
      "end": 427.16,
      "text": "Bekârım."
    },
    {
      "start": 429.74,
      "end": 431.87,
      "text": "Evliyim."
    },
    {
      "start": 435.18,
      "end": 440.11,
      "text": "Lütfen bilgileri kontrol edin. Her şey doğruysa lütfen buraya imza atın."
    },
    {
      "start": 440.21,
      "end": 441.43,
      "text": "Ne dersin?"
    },
    {
      "start": 441.48,
      "end": 444.5,
      "text": "A: Onu masanın altına yazıyorum."
    },
    {
      "start": 444.55,
      "end": 447.56,
      "text": "B: İmza atmayı sevmem."
    },
    {
      "start": 447.62,
      "end": 451.57,
      "text": "C: Her şey doğru. Tam olarak nereye imza atmalıyım?"
    },
    {
      "start": 457.27,
      "end": 463.38,
      "text": "C! „Unterschreiben“ adını elle yazmak demek – imzan."
    },
    {
      "start": 463.43,
      "end": 467.71,
      "text": "Bir de: formda ne yazdığını her zaman önce oku."
    },
    {
      "start": 467.96,
      "end": 471.06,
      "text": "Her şey doğru. Tam olarak nereye imza atmalıyım?"
    },
    {
      "start": 471.16,
      "end": 473.06,
      "text": "Şuraya, aşağıya lütfen."
    },
    {
      "start": 473.16,
      "end": 474.56,
      "text": "Tekrar et!"
    },
    {
      "start": 474.61,
      "end": 476.74,
      "text": "Nereye imza atmalıyım?"
    },
    {
      "start": 480.06,
      "end": 483.7,
      "text": "Tamam, bu kadar. İşte ikamet belgeniz."
    },
    {
      "start": 483.8,
      "end": 486.48,
      "text": "Bitti! Ne dersin?"
    },
    {
      "start": 486.58,
      "end": 489.34,
      "text": "A: Teşekkürler, ben sizi ararım."
    },
    {
      "start": 489.39,
      "end": 493.19,
      "text": "B: Çok teşekkürler! Başka bir şey gerekiyor mu?"
    },
    {
      "start": 493.24,
      "end": 495.76,
      "text": "C: Bir şeyim yok!"
    },
    {
      "start": 501.46,
      "end": 509.79,
      "text": "B! A'ya dikkat: „Ich melde mich“ „kaydımı yaptırıyorum“ demek değil, „sizi sonra ararım“"
    },
    {
      "start": 509.84,
      "end": 514.72,
      "text": "demek. C'yi belki hatırlarsın – o sadece doktorda olur!"
    },
    {
      "start": 514.97,
      "end": 518.07,
      "text": "Çok teşekkürler! Başka bir şey gerekiyor mu?"
    },
    {
      "start": 518.17,
      "end": 522.55,
      "text": "Hayır, hepsi bu. Belgeyi iyi saklayın."
    },
    {
      "start": 522.65,
      "end": 524.05,
      "text": "Tekrar et!"
    },
    {
      "start": 524.1,
      "end": 526.76,
      "text": "Başka bir şey gerekiyor mu?"
    },
    {
      "start": 530.67,
      "end": 537.19,
      "text": "Adres kaydıyla ilgili üç ipucu. Birincisi: Taşındıktan sonra iki hafta içinde kayıt yaptır."
    },
    {
      "start": 537.44,
      "end": 543.41,
      "text": "İkincisi: Birçok şehirde randevu gerekir – çoğu zaman internetten alabilirsin."
    },
    {
      "start": 543.66,
      "end": 549.73,
      "text": "Ve üçüncüsü: İkamet belgesine sık sık tekrar ihtiyacın olur, örneğin banka hesabı için."
    },
    {
      "start": 549.78,
      "end": 551.23,
      "text": "Yani iyi sakla!"
    },
    {
      "start": 551.58,
      "end": 558.25,
      "text": "Resmi dairelerde Almanca bazen çok karmaşık duyulur. Leo okuyor – ben de basitçe söylüyorum."
    },
    {
      "start": 558.5,
      "end": 560.32,
      "text": "Ne için gelmiştiniz?"
    },
    {
      "start": 560.52,
      "end": 562.08,
      "text": "Neye ihtiyacınız var?"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "Lütfen belgelerinizi hazır bulundurun."
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "Lütfen kâğıtlarınızı elinizde tutun."
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "Formu eksiksiz doldurun."
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "Her yere bir şey yazın."
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "İşlem yaklaşık iki hafta sürer."
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "Aşağı yukarı iki hafta sürer."
    },
    {
      "start": 581.69,
      "end": 584.13,
      "text": "Lütfen belgeleri sonradan teslim edin."
    },
    {
      "start": 584.34,
      "end": 587.17,
      "text": "Lütfen kâğıtları sonra getirin."
    },
    {
      "start": 587.82,
      "end": 589.79,
      "text": "Bugün üstümü değiştiriyorum!"
    },
    {
      "start": 589.95,
      "end": 597.9,
      "text": "Aa, başka kıyafet mi giyiyorsun? Yoksa şunu mu demek istiyorsun: „Ich ziehe um“ – yeni bir eve taşınıyorum?"
    },
    {
      "start": 598.35,
      "end": 603.18,
      "text": "Ve resmi dairede: „Ich bin leider“ değil, „Ich bin ledig“"
    },
    {
      "start": 603.23,
      "end": 605.99,
      "text": "(bekârım) – evli değilsen."
    },
    {
      "start": 606.44,
      "end": 613.77,
      "text": "Ve „Ich melde mich“ şu demek: Sonra ararım. Resmi dairede şöyle dersin: „Ich melde mich an.“ (Kaydımı yaptırıyorum.)"
    },
    {
      "start": 614.22,
      "end": 619.88,
      "text": "Ve şimdi her şey bir kez daha. En önemli on cümle. Tekrar et!"
    },
    {
      "start": 619.93,
      "end": 622.17,
      "text": "Adres kaydı yaptırmak istiyorum."
    },
    {
      "start": 625.1,
      "end": 628.25,
      "text": "Saat dokuzda randevum var."
    },
    {
      "start": 632.23,
      "end": 634.47,
      "text": "Bir numara alıyorum."
    },
    {
      "start": 637.4,
      "end": 640.55,
      "text": "Yeni evimin kaydını yaptırmak istiyorum."
    },
    {
      "start": 644.54,
      "end": 648,
      "text": "İşte ev sahibimden aldığım onay belgesi."
    },
    {
      "start": 652.34,
      "end": 654.79,
      "text": "İşte pasaportum."
    },
    {
      "start": 657.96,
      "end": 660.9,
      "text": "Adımı harf harf söylüyorum."
    },
    {
