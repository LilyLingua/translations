      "start": 530.67,
      "end": 537.19,
      "text": "سه نکته دربارهٔ ثبت آدرس. اول: ظرف دو هفته بعد از نقل مکان، آدرست را ثبت کن."
    },
    {
      "start": 537.44,
      "end": 543.41,
      "text": "دوم: در خیلی از شهرها وقت قبلی لازم است – اغلب می‌توانی آن را آنلاین رزرو کنی."
    },
    {
      "start": 543.66,
      "end": 549.73,
      "text": "و سوم: گواهی ثبت اقامت را اغلب دوباره لازم داری، مثلاً برای حساب بانکی."
    },
    {
      "start": 549.78,
      "end": 551.23,
      "text": "پس خوب نگهش دار!"
    },
    {
      "start": 551.58,
      "end": 558.25,
      "text": "در اداره، آلمانی گاهی خیلی پیچیده به نظر می‌رسد. لئو می‌خواند – و من ساده می‌گویم."
    },
    {
      "start": 558.5,
      "end": 560.32,
      "text": "کارتان چیست؟"
    },
    {
      "start": 560.52,
      "end": 562.08,
      "text": "چه لازم دارید؟"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "لطفاً مدارکتان را آماده نگه دارید."
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "لطفاً برگه‌هایتان را در دست داشته باشید."
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "فرم را کامل پر کنید."
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "همه‌جا چیزی بنویسید."
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "رسیدگی حدود دو هفته طول می‌کشد."
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "تقریباً دو هفته طول می‌کشد."
    },
    {
      "start": 581.69,
      "end": 584.13,
      "text": "لطفاً مدارک را بعداً تحویل دهید."
    },
    {
      "start": 584.34,
      "end": 587.17,
      "text": "لطفاً برگه‌ها را بعداً بیاورید."
    },
    {
      "start": 587.82,
      "end": 589.79,
      "text": "امروز لباسم را عوض می‌کنم!"
    },
    {
      "start": 589.95,
      "end": 597.9,
      "text": "آها، لباس دیگری می‌پوشی؟ یا منظورت این است: «⁦Ich ziehe um⁩» – به خانهٔ جدید اسباب‌کشی می‌کنم؟"
    },
    {
      "start": 598.35,
      "end": 605.99,
      "text": "و در اداره: نه «⁦Ich bin leider⁩»، بلکه «⁦Ich bin ledig⁩» (مجردم) – اگر متأهل نیستی."
    },
    {
      "start": 606.44,
      "end": 613.77,
      "text": "و «⁦Ich melde mich⁩» یعنی: بعداً زنگ می‌زنم. در اداره می‌گویی: «⁦Ich melde mich an.⁩» (آدرسم را ثبت می‌کنم.)"
    },
    {
      "start": 614.22,
      "end": 619.88,
      "text": "و حالا همه چیز یک بار دیگر. ده جملهٔ مهم. تکرار کن!"
    },
    {
      "start": 619.93,
      "end": 622.17,
      "text": "می‌خواهم آدرسم را ثبت کنم."
    },
    {
      "start": 625.1,
      "end": 628.25,
      "text": "ساعت نُه وقت دارم."
    },
    {
      "start": 632.23,
      "end": 634.47,
      "text": "یک شماره می‌گیرم."
    },
    {
      "start": 637.4,
      "end": 640.55,
      "text": "می‌خواهم خانهٔ جدیدم را ثبت کنم."
    },
    {
      "start": 644.54,
      "end": 648,
      "text": "این تأییدیهٔ صاحب‌خانه‌ام است."
    },
    {
      "start": 652.34,
      "end": 654.79,
      "text": "این گذرنامهٔ من است."
    },
    {
      "start": 657.96,
      "end": 660.9,
      "text": "اسمم را هجی می‌کنم."
    },
    {
      "start": 664.65,
      "end": 666.57,
      "text": "مجردم."
    },
    {
      "start": 669.14,
      "end": 671.27,
      "text": "کجا را امضا کنم؟"
    },
    {
      "start": 674.08,
      "end": 676.74,
      "text": "چیز دیگری هم لازم دارم؟"
    },
    {
      "start": 680.15,
      "end": 684.61,
      "text": "کدام کلمه برایت سخت‌تر از همه بود؟ در کامنت‌ها بنویس!"
    },
    {
      "start": 684.71,
      "end": 687.65,
      "text": "خداحافظ، به‌زودی در LilyLingua می‌بینیمت!"
    }
  ]
}
