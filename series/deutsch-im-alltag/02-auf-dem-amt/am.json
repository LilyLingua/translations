  "subtitles": [
    {
      "start": 0.4,
      "end": 3.97,
      "text": "ተዛውሬያለሁ! አዲስ አፓርታማ፣ አዲስ ከተማ …"
    },
    {
      "start": 4.07,
      "end": 7.56,
      "text": "በጣም ጥሩ! እና – ተመዝግበሃል?"
    },
    {
      "start": 7.66,
      "end": 11.22,
      "text": "መመዝገብ? የት? ጂም ቤት?"
    },
    {
      "start": 11.32,
      "end": 20,
      "text": "አይ፣ Leo። በነዋሪዎች ጽሕፈት ቤት! ዛሬ በ„Bürgeramt“ የአንድ ሙሉ ቀጠሮ ሂደትን ያያሉ – ከመግቢያው እስከ የምዝገባ ማረጋገጫ ሰነዱ ድረስ።"
    },
    {
      "start": 20.05,
      "end": 24.32,
      "text": "በእያንዳንዱ ሁኔታም እንጠይቅዎታለን፦ ምን ይላሉ?"
    },
    {
      "start": 24.42,
      "end": 26.79,
      "text": "ደግሞም ያለዎት አምስት ሰከንድ ብቻ ነው!"
    },
    {
      "start": 30.09,
      "end": 34.39,
      "text": "ወደ ነዋሪዎች ጽሕፈት ቤት ይገባሉ። በመረጃ ዴስኩ ላይ አንድ ሰው ተቀምጧል።"
    },
    {
      "start": 34.49,
      "end": 37.24,
      "text": "እንደምን አደሩ። ጉዳይዎ ምንድን ነው?"
    },
    {
      "start": 37.34,
      "end": 38.57,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 38.62,
      "end": 42.18,
      "text": "A: እንደምን አደሩ። መመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 42.23,
      "end": 44.91,
      "text": "B: እኔ ጉዳይ ነኝ።"
    },
    {
      "start": 44.96,
      "end": 47.41,
      "text": "C: ቢሮ እፈልጋለሁ።"
    },
    {
      "start": 53.11,
      "end": 57.71,
      "text": "A! „Anliegen“ ማለት፦ ለምን መጡ? ምን ያስፈልግዎታል?"
    },
    {
      "start": 57.76,
      "end": 61.32,
      "text": "ይህን ቃል በመንግሥት ቢሮዎች ብዙ ጊዜ ይሰማሉ።"
    },
    {
      "start": 61.57,
      "end": 64.52,
      "text": "እንደምን አደሩ። መመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 64.61,
      "end": 66.51,
      "text": "ቀጠሮ አለዎት?"
    },
    {
      "start": 66.61,
      "end": 68.51,
      "text": "አዎ፣ 9:00 ሰዓት ላይ።"
    },
    {
      "start": 68.61,
      "end": 70.01,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 70.06,
      "end": 72.3,
      "text": "መመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 75.23,
      "end": 78.28,
      "text": "9:00 ሰዓት ላይ ቀጠሮ አለኝ።"
    },
    {
      "start": 82.64,
      "end": 86.86,
      "text": "ጥሩ። እንግዲያውስ እባክዎ ቁጥር ይውሰዱና እዚያ ይጠብቁ።"
    },
    {
      "start": 86.96,
      "end": 88.7,
      "text": "አሁን ምን ያደርጋሉ?"
    },
    {
      "start": 88.8,
      "end": 91.09,
      "text": "A: ቤት ይቀይራሉ።"
    },
    {
      "start": 91.14,
      "end": 94.23,
      "text": "B: የአንድን ሰው ፀጉር ይጎትታሉ።"
    },
    {
      "start": 94.28,
      "end": 98.74,
      "text": "C: ከማሽኑ ቁጥር ያለበት ወረቀት ይወስዳሉ።"
    },
    {
      "start": 103.94,
      "end": 108.24,
      "text": "እንግዲያው A! ቤት እቀይራለሁ። ገና አሁን ነው የተዛወርኩት …"
    },
    {
      "start": 108.89,
      "end": 115.64,
      "text": "አይ፣ Leo። C! „Eine Nummer ziehen“ ማለት፦ የወረፋ ቁጥርዎ ያለበትን ወረቀት ይወስዳሉ ማለት ነው። „Umziehen“"
    },
    {
      "start": 115.69,
      "end": 121.65,
      "text": "ደግሞ ፍጹም ሌላ ነገር ነው – ትርጉሙ፦ ወደ አዲስ አፓርታማ መዛወር ነው።"
    },
    {
      "start": 121.9,
      "end": 123.31,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 123.36,
      "end": 125.7,
      "text": "ቁጥር እወስዳለሁ።"
    },
    {
      "start": 129.25,
      "end": 134.26,
      "text": "ይጠብቃሉ። በድንገት ማስታወቂያ ይሰማሉ። በጥንቃቄ ያዳምጡ!"
    },
    {
      "start": 134.36,
      "end": 138.6,
      "text": "ቁጥር 147፣ እባክዎ ወደ ዴስክ 12 ይሂዱ።"
    },
    {
      "start": 138.7,
      "end": 143.24,
      "text": "ቁጥርዎ 147 ነው። ወዴት ይሄዳሉ?"
    },
    {
      "start": 143.34,
      "end": 146.83,
      "text": "A: ወደ ዴስክ 147።"
    },
    {
      "start": 146.88,
      "end": 149.4,
      "text": "B: ወደ ዴስክ 12።"
    },
    {
      "start": 149.45,
      "end": 152.13,
      "text": "C: ወደ ክፍል 14።"
    },
    {
      "start": 157.83,
      "end": 160.75,
      "text": "B! መጀመሪያ ቁጥርዎ ይመጣል፣ ከዚያ ዴስኩ።"
    },
    {
      "start": 160.8,
      "end": 164.61,
      "text": "በብዙ ቢሮዎች ይህ በስክሪን ላይም ይታያል።"
    },
    {
      "start": 164.86,
      "end": 166.26,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 166.31,
      "end": 170.61,
      "text": "147 – ዴስክ 12"
    },
    {
      "start": 176.42,
      "end": 180.3,
      "text": "ወደ ዴስክ 12 ይሄዳሉ። እዚያ አንዲት ሴት ተቀምጣለች።"
    },
    {
      "start": 180.4,
      "end": 184.28,
      "text": "እንደምን አደሩ። እባክዎ ይቀመጡ። ምን ልርዳዎት?"
    },
    {
      "start": 184.38,
      "end": 185.6,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 185.65,
      "end": 188.49,
      "text": "A: እርስዎን መመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 188.54,
      "end": 192.11,
      "text": "B: አዲሱን አፓርታማዬን ማስመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 192.16,
      "end": 195.41,
      "text": "C: አሁን እዚህ ነው የምኖረው። ቻው!"
    },
    {
      "start": 201.11,
      "end": 206.75,
      "text": "B! አፓርታማዎን ያስመዘግባሉ – ወይም ራስዎን፦ „Ich möchte mich anmelden.“"
    },
    {
      "start": 206.8,
      "end": 210.84,
      "text": "ግን „Sie“ (እርስዎን) አይደለም – ወይዘሮ Krüger አስቀድማ ተመዝግባለች።"
    },
    {
      "start": 211.09,
      "end": 213.69,
      "text": "አዲሱን አፓርታማዬን ማስመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 213.79,
      "end": 216.55,
      "text": "በደስታ። መቼ ነው የገቡት?"
    },
    {
      "start": 216.65,
      "end": 218.47,
      "text": "ኦክቶበር 1 ቀን።"
    },
    {
      "start": 218.57,
      "end": 219.97,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 220.03,
      "end": 223.38,
      "text": "አዲሱን አፓርታማዬን ማስመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 227.61,
      "end": 231.07,
      "text": "ኦክቶበር 1 ቀን ነው የገባሁት።"
    },
    {
      "start": 235.92,
      "end": 238.67,
      "text": "የአከራይዎን ማረጋገጫ ይዘዋል?"
    },
    {
      "start": 238.77,
      "end": 242.34,
      "text": "ኦ፣ ረጅም ቃል! ምን ይላሉ?"
    },
    {
      "start": 242.44,
      "end": 245.77,
      "text": "A: አይ፣ አፓርታማ አልሰጥም።"
    },
    {
      "start": 245.82,
      "end": 249.31,
      "text": "B: አዎ፣ አፓርታማዬን እሰጥዎታለሁ።"
    },
    {
      "start": 249.36,
      "end": 253.58,
      "text": "C: አዎ፣ የአከራዬ ማረጋገጫ ይኸውልዎት።"
    },
    {
      "start": 259.28,
      "end": 267.17,
      "text": "C! „Wohnungsgeberbestätigung“ ከአከራይዎ የሚሰጥ ቅጽ ነው። በእርግጥ በዚህ አፓርታማ እንደሚኖሩ ያረጋግጣል።"
    },
    {
      "start": 267.22,
      "end": 270.92,
      "text": "ያለዚህ ወረቀት ምዝገባው ብዙውን ጊዜ አይቻልም።"
    },
    {
      "start": 271.17,
      "end": 274.51,
      "text": "አዎ፣ የአከራዬ ማረጋገጫ ይኸውልዎት።"
    },
    {
      "start": 274.61,
      "end": 276.01,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 276.06,
      "end": 279.52,
      "text": "የአከራዬ ማረጋገጫ ይኸውልዎት።"
    },
    {
      "start": 284.37,
      "end": 287.31,
      "text": "እና መታወቂያዎን ወይም ፓስፖርትዎን፣ እባክዎ።"
    },
    {
      "start": 287.41,
      "end": 288.63,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 288.68,
      "end": 291.36,
      "text": "A: ፓስፖርቴ ይኸውልዎት።"
    },
    {
      "start": 291.41,
      "end": 294.17,
      "text": "B: ፓስፖርቴ እነዚህ ናቸው።"
    },
    {
      "start": 294.22,
      "end": 296.98,
      "text": "C: እኔ ፓስፖርት ነኝ።"
    },
    {
      "start": 302.68,
      "end": 305.5,
      "text": "A! አንድ ፓስፖርት – ስለዚህ „ist“ (ነው)፣ „sind“ (ናቸው) አይደለም። በመንግሥት ቢሮ ፓስፖርትዎ ወይም መታወቂያዎ ሁልጊዜ ማለት ይቻላል ያስፈልጋል።"
    },
    {
      "start": 305.55,
      "end": 310.94,
      "text": "ከረሱት ደግሞ በግልጽ ይናገሩ፦ „Entschuldigung, den habe ich leider vergessen.“"
    },
    {
      "start": 310.99,
      "end": 318.08,
      "text": "(ይቅርታ፣ እንደ አለመታደል ሆኖ ረስቼዋለሁ።)"
    },
    {
      "start": 318.33,
      "end": 320.14,
      "text": "ፓስፖርቴ ይኸውልዎት።"
    },
    {
      "start": 320.25,
      "end": 321.65,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 321.7,
      "end": 323.94,
      "text": "ፓስፖርቴ ይኸውልዎት።"
    },
    {
      "start": 326.87,
      "end": 330.65,
      "text": "ይቅርታ፣ እንደ አለመታደል ሆኖ ረስቼዋለሁ።"
    },
    {
      "start": 335.85,
      "end": 338.14,
      "text": "የቤተሰብ ስምዎ እንዴት ይጻፋል?"
    },
    {
      "start": 338.24,
      "end": 341.34,
      "text": "ስምዎ Nowak ነው። ምን ይላሉ?"
    },
    {
      "start": 341.44,
      "end": 344.12,
      "text": "A: በእስክሪብቶ።"
    },
    {
      "start": 344.17,
      "end": 349.33,
      "text": "B: ፊደል በፊደል እናገራለሁ፦ N – O – W – A – K።"
    },
    {
      "start": 349.38,
      "end": 352.4,
      "text": "C: በጣም በሚያምር ሁኔታ ይጽፉታል።"
    },
    {
      "start": 358.1,
      "end": 365.79,
      "text": "B! „Wie schreibt man …?“ ማለት፦ የትኞቹ ፊደላት? ማለት ነው። ከዚያ ፊደል በፊደል ይናገራሉ።"
    },
    {
      "start": 365.84,
      "end": 370.31,
      "text": "ስምዎን በጀርመንኛ ይለማመዱ፣ በሁሉም ቦታ ያስፈልግዎታል!"
    },
    {
      "start": 370.56,
      "end": 373.58,
      "text": "N – O – W – A – K።"
    },
    {
      "start": 373.68,
      "end": 374.88,
      "text": "አመሰግናለሁ።"
    },
    {
      "start": 374.94,
      "end": 376.35,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 376.4,
      "end": 382.11,
      "text": "ፊደል በፊደል እናገራለሁ፦ N – O – W – A – K።"
    },
    {
      "start": 389.54,
      "end": 391.36,
      "text": "ባለትዳር ነዎት?"
    },
    {
      "start": 391.45,
      "end": 394.71,
      "text": "አላገቡም። ምን ይላሉ?"
    },
    {
      "start": 394.81,
      "end": 397.83,
      "text": "A: አይ፣ ያላገባሁ ነኝ።"
    },
    {
      "start": 397.88,
      "end": 400.98,
      "text": "B: አይ፣ እንደ አለመታደል ነኝ።"
    },
    {
      "start": 401.02,
      "end": 404.12,
      "text": "C: አይ፣ እኔ አግባ ነኝ።"
    },
    {
      "start": 409.82,
      "end": 419.92,
      "text": "A! „Ledig“ ማለት፦ ያላገባ ማለት ነው። ይጠንቀቁ፦ „leider“ ተመሳሳይ ይመስላል፣ ግን ፍጹም ሌላ ትርጉም አለው – „leider“"
    },
    {
      "start": 419.97,
      "end": 421.31,
      "text": "ማለት፦ እንደ አለመታደል ሆኖ ማለት ነው።"
    },
    {
      "start": 421.56,
      "end": 423.69,
      "text": "አይ፣ ያላገባሁ ነኝ።"
    },
    {
      "start": 423.79,
      "end": 425.19,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 425.24,
      "end": 427.16,
      "text": "ያላገባሁ ነኝ።"
    },
    {
      "start": 429.74,
      "end": 431.87,
      "text": "ባለትዳር ነኝ።"
    },
    {
      "start": 435.18,
      "end": 440.11,
      "text": "እባክዎ መረጃዎቹን ያረጋግጡ። ሁሉም ትክክል ከሆነ፣ እባክዎ እዚህ ይፈርሙ።"
    },
    {
      "start": 440.21,
      "end": 441.43,
      "text": "ምን ይላሉ?"
    },
    {
      "start": 441.48,
      "end": 444.5,
      "text": "A: ከጠረጴዛው በታች እጽፈዋለሁ።"
    },
    {
      "start": 444.55,
      "end": 447.56,
      "text": "B: መፈረም አልወድም።"
    },
    {
      "start": 447.62,
      "end": 451.57,
      "text": "C: ሁሉም ትክክል ነው። በትክክል የት ልፈርም?"
    },
    {
      "start": 457.27,
      "end": 463.38,
      "text": "C! „Unterschreiben“ ማለት፦ ስምዎን በእጅ መጻፍ ነው – ፊርማዎ።"
    },
    {
      "start": 463.43,
      "end": 467.71,
      "text": "ማወቁም ጥሩ ነው፦ በቅጹ ላይ ያለውን ሁልጊዜ መጀመሪያ ያንብቡ።"
    },
    {
      "start": 467.96,
      "end": 471.06,
      "text": "ሁሉም ትክክል ነው። በትክክል የት ልፈርም?"
    },
    {
      "start": 471.16,
      "end": 473.06,
      "text": "እዚህ ታች፣ እባክዎ።"
    },
    {
      "start": 473.16,
      "end": 474.56,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 474.61,
      "end": 476.74,
      "text": "የት ልፈርም?"
    },
    {
      "start": 480.06,
      "end": 483.7,
      "text": "በቃ፣ ጨርሰናል። የምዝገባ ማረጋገጫ ሰነድዎ ይኸውልዎት።"
    },
    {
      "start": 483.8,
      "end": 486.48,
      "text": "ጨርሰዋል! ምን ይላሉ?"
    },
    {
      "start": 486.58,
      "end": 489.34,
      "text": "A: አመሰግናለሁ፣ እደውልልዎታለሁ።"
    },
    {
      "start": 489.39,
      "end": 493.19,
      "text": "B: በጣም አመሰግናለሁ! ሌላ የሚያስፈልገኝ ነገር አለ?"
    },
    {
      "start": 493.24,
      "end": 495.76,
      "text": "C: ምንም አላመመኝም!"
    },
    {
      "start": 501.46,
      "end": 509.79,
      "text": "B! A ላይ ደግሞ ይጠንቀቁ፦ „Ich melde mich“ ማለት „እመዘገባለሁ“ ማለት አይደለም፣ ይልቁንም፦ በኋላ እደውልልዎታለሁ ማለት ነው።"
    },
    {
      "start": 509.84,
      "end": 514.72,
      "text": "C ደግሞ ምናልባት ያስታውሱት ይሆናል – ያ የሚስማማው ሐኪም ቤት ብቻ ነው!"
    },
    {
      "start": 514.97,
      "end": 518.07,
      "text": "በጣም አመሰግናለሁ! ሌላ የሚያስፈልገኝ ነገር አለ?"
    },
    {
      "start": 518.17,
      "end": 522.55,
      "text": "አይ፣ ያ ብቻ ነው። ማረጋገጫውን በጥንቃቄ ያስቀምጡት።"
    },
    {
      "start": 522.65,
      "end": 524.05,
      "text": "ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 524.1,
      "end": 526.76,
      "text": "ሌላ የሚያስፈልገኝ ነገር አለ?"
    },
    {
      "start": 530.67,
      "end": 537.19,
      "text": "ስለ ምዝገባ ሦስት ምክሮች። አንደኛ፦ ከገቡ በኋላ በሁለት ሳምንት ውስጥ ይመዝገቡ።"
    },
    {
      "start": 537.44,
      "end": 543.41,
      "text": "ሁለተኛ፦ በብዙ ከተሞች ቀጠሮ ያስፈልግዎታል – ብዙ ጊዜ በኦንላይን መያዝ ይችላሉ።"
    },
    {
      "start": 543.66,
      "end": 549.73,
      "text": "ሦስተኛ፦ የምዝገባ ማረጋገጫ ሰነዱ ብዙ ጊዜ እንደገና ያስፈልግዎታል፣ ለምሳሌ ለባንክ ሂሳብ።"
    },
    {
      "start": 549.78,
      "end": 551.23,
      "text": "ስለዚህ በጥንቃቄ ያስቀምጡት!"
    },
    {
      "start": 551.58,
      "end": 558.25,
      "text": "በመንግሥት ቢሮ ጀርመንኛ አንዳንድ ጊዜ በጣም የተወሳሰበ ይመስላል። Leo ያነባል – እኔ ደግሞ በቀላሉ እናገረዋለሁ።"
    },
    {
      "start": 558.5,
      "end": 560.32,
      "text": "ጉዳይዎ ምንድን ነው?"
    },
    {
      "start": 560.52,
      "end": 562.08,
      "text": "ምን ያስፈልግዎታል?"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "እባክዎ ሰነዶችዎን ያዘጋጁ።"
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "እባክዎ ወረቀቶችዎን በእጅዎ ይያዙ።"
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "ቅጹን ሙሉ በሙሉ ይሙሉ።"
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "በሁሉም ቦታ የሆነ ነገር ይጻፉ።"
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "ሂደቱ በግምት ሁለት ሳምንት ይወስዳል።"
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "ሁለት ሳምንት ገደማ ይወስዳል።"
    },
    {
      "start": 581.69,
      "end": 584.13,
      "text": "እባክዎ ሰነዶቹን በኋላ ያቅርቡ።"
    },
    {
      "start": 584.34,
      "end": 587.17,
      "text": "እባክዎ ወረቀቶቹን በኋላ ያምጡ።"
    },
    {
      "start": 587.82,
      "end": 589.79,
      "text": "ዛሬ ልብሴን እቀይራለሁ!"
    },
    {
      "start": 589.95,
      "end": 597.9,
      "text": "ኦ፣ ሌላ ልብስ ትለብሳለህ? ወይስ ማለት የፈለግከው፦ „Ich ziehe um“ – ወደ አዲስ አፓርታማ እዛወራለሁ ነው?"
    },
    {
      "start": 598.35,
      "end": 603.18,
      "text": "በመንግሥት ቢሮ ደግሞ፦ „Ich bin leider“ ሳይሆን „Ich bin ledig“"
    },
    {
      "start": 603.23,
      "end": 605.99,
      "text": "(ያላገባሁ ነኝ) – ካላገቡ።"
    },
    {
      "start": 606.44,
      "end": 613.77,
      "text": "„Ich melde mich“ ማለት ደግሞ፦ በኋላ እደውላለሁ ማለት ነው። በመንግሥት ቢሮ የሚሉት፦ „Ich melde mich an.“ (እመዘገባለሁ።)"
    },
    {
      "start": 614.22,
      "end": 619.88,
      "text": "አሁን ደግሞ ሁሉንም አንድ ጊዜ እንደገና። አሥሩ በጣም አስፈላጊ ዓረፍተ ነገሮች። ተከትለውኝ ይድገሙ!"
    },
    {
      "start": 619.93,
      "end": 622.17,
      "text": "መመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 625.1,
      "end": 628.25,
      "text": "9:00 ሰዓት ላይ ቀጠሮ አለኝ።"
    },
    {
      "start": 632.23,
      "end": 634.47,
      "text": "ቁጥር እወስዳለሁ።"
    },
    {
      "start": 637.4,
      "end": 640.55,
      "text": "አዲሱን አፓርታማዬን ማስመዝገብ እፈልጋለሁ።"
    },
    {
      "start": 644.54,
      "end": 648,
      "text": "የአከራዬ ማረጋገጫ ይኸውልዎት።"
    },
    {
      "start": 652.34,
      "end": 654.79,
      "text": "ፓስፖርቴ ይኸውልዎት።"
    },
    {
      "start": 657.96,
      "end": 660.9,
      "text": "ስሜን ፊደል በፊደል እናገራለሁ።"
    },
    {
      "start": 664.65,
      "end": 666.57,
      "text": "ያላገባሁ ነኝ።"
    },
    {
      "start": 669.14,
      "end": 671.27,
      "text": "የት ልፈርም?"
    },
    {
      "start": 674.08,
      "end": 676.74,
      "text": "ሌላ የሚያስፈልገኝ ነገር አለ?"
    },
    {
      "start": 680.15,
      "end": 684.61,
      "text": "ለእርስዎ በጣም ከባዱ ቃል የትኛው ነበር? በአስተያየት መስጫው ላይ ይጻፉት!"
    },
    {
      "start": 684.71,
      "end": 687.65,
      "text": "ቻው፣ በLilyLingua በቅርቡ እንገናኝ!"
    }
  ]
}
