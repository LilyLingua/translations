  "subtitles": [
    {
      "start": 0.4,
      "end": 3.97,
      "text": "انتقلت! شقة جديدة، مدينة جديدة…"
    },
    {
      "start": 4.07,
      "end": 7.56,
      "text": "رائع! وهل سجّلت عنوانك بعد؟"
    },
    {
      "start": 7.66,
      "end": 11.22,
      "text": "سجّلت؟ أين؟ في النادي الرياضي؟"
    },
    {
      "start": 11.32,
      "end": 20,
      "text": "لا يا ليو. في الدائرة الحكومية! اليوم ستعيش موعدًا كاملًا في «⁦Bürgeramt⁩» – من المدخل حتى شهادة تسجيل السكن."
    },
    {
      "start": 20.05,
      "end": 24.32,
      "text": "وفي كل موقف نسألك: ماذا تقول؟"
    },
    {
      "start": 24.42,
      "end": 26.79,
      "text": "ولديك خمس ثوانٍ فقط!"
    },
    {
      "start": 30.09,
      "end": 34.39,
      "text": "تدخل إلى مكتب المواطنين. عند مكتب الاستعلامات يجلس رجل."
    },
    {
      "start": 34.49,
      "end": 37.24,
      "text": "صباح الخير. ما طلبك؟"
    },
    {
      "start": 37.34,
      "end": 38.57,
      "text": "ماذا تقول؟"
    },
    {
      "start": 38.62,
      "end": 42.18,
      "text": "A: صباح الخير. أريد تسجيل عنواني."
    },
    {
      "start": 42.23,
      "end": 44.91,
      "text": "B: أنا طلب."
    },
    {
      "start": 44.96,
      "end": 47.41,
      "text": "C: أريد دائرة حكومية."
    },
    {
      "start": 53.11,
      "end": 61.32,
      "text": "⁦A!⁩ «⁦Anliegen⁩» تعني: لماذا أنت هنا؟ ماذا تحتاج؟ ستسمع هذه الكلمة كثيرًا في الدوائر الحكومية."
    },
    {
      "start": 61.57,
      "end": 64.52,
      "text": "صباح الخير. أريد تسجيل عنواني."
    },
    {
      "start": 64.61,
      "end": 66.51,
      "text": "هل لديك موعد؟"
    },
    {
      "start": 66.61,
      "end": 68.51,
      "text": "نعم، في الساعة التاسعة."
    },
    {
      "start": 68.61,
      "end": 70.01,
      "text": "كرّر!"
    },
    {
      "start": 70.06,
      "end": 72.3,
      "text": "أريد تسجيل عنواني."
    },
    {
      "start": 75.23,
      "end": 78.28,
      "text": "لديّ موعد في الساعة التاسعة."
    },
    {
      "start": 82.64,
      "end": 86.86,
      "text": "حسنًا. إذن خذ رقمًا من فضلك وانتظر هناك."
    },
    {
      "start": 86.96,
      "end": 88.7,
      "text": "ماذا تفعل الآن؟"
    },
    {
      "start": 88.8,
      "end": 91.09,
      "text": "A: تنتقل إلى بيت آخر."
    },
    {
      "start": 91.14,
      "end": 94.23,
      "text": "B: تشدّ شعر أحدهم."
    },
    {
      "start": 94.28,
      "end": 98.74,
      "text": "C: تأخذ ورقة عليها رقم من الجهاز."
    },
    {
      "start": 103.94,
      "end": 108.24,
      "text": "إذن A! أنا أنتقل. فأنا انتقلت للتو…"
    },
    {
      "start": 108.89,
      "end": 115.64,
      "text": "لا يا ليو. C! «⁦Eine Nummer ziehen⁩» تعني: تأخذ ورقة عليها رقم انتظارك."
    },
    {
      "start": 115.69,
      "end": 121.65,
      "text": "أما «⁦Umziehen⁩» فشيء مختلف تمامًا – معناها: الانتقال إلى شقة جديدة."
    },
    {
      "start": 121.9,
      "end": 123.31,
      "text": "كرّر!"
    },
    {
      "start": 123.36,
      "end": 125.7,
      "text": "آخذ رقمًا."
    },
    {
      "start": 129.25,
      "end": 134.26,
      "text": "تنتظر. فجأة تسمع إعلانًا. استمع جيدًا!"
    },
    {
      "start": 134.36,
      "end": 138.6,
      "text": "الرقم 147، من فضلك إلى الشبّاك 12."
    },
    {
      "start": 138.7,
      "end": 143.24,
      "text": "رقمك هو 147. إلى أين تذهب؟"
    },
    {
      "start": 143.34,
      "end": 146.83,
      "text": "A: إلى الشبّاك 147."
    },
    {
      "start": 146.88,
      "end": 149.4,
      "text": "B: إلى الشبّاك 12."
    },
    {
      "start": 149.45,
      "end": 152.13,
      "text": "C: إلى الغرفة 14."
    },
    {
      "start": 157.83,
      "end": 160.75,
      "text": "⁦B!⁩ أولًا يأتي رقمك، ثم الشبّاك."
    },
    {
      "start": 160.8,
      "end": 164.61,
      "text": "وفي كثير من الدوائر يظهر ذلك أيضًا على شاشة."
    },
    {
      "start": 164.86,
      "end": 166.26,
      "text": "كرّر!"
    },
    {
      "start": 166.31,
      "end": 170.61,
      "text": "147 – الشبّاك 12"
    },
    {
      "start": 176.42,
      "end": 180.3,
      "text": "تذهب إلى الشبّاك 12. هناك تجلس امرأة."
    },
    {
      "start": 180.4,
      "end": 184.28,
      "text": "صباح الخير. تفضّل بالجلوس. كيف يمكنني مساعدتك؟"
    },
    {
      "start": 184.38,
      "end": 185.6,
      "text": "ماذا تقول؟"
    },
    {
      "start": 185.65,
      "end": 188.49,
      "text": "A: أريد أن أسجّلك أنتِ."
    },
    {
      "start": 188.54,
      "end": 192.11,
      "text": "B: أريد تسجيل شقتي الجديدة."
    },
    {
      "start": 192.16,
      "end": 195.41,
      "text": "C: أسكن هنا الآن. إلى اللقاء!"
    },
    {
      "start": 201.11,
      "end": 210.84,
      "text": "⁦B!⁩ تسجّل شقتك – أو نفسك: «⁦Ich möchte mich anmelden.⁩» لكن ليس «⁦Sie⁩» (حضرتك) – فالسيدة كروغر مسجّلة أصلًا."
    },
    {
      "start": 211.09,
      "end": 213.69,
      "text": "أريد تسجيل شقتي الجديدة."
    },
    {
      "start": 213.79,
      "end": 216.55,
      "text": "بكل سرور. متى انتقلت إلى الشقة؟"
    },
    {
      "start": 216.65,
      "end": 218.47,
      "text": "في الأول من أكتوبر."
    },
    {
      "start": 218.57,
      "end": 219.97,
      "text": "كرّر!"
    },
    {
      "start": 220.03,
      "end": 223.38,
      "text": "أريد تسجيل شقتي الجديدة."
    },
    {
      "start": 227.61,
      "end": 231.07,
      "text": "انتقلت إلى الشقة في الأول من أكتوبر."
    },
    {
      "start": 235.92,
      "end": 238.67,
      "text": "هل معك تأكيد صاحب السكن؟"
    },
    {
      "start": 238.77,
      "end": 242.34,
      "text": "أوه، كلمة طويلة! ماذا تقول؟"
    },
    {
      "start": 242.44,
      "end": 245.77,
      "text": "A: لا، أنا لا أعطي شقة."
    },
    {
      "start": 245.82,
      "end": 249.31,
      "text": "B: نعم، أعطيكِ شقتي."
    },
    {
      "start": 249.36,
      "end": 253.58,
      "text": "C: نعم، هذا هو التأكيد من صاحب السكن."
    },
    {
      "start": 259.28,
      "end": 267.17,
      "text": "⁦C!⁩ «⁦Wohnungsgeberbestätigung⁩» استمارة من صاحب السكن. مكتوب فيها أنك تسكن فعلًا في هذه الشقة."
    },
    {
      "start": 267.22,
      "end": 270.92,
      "text": "بدون هذه الورقة لا يتم التسجيل عادةً."
    },
    {
      "start": 271.17,
      "end": 274.51,
      "text": "نعم، هذا هو التأكيد من صاحب السكن."
    },
    {
      "start": 274.61,
      "end": 276.01,
      "text": "كرّر!"
    },
    {
      "start": 276.06,
      "end": 279.52,
      "text": "هذا هو التأكيد من صاحب السكن."
    },
    {
      "start": 284.37,
      "end": 287.31,
      "text": "وبطاقة الهوية أو جواز السفر، من فضلك."
    },
    {
      "start": 287.41,
      "end": 288.63,
      "text": "ماذا تقول؟"
    },
    {
      "start": 288.68,
      "end": 291.36,
      "text": "A: هذا جواز سفري."
    },
    {
      "start": 291.41,
      "end": 294.17,
      "text": "B: هؤلاء جواز سفري."
    },
    {
      "start": 294.22,
      "end": 296.98,
      "text": "C: أنا جواز سفر."
    },
    {
      "start": 302.68,
      "end": 305.5,
      "text": "⁦A!⁩ جواز واحد – إذن «⁦ist⁩» وليس «⁦sind⁩»."
    },
    {
      "start": 305.55,
      "end": 310.94,
      "text": "في الدائرة الحكومية تحتاج تقريبًا دائمًا إلى جواز السفر أو بطاقة الهوية."
    },
    {
      "start": 310.99,
      "end": 318.08,
      "text": "وإذا نسيته، قل بصراحة: «⁦Entschuldigung, den habe ich leider vergessen.⁩» (عفوًا، للأسف نسيته.)"
    },
    {
      "start": 318.33,
      "end": 320.14,
      "text": "هذا جواز سفري."
    },
    {
      "start": 320.25,
      "end": 321.65,
      "text": "كرّر!"
    },
    {
      "start": 321.7,
      "end": 323.94,
      "text": "هذا جواز سفري."
    },
    {
      "start": 326.87,
      "end": 330.65,
      "text": "عفوًا، للأسف نسيته."
    },
    {
      "start": 335.85,
      "end": 338.14,
      "text": "كيف يُكتب اسم عائلتك؟"
    },
    {
      "start": 338.24,
      "end": 341.34,
      "text": "اسمك نوفاك. ماذا تقول؟"
    },
    {
      "start": 341.44,
      "end": 344.12,
      "text": "A: بقلم حبر جاف."
    },
    {
      "start": 344.17,
      "end": 349.33,
      "text": "B: أتهجّاه: N – O – W – A – K."
    },
    {
      "start": 349.38,
      "end": 352.4,
      "text": "C: يُكتب بشكل جميل جدًا."
    },
    {
      "start": 358.1,
      "end": 365.79,
      "text": "⁦B!⁩ «⁦Wie schreibt man …?⁩» تعني: ما هي الحروف؟ عندها تتهجّى – حرفًا حرفًا."
    },
    {
      "start": 365.84,
      "end": 370.31,
      "text": "تدرّب على تهجئة اسمك بالألمانية، فستحتاجها في كل مكان!"
    },
    {
      "start": 370.56,
      "end": 373.58,
      "text": "N – O – W – A – K."
    },
    {
      "start": 373.68,
      "end": 374.88,
      "text": "شكرًا."
    },
    {
      "start": 374.94,
      "end": 376.35,
      "text": "كرّر!"
    },
    {
      "start": 376.4,
      "end": 382.11,
      "text": "أتهجّاه: N – O – W – A – K."
    },
    {
      "start": 389.54,
      "end": 391.36,
      "text": "هل أنت متزوج؟"
    },
    {
      "start": 391.45,
      "end": 394.71,
      "text": "أنت غير متزوج. ماذا تقول؟"
    },
    {
      "start": 394.81,
      "end": 397.83,
      "text": "A: لا، أنا أعزب."
    },
    {
      "start": 397.88,
      "end": 400.98,
      "text": "B: لا، أنا للأسف."
    },
    {
      "start": 401.02,
      "end": 404.12,
      "text": "C: لا، أنا يتزوّج."
    },
    {
      "start": 409.82,
      "end": 419.92,
      "text": "⁦A!⁩ «⁦Ledig⁩» تعني: غير متزوج."
    },
    {
      "start": 419.97,
      "end": 421.31,
      "text": "انتبه: «⁦leider⁩» تشبهها في النطق، لكن معناها مختلف تمامًا – «⁦leider⁩» تعني: للأسف."
    },
    {
      "start": 421.56,
      "end": 423.69,
      "text": "لا، أنا أعزب."
    },
    {
      "start": 423.79,
      "end": 425.19,
      "text": "كرّر!"
    },
    {
      "start": 425.24,
      "end": 427.16,
      "text": "أنا أعزب."
    },
    {
      "start": 429.74,
      "end": 431.87,
      "text": "أنا متزوج."
    },
    {
      "start": 435.18,
      "end": 440.11,
      "text": "من فضلك راجع البيانات. إذا كان كل شيء صحيحًا، وقّع هنا من فضلك."
    },
    {
      "start": 440.21,
      "end": 441.43,
      "text": "ماذا تقول؟"
    },
    {
      "start": 441.48,
      "end": 444.5,
      "text": "A: أكتبها تحت الطاولة."
    },
    {
      "start": 444.55,
      "end": 447.56,
      "text": "B: لا أحب التوقيع."
    },
    {
      "start": 447.62,
      "end": 451.57,
      "text": "C: كل شيء صحيح. أين أوقّع بالضبط؟"
    },
    {
      "start": 457.27,
      "end": 463.38,
      "text": "⁦C!⁩ «⁦Unterschreiben⁩» تعني: أن تكتب اسمك بيدك – توقيعك."
    },
    {
      "start": 463.43,
      "end": 467.71,
      "text": "ونصيحة: اقرأ دائمًا أولًا ما هو مكتوب في الاستمارة."
    },
    {
      "start": 467.96,
      "end": 471.06,
      "text": "كل شيء صحيح. أين أوقّع بالضبط؟"
    },
    {
      "start": 471.16,
      "end": 473.06,
      "text": "هنا في الأسفل، من فضلك."
    },
    {
      "start": 473.16,
      "end": 474.56,
      "text": "كرّر!"
    },
    {
      "start": 474.61,
      "end": 476.74,
      "text": "أين أوقّع؟"
    },
    {
      "start": 480.06,
      "end": 483.7,
      "text": "حسنًا، انتهينا. هذه شهادة تسجيل السكن الخاصة بك."
    },
    {
      "start": 483.8,
      "end": 486.48,
      "text": "انتهيت! ماذا تقول؟"
    },
    {
      "start": 486.58,
      "end": 489.34,
      "text": "A: شكرًا، سأتصل بكِ."
    },
    {
      "start": 489.39,
      "end": 493.19,
      "text": "B: شكرًا جزيلًا! هل أحتاج شيئًا آخر؟"
    },
    {
      "start": 493.24,
      "end": 495.76,
      "text": "C: لا أشكو من شيء!"
    },
    {
      "start": 501.46,
      "end": 509.79,
      "text": "⁦B!⁩ وانتبه في A: «⁦Ich melde mich⁩» لا تعني «⁦أسجّل نفسي⁩»، بل: سأتصل بك لاحقًا."
    },
    {
      "start": 509.84,
      "end": 514.72,
      "text": "وربما تتذكر C – فهي تناسب فقط عند الطبيب!"
    },
    {
      "start": 514.97,
      "end": 518.07,
      "text": "شكرًا جزيلًا! هل أحتاج شيئًا آخر؟"
    },
    {
      "start": 518.17,
      "end": 522.55,
      "text": "لا، هذا كل شيء. احتفظ بالشهادة في مكان آمن."
    },
    {
      "start": 522.65,
      "end": 524.05,
      "text": "كرّر!"
    },
    {
      "start": 524.1,
      "end": 526.76,
      "text": "هل أحتاج شيئًا آخر؟"
    },
    {
      "start": 530.67,
      "end": 537.19,
      "text": "ثلاث نصائح حول التسجيل. أولًا: سجّل عنوانك خلال أسبوعين من انتقالك إلى السكن."
    },
    {
      "start": 537.44,
      "end": 543.41,
      "text": "ثانيًا: في كثير من المدن تحتاج إلى موعد – وغالبًا يمكنك حجزه عبر الإنترنت."
    },
    {
      "start": 543.66,
      "end": 549.73,
      "text": "وثالثًا: ستحتاج شهادة التسجيل كثيرًا، مثلًا لفتح حساب بنكي."
    },
    {
      "start": 549.78,
      "end": 551.23,
      "text": "لذلك احتفظ بها جيدًا!"
    },
    {
      "start": 551.58,
      "end": 558.25,
      "text": "في الدوائر الحكومية تبدو الألمانية أحيانًا معقدة جدًا. ليو يقرأ – وأنا أقولها ببساطة."
    },
    {
      "start": 558.5,
      "end": 560.32,
      "text": "ما طلبك؟"
    },
    {
      "start": 560.52,
      "end": 562.08,
      "text": "ماذا تحتاج؟"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "من فضلك جهّز مستنداتك."
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "من فضلك امسك أوراقك بيدك."
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "املأ الاستمارة بالكامل."
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "اكتب شيئًا في كل مكان."
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "تستغرق المعالجة حوالي أسبوعين."
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "يستغرق ذلك أسبوعين تقريبًا."
    },
    {
      "start": 581.69,
      "end": 584.13,
      "text": "من فضلك قدّم المستندات لاحقًا."
    },
    {
      "start": 584.34,
      "end": 587.17,
      "text": "من فضلك أحضر الأوراق لاحقًا."
    },
    {
      "start": 587.82,
      "end": 589.79,
      "text": "اليوم أغيّر ملابسي!"
    },
    {
      "start": 589.95,
      "end": 597.9,
      "text": "آه، ستلبس ملابس أخرى؟ أم تقصد: «⁦Ich ziehe um⁩» – أنتقل إلى شقة جديدة؟"
    },
    {
      "start": 598.35,
      "end": 605.99,
      "text": "وفي الدائرة الحكومية: ليس «⁦Ich bin leider⁩»، بل «⁦Ich bin ledig⁩» (أنا أعزب) – إذا لم تكن متزوجًا."
    },
    {
      "start": 606.44,
      "end": 613.77,
      "text": "و«⁦Ich melde mich⁩» تعني: سأتصل لاحقًا. في الدائرة الحكومية تقول: «⁦Ich melde mich an.⁩» (أسجّل عنواني.)"
    },
    {
      "start": 614.22,
      "end": 619.88,
      "text": "والآن كل شيء مرة أخرى. أهم عشر جمل. كرّر!"
    },
    {
      "start": 619.93,
      "end": 622.17,
      "text": "أريد تسجيل عنواني."
    },
    {
      "start": 625.1,
      "end": 628.25,
      "text": "لديّ موعد في الساعة التاسعة."
    },
    {
      "start": 632.23,
      "end": 634.47,
      "text": "آخذ رقمًا."
    },
    {
      "start": 637.4,
      "end": 640.55,
      "text": "أريد تسجيل شقتي الجديدة."
    },
    {
      "start": 644.54,
      "end": 648,
      "text": "هذا هو التأكيد من صاحب السكن."
    },
    {
      "start": 652.34,
      "end": 654.79,
      "text": "هذا جواز سفري."
    },
    {
      "start": 657.96,
      "end": 660.9,
      "text": "أتهجّى اسمي."
    },
    {
      "start": 664.65,
      "end": 666.57,
      "text": "أنا أعزب."
    },
    {
      "start": 669.14,
      "end": 671.27,
      "text": "أين أوقّع؟"
    },
    {
      "start": 674.08,
      "end": 676.74,
      "text": "هل أحتاج شيئًا آخر؟"
    },
    {
      "start": 680.15,
      "end": 684.61,
      "text": "أي كلمة كانت الأصعب بالنسبة لك؟ اكتبها في التعليقات!"
    },
    {
      "start": 684.71,
      "end": 687.65,
      "text": "مع السلامة، وإلى اللقاء قريبًا في LilyLingua!"
    }
  ]
}
