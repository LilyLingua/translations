    {
      "start": 374.94,
      "end": 376.35,
      "text": "חזור אחרי!"
    },
    {
      "start": 376.4,
      "end": 382.11,
      "text": "אני מאיית: N – O – W – A – K."
    },
    {
      "start": 389.54,
      "end": 391.36,
      "text": "אתה נשוי?"
