    },
    {
      "start": 294.22,
      "end": 296.98,
      "text": "C: אני דרכון."
    },
    {
      "start": 302.68,
      "end": 305.5,
      "text": "⁦A!⁩ דרכון אחד – אז «⁦הוא⁩», לא «⁦הם⁩»."
    },
    {
      "start": 305.55,
      "end": 310.94,
      "text": "בדר״כ צריך דרכון או תעודת זהות במשרד."
    },
    {
      "start": 310.99,
      "end": 318.08,
      "text": "ואם שכחת, תגיד בכנות: «⁦סליחה, לצערי שכחתי אותו.⁩» (Entschuldigung, den habe ich leider vergessen.)"
    },
    {
      "start": 318.33,
      "end": 320.14,
      "text": "הנה הדרכון שלי."
    },
    {
      "start": 320.25,
      "end": 321.65,
      "text": "חזור אחרי!"
    },
    {
      "start": 321.7,
      "end": 323.94,
      "text": "הנה הדרכון שלי."
    },
    {
      "start": 326.87,
      "end": 330.65,
      "text": "סליחה, לצערי שכחתי אותו."
    },
    {
      "start": 335.85,
      "end": 338.14,
      "text": "איך כותבים את שם המשפחה שלך?"
    },
    {
      "start": 338.24,
      "end": 341.34,
      "text": "השם שלך הוא Nowak. מה אתה אומר?"
