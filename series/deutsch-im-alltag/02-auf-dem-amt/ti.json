  "subtitles": [
    {
      "start": 0.4,
      "end": 3.97,
      "text": "ገዛ ቐይረ! ሓድሽ መንበሪ፣ ሓድሽ ከተማ …"
    },
    {
      "start": 4.07,
      "end": 7.56,
      "text": "ብጣዕሚ ጽቡቕ! እሞ – ድሮ ተመዝጊብካ ዲኻ?"
    },
    {
      "start": 7.66,
      "end": 11.22,
      "text": "ተመዝጊበ? ኣበይ? ኣብ ጂም ድዩ?"
    },
    {
      "start": 11.32,
      "end": 20,
      "text": "ኣይፋል፣ Leo። ኣብ ቤት ጽሕፈት ነበርቲ! ሎሚ ኣብ „Bürgeramt“ ሓደ ምሉእ ቆጸራ ክትርእዩ ኢኹም – ካብ መእተዊ ክሳብ ወረቐት ምዝገባ።"
    },
    {
      "start": 20.05,
      "end": 24.32,
      "text": "ኣብ ነፍሲ ወከፍ ኩነታት ድማ ንሓተኩም፦ እንታይ ትብሉ?"
    },
    {
      "start": 24.42,
      "end": 26.79,
      "text": "ሓሙሽተ ካልኢት ጥራይ ድማ ኣለኩም!"
    },
    {
      "start": 30.09,
      "end": 34.39,
      "text": "ናብ ቤት ጽሕፈት ነበርቲ ትኣትዉ። ኣብ መደበር ሓበሬታ ሓደ ሰብኣይ ተቐሚጡ ኣሎ።"
    },
    {
      "start": 34.49,
      "end": 37.24,
      "text": "ደሓን ሓደርኩም። እንታይ ጉዳይ ኣለኩም?"
    },
    {
      "start": 37.34,
      "end": 38.57,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 38.62,
      "end": 42.18,
      "text": "A: ደሓን ሓደርኩም። ክምዝገብ ደልየ።"
    },
    {
      "start": 42.23,
      "end": 44.91,
      "text": "B: ኣነ ጉዳይ እየ።"
    },
    {
      "start": 44.96,
      "end": 47.41,
      "text": "C: ቤት ጽሕፈት እደሊ።"
    },
    {
      "start": 53.11,
      "end": 57.71,
      "text": "A! „Anliegen“ ማለት፦ ስለምንታይ ኣብዚ ኣለኹም? እንታይ የድልየኩም?"
    },
    {
      "start": 57.76,
      "end": 61.32,
      "text": "ኣብ ቤት ጽሕፈታት መንግስቲ ነዛ ቃል እዚኣ ብዙሕ ክትሰምዕዋ ኢኹም።"
    },
    {
      "start": 61.57,
      "end": 64.52,
      "text": "ደሓን ሓደርኩም። ክምዝገብ ደልየ።"
    },
    {
      "start": 64.61,
      "end": 66.51,
      "text": "ቆጸራ ኣለኩም ዶ?"
    },
    {
      "start": 66.61,
      "end": 68.51,
      "text": "እወ፣ ሰዓት ትሽዓተ።"
    },
    {
      "start": 68.61,
      "end": 70.01,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 70.06,
      "end": 72.3,
      "text": "ክምዝገብ ደልየ።"
    },
    {
      "start": 75.23,
      "end": 78.28,
      "text": "ሰዓት ትሽዓተ ቆጸራ ኣለኒ።"
    },
    {
      "start": 82.64,
      "end": 86.86,
      "text": "ጽቡቕ። ሽዑ በጃኹም ቁጽሪ ውሰዱ እሞ ኣብቲ ተጸበዩ።"
    },
    {
      "start": 86.96,
      "end": 88.7,
      "text": "ሕጂ እንታይ ትገብሩ?"
    },
    {
      "start": 88.8,
      "end": 91.09,
      "text": "A: ገዛ ትቕይሩ።"
    },
    {
      "start": 91.14,
      "end": 94.23,
      "text": "B: ጸጉሪ ሰብ ትስሕቡ።"
    },
    {
      "start": 94.28,
      "end": 98.74,
      "text": "C: ካብቲ ማሽን ቁጽሪ ዘለዎ ወረቐት ትወስዱ።"
    },
    {
      "start": 103.94,
      "end": 108.24,
      "text": "እሞ A! ገዛ እቕይር ኣለኹ። ሕጂ ገዛ ቐይረ እንድየ …"
    },
    {
      "start": 108.89,
      "end": 115.64,
      "text": "ኣይፋል፣ Leo። C! „Eine Nummer ziehen“ ማለት፦ ቁጽሪ ምጽባይኩም ዘለዎ ወረቐት ትወስዱ። „Umziehen“"
    },
    {
      "start": 115.69,
      "end": 121.65,
      "text": "ፈጺሙ ካልእ እዩ – ናብ ሓድሽ ገዛ ምግዓዝ ማለት እዩ።"
    },
    {
      "start": 121.9,
      "end": 123.31,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 123.36,
      "end": 125.7,
      "text": "ቁጽሪ እወስድ።"
    },
    {
      "start": 129.25,
      "end": 134.26,
      "text": "ትጽበዩ። ብሃንደበት ምልክታ ትሰምዑ። ኣጸቢቕኩም ስምዑ!"
    },
    {
      "start": 134.36,
      "end": 138.6,
      "text": "ቁጽሪ 147፣ በጃኹም ናብ ቦታ 12።"
    },
    {
      "start": 138.7,
      "end": 143.24,
      "text": "ቁጽርኹም 147 እዩ። ናበይ ትኸዱ?"
    },
    {
      "start": 143.34,
      "end": 146.83,
      "text": "A: ናብ ቦታ 147።"
    },
    {
      "start": 146.88,
      "end": 149.4,
      "text": "B: ናብ ቦታ 12።"
    },
    {
      "start": 149.45,
      "end": 152.13,
      "text": "C: ናብ ክፍሊ 14።"
    },
    {
      "start": 157.83,
      "end": 160.75,
      "text": "B! ቅድም ቁጽርኹም፣ ድሕሪኡ ቦታ ይመጽእ።"
    },
    {
      "start": 160.8,
      "end": 164.61,
      "text": "ኣብ ብዙሓት ቤት ጽሕፈታት ኣብ ስክሪን'ውን ይርአ እዩ።"
    },
    {
      "start": 164.86,
      "end": 166.26,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 166.31,
      "end": 170.61,
      "text": "147 – ቦታ 12"
    },
    {
      "start": 176.42,
      "end": 180.3,
      "text": "ናብ ቦታ 12 ትኸዱ። ኣብኡ ሓንቲ ሰበይቲ ተቐሚጣ ኣላ።"
    },
    {
      "start": 180.4,
      "end": 184.28,
      "text": "ደሓን ሓደርኩም። በጃኹም ተቐመጡ። እንታይ ክሕግዘኩም?"
    },
    {
      "start": 184.38,
      "end": 185.6,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 185.65,
      "end": 188.49,
      "text": "A: ክምዝግበኩም ደልየ።"
    },
    {
      "start": 188.54,
      "end": 192.11,
      "text": "B: ሓድሽ ገዛይ ከመዝግብ ደልየ።"
    },
    {
      "start": 192.16,
      "end": 195.41,
      "text": "C: ሕጂ ኣብዚ እነብር። ቻው!"
    },
    {
      "start": 201.11,
      "end": 206.75,
      "text": "B! ገዛኹም ኢኹም ትምዝግቡ – ወይ ንርእስኹም፦ „Ich möchte mich anmelden.“"
    },
    {
      "start": 206.8,
      "end": 210.84,
      "text": "ግን „Sie“ (ንስኹም) ኣይኮነን – ወይዘሮ Krüger ድሮ ተመዝጊባ እያ።"
    },
    {
      "start": 211.09,
      "end": 213.69,
      "text": "ሓድሽ ገዛይ ከመዝግብ ደልየ።"
    },
    {
      "start": 213.79,
      "end": 216.55,
      "text": "ብደስታ። መዓስ ኢኹም ናብኡ ኣቲኹም?"
    },
    {
      "start": 216.65,
      "end": 218.47,
      "text": "ብቀዳማይ ጥቅምቲ።"
    },
    {
      "start": 218.57,
      "end": 219.97,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 220.03,
      "end": 223.38,
      "text": "ሓድሽ ገዛይ ከመዝግብ ደልየ።"
    },
    {
      "start": 227.61,
      "end": 231.07,
      "text": "ብቀዳማይ ጥቅምቲ እየ ኣትየ።"
    },
    {
      "start": 235.92,
      "end": 238.67,
      "text": "ናይ ዋና ገዛ ምርግጋጽ ሒዝኩም ዶ?"
    },
    {
      "start": 238.77,
      "end": 242.34,
      "text": "ኦ፣ ነዊሕ ቃል! እንታይ ትብሉ?"
    },
    {
      "start": 242.44,
      "end": 245.77,
      "text": "A: ኣይፋል፣ ገዛ ኣይህብን እየ።"
    },
    {
      "start": 245.82,
      "end": 249.31,
      "text": "B: እወ፣ ገዛይ ክህበኩም እየ።"
    },
    {
      "start": 249.36,
      "end": 253.58,
      "text": "C: እወ፣ እዚ ካብ ዋና ገዛይ ዝመጸ ምርግጋጽ እዩ።"
    },
    {
      "start": 259.28,
      "end": 267.17,
      "text": "C! „Wohnungsgeberbestätigung“ ካብ ዋና ገዛኹም ዝመጽእ ፎርም እዩ። ብሓቂ ኣብዚ ገዛ ከም እትነብሩ የረጋግጽ።"
    },
    {
      "start": 267.22,
      "end": 270.92,
      "text": "ብዘይ እዚ ወረቐት፣ ምዝገባ መብዛሕትኡ ግዜ ኣይከኣልን እዩ።"
    },
    {
      "start": 271.17,
      "end": 274.51,
      "text": "እወ፣ እዚ ካብ ዋና ገዛይ ዝመጸ ምርግጋጽ እዩ።"
    },
    {
      "start": 274.61,
      "end": 276.01,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 276.06,
      "end": 279.52,
      "text": "እዚ ካብ ዋና ገዛይ ዝመጸ ምርግጋጽ እዩ።"
    },
    {
      "start": 284.37,
      "end": 287.31,
      "text": "በጃኹም፣ መንነት ወረቐትኩም ወይ ፓስፖርትኩም ድማ።"
    },
    {
      "start": 287.41,
      "end": 288.63,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 288.68,
      "end": 291.36,
      "text": "A: እዚ ፓስፖርተይ እዩ።"
    },
    {
      "start": 291.41,
      "end": 294.17,
      "text": "B: እዚኦም ፓስፖርተይ እዮም።"
    },
    {
      "start": 294.22,
      "end": 296.98,
      "text": "C: ኣነ ፓስፖርት እየ።"
    },
    {
      "start": 302.68,
      "end": 305.5,
      "text": "A! ሓደ ፓስፖርት – ስለዚ „ist“ (እዩ)፣ „sind“ (እዮም) ኣይኮነን። ኣብ ቤት ጽሕፈታት መንግስቲ ዳርጋ ኩሉ ግዜ ፓስፖርት ወይ መንነት ወረቐት የድልየኩም።"
    },
    {
      "start": 305.55,
      "end": 310.94,
      "text": "እንተ ረሲዕኩሞ ድማ፣ ብቕንዕና በሉ፦ „Entschuldigung, den habe ich leider vergessen.“"
    },
    {
      "start": 310.99,
      "end": 318.08,
      "text": "(ይቕሬታ፣ ብዘሕዝን ረሲዐዮ።)"
    },
    {
      "start": 318.33,
      "end": 320.14,
      "text": "እዚ ፓስፖርተይ እዩ።"
    },
    {
      "start": 320.25,
      "end": 321.65,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 321.7,
      "end": 323.94,
      "text": "እዚ ፓስፖርተይ እዩ።"
    },
    {
      "start": 326.87,
      "end": 330.65,
      "text": "ይቕሬታ፣ ብዘሕዝን ረሲዐዮ።"
    },
    {
      "start": 335.85,
      "end": 338.14,
      "text": "ስም ስድራኹም ብኸመይ ይጽሓፍ?"
    },
    {
      "start": 338.24,
      "end": 341.34,
      "text": "ስምኩም Nowak እዩ። እንታይ ትብሉ?"
    },
    {
      "start": 341.44,
      "end": 344.12,
      "text": "A: ብብርዒ።"
    },
    {
      "start": 344.17,
      "end": 349.33,
      "text": "B: ፊደል ብፊደል ክነግረኩም፦ N – O – W – A – K።"
    },
    {
      "start": 349.38,
      "end": 352.4,
      "text": "C: ብጣዕሚ ጽቡቕ ኢዩ ዝጽሓፍ።"
    },
    {
      "start": 358.1,
      "end": 365.79,
      "text": "B! „Wie schreibt man …?“ ማለት፦ ኣየኖት ፊደላት? ድሕሪኡ ፊደል ብፊደል ትነግሩ።"
    },
    {
      "start": 365.84,
      "end": 370.31,
      "text": "ስምኩም ብጀርመንኛ ተለማመዱዎ፣ ኣብ ኩሉ ቦታ ከድልየኩም እዩ!"
    },
    {
      "start": 370.56,
      "end": 373.58,
      "text": "N – O – W – A – K።"
    },
    {
      "start": 373.68,
      "end": 374.88,
      "text": "የቐንየለይ።"
    },
    {
      "start": 374.94,
      "end": 376.35,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 376.4,
      "end": 382.11,
      "text": "ፊደል ብፊደል እነግር፦ N – O – W – A – K።"
    },
    {
      "start": 389.54,
      "end": 391.36,
      "text": "ተመርዕኹም ዶ?"
    },
    {
      "start": 391.45,
      "end": 394.71,
      "text": "ኣይተመርዓኹምን። እንታይ ትብሉ?"
    },
    {
      "start": 394.81,
      "end": 397.83,
      "text": "A: ኣይፋል፣ ኣይተመርዓኹን።"
    },
    {
      "start": 397.88,
      "end": 400.98,
      "text": "B: ኣይፋል፣ ኣነ ብዘሕዝን።"
    },
    {
      "start": 401.02,
      "end": 404.12,
      "text": "C: ኣይፋል፣ ኣነ ምምርዓው እየ።"
    },
    {
      "start": 409.82,
      "end": 419.92,
      "text": "A! „Ledig“ ማለት፦ ዘይተመርዓወ። ተጠንቀቑ፦ „leider“ ተመሳሳሊ ይስማዕ፣ ግን ፈጺሙ ካልእ ትርጉም ኣለዎ – „leider“"
    },
    {
      "start": 419.97,
      "end": 421.31,
      "text": "ማለት፦ ብዘሕዝን።"
    },
    {
      "start": 421.56,
      "end": 423.69,
      "text": "ኣይፋል፣ ኣይተመርዓኹን።"
    },
    {
      "start": 423.79,
      "end": 425.19,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 425.24,
      "end": 427.16,
      "text": "ኣይተመርዓኹን።"
    },
    {
      "start": 429.74,
      "end": 431.87,
      "text": "ተመርዕየ እየ።"
    },
    {
      "start": 435.18,
      "end": 440.11,
      "text": "በጃኹም ነቲ ሓበሬታ ፈትሹ። ኩሉ ቅኑዕ እንተኾይኑ፣ በጃኹም ኣብዚ ፈርሙ።"
    },
    {
      "start": 440.21,
      "end": 441.43,
      "text": "እንታይ ትብሉ?"
    },
    {
      "start": 441.48,
      "end": 444.5,
      "text": "A: ኣብ ትሕቲ ጠረቤዛ ክጽሕፎ እየ።"
    },
    {
      "start": 444.55,
      "end": 447.56,
      "text": "B: ምፍራም ኣይፈቱን እየ።"
    },
    {
      "start": 447.62,
      "end": 451.57,
      "text": "C: ኩሉ ቅኑዕ እዩ። ብልክዕ ኣበይ እየ ዝፍርም?"
    },
    {
      "start": 457.27,
      "end": 463.38,
      "text": "C! „Unterschreiben“ ማለት፦ ስምኩም ብኢድ ምጽሓፍ – ፊርማኹም።"
    },
    {
      "start": 463.43,
      "end": 467.71,
      "text": "ክትፈልጥዎ ጽቡቕ፦ ኩሉ ግዜ ቅድም ኣብቲ ፎርም ዘሎ ኣንብቡ።"
    },
    {
      "start": 467.96,
      "end": 471.06,
      "text": "ኩሉ ቅኑዕ እዩ። ብልክዕ ኣበይ እየ ዝፍርም?"
    },
    {
      "start": 471.16,
      "end": 473.06,
      "text": "ኣብዚ ታሕቲ፣ በጃኹም።"
    },
    {
      "start": 473.16,
      "end": 474.56,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 474.61,
      "end": 476.74,
      "text": "ኣበይ እየ ዝፍርም?"
    },
    {
      "start": 480.06,
      "end": 483.7,
      "text": "በቃ፣ ወዲእና። እዚ ወረቐት ምዝገባኹም እዩ።"
    },
    {
      "start": 483.8,
      "end": 486.48,
      "text": "ወዲእኩም! እንታይ ትብሉ?"
    },
    {
      "start": 486.58,
      "end": 489.34,
      "text": "A: የቐንየለይ፣ ክድውለልኩም እየ።"
    },
    {
      "start": 489.39,
      "end": 493.19,
      "text": "B: ብዙሕ የቐንየለይ! ካልእ ዘድልየኒ ነገር ኣሎ ዶ?"
    },
    {
      "start": 493.24,
      "end": 495.76,
      "text": "C: ዝሓመመኒ የብለይን!"
    },
    {
      "start": 501.46,
      "end": 509.79,
      "text": "B! ብዛዕባ A ድማ ተጠንቀቑ፦ „Ich melde mich“ „ይምዝገብ ኣለኹ“ ማለት ኣይኮነን፣ ግን፦ ደሓር ክድውለልኩም እየ።"
    },
    {
      "start": 509.84,
      "end": 514.72,
      "text": "C ድማ ምናልባት ትዝክርዎ ትኾኑ – እዚ ኣብ ሓኪም ጥራይ እዩ ዝሰማማዕ!"
    },
    {
      "start": 514.97,
      "end": 518.07,
      "text": "ብዙሕ የቐንየለይ! ካልእ ዘድልየኒ ነገር ኣሎ ዶ?"
    },
    {
      "start": 518.17,
      "end": 522.55,
      "text": "ኣይፋል፣ ኩሉ እዚ እዩ። ነቲ ወረቐት ብጥንቃቐ ሓልውዎ።"
    },
    {
      "start": 522.65,
      "end": 524.05,
      "text": "ድሕረይ ደግሙ!"
    },
    {
      "start": 524.1,
      "end": 526.76,
      "text": "ካልእ ዘድልየኒ ነገር ኣሎ ዶ?"
    },
    {
      "start": 530.67,
      "end": 537.19,
      "text": "ብዛዕባ ምዝገባ ሰለስተ ምኽርታት። ቀዳማይ፦ ናብ ገዛ ምስ ኣተኹም ኣብ ውሽጢ ክልተ ሰሙን ተመዝገቡ።"
    },
    {
      "start": 537.44,
      "end": 543.41,
      "text": "ካልኣይ፦ ኣብ ብዙሓት ከተማታት ቆጸራ የድልየኩም – መብዛሕትኡ ግዜ ብኦንላይን ክትሕዝዎ ትኽእሉ።"
    },
    {
      "start": 543.66,
      "end": 549.73,
      "text": "ሳልሳይ ድማ፦ ነቲ ወረቐት ምዝገባ ብተደጋጋሚ ከድልየኩም እዩ፣ ንኣብነት ንሕሳብ ባንኪ።"
    },
    {
      "start": 549.78,
      "end": 551.23,
      "text": "ስለዚ ብጥንቃቐ ሓልውዎ!"
    },
    {
      "start": 551.58,
      "end": 558.25,
      "text": "ኣብ ቤት ጽሕፈታት መንግስቲ ጀርመንኛ ሓደ ሓደ ግዜ ኣዝዩ ዝተሓላለኸ ይመስል። Leo የንብቦ – ኣነ ድማ ብቐሊሉ እብሎ።"
    },
    {
      "start": 558.5,
      "end": 560.32,
      "text": "እንታይ ጉዳይ ኣለኩም?"
    },
    {
      "start": 560.52,
      "end": 562.08,
      "text": "እንታይ የድልየኩም?"
    },
    {
      "start": 562.73,
      "end": 565.33,
      "text": "በጃኹም ሰነዳትኩም ኣዳልዉ።"
    },
    {
      "start": 565.53,
      "end": 568.28,
      "text": "በጃኹም ወረቓቕትኹም ኣብ ኢድኩም ሓዙ።"
    },
    {
      "start": 568.93,
      "end": 571.77,
      "text": "ነቲ ፎርም ምሉእ ብምሉእ መልእዎ።"
    },
    {
      "start": 571.97,
      "end": 574.49,
      "text": "ኣብ ኩሉ ቦታ ገለ ነገር ጽሓፉ።"
    },
    {
      "start": 575.14,
      "end": 578.08,
      "text": "ምስራሕ ጉዳይኩም ብግምት ክልተ ሰሙን ይወስድ።"
    },
    {
      "start": 578.28,
      "end": 581.04,
      "text": "ዳርጋ ክልተ ሰሙን ይወስድ።"
    },
    {
      "start": 581.69,
      "end": 584.13,
      "text": "በጃኹም ነቲ ሰነዳት ደሓር ኣቕርቡ።"
    },
    {
      "start": 584.34,
      "end": 587.17,
      "text": "በጃኹም ነቲ ወረቓቕቲ ደሓር ኣምጽእዎ።"
    },
    {
      "start": 587.82,
      "end": 589.79,
      "text": "ሎሚ ክዳን እቕይር ኣለኹ!"
    },
    {
      "start": 589.95,
      "end": 597.9,
      "text": "ኦ፣ ካልእ ክዳን ትኽደን ዲኻ? ወይስ „Ich ziehe um“ ማለትካ ድዩ – ናብ ሓድሽ ገዛ ትግዕዝ?"
    },
    {
      "start": 598.35,
      "end": 603.18,
      "text": "ኣብ ቤት ጽሕፈት መንግስቲ ድማ፦ „Ich bin leider“ ዘይኮነስ „Ich bin ledig“"
    },
    {
      "start": 603.23,
      "end": 605.99,
      "text": "(ኣይተመርዓኹን) – እንተ ዘይተመርዒኹም።"
    },
    {
      "start": 606.44,
      "end": 613.77,
      "text": "„Ich melde mich“ ድማ ማለት፦ ደሓር ክድውል እየ። ኣብ ቤት ጽሕፈት መንግስቲ ትብሉ፦ „Ich melde mich an.“ (ይምዝገብ ኣለኹ።)"
    },
    {
      "start": 614.22,
      "end": 619.88,
      "text": "ሕጂ ድማ ኩሉ ሓንሳብ ደጊምና። እተን ዓሰርተ ኣገደስቲ ሓረጋት። ድሕረይ ደግሙ!"
    },
    {
      "start": 619.93,
      "end": 622.17,
      "text": "ክምዝገብ ደልየ።"
    },
    {
      "start": 625.1,
      "end": 628.25,
      "text": "ሰዓት ትሽዓተ ቆጸራ ኣለኒ።"
    },
    {
      "start": 632.23,
      "end": 634.47,
      "text": "ቁጽሪ እወስድ።"
    },
    {
      "start": 637.4,
      "end": 640.55,
      "text": "ሓድሽ ገዛይ ከመዝግብ ደልየ።"
    },
    {
      "start": 644.54,
      "end": 648,
      "text": "እዚ ካብ ዋና ገዛይ ዝመጸ ምርግጋጽ እዩ።"
    },
    {
      "start": 652.34,
      "end": 654.79,
      "text": "እዚ ፓስፖርተይ እዩ።"
    },
    {
      "start": 657.96,
      "end": 660.9,
      "text": "ስመይ ፊደል ብፊደል እነግር።"
    },
    {
      "start": 664.65,
      "end": 666.57,
      "text": "ኣይተመርዓኹን።"
    },
    {
      "start": 669.14,
      "end": 671.27,
      "text": "ኣበይ እየ ዝፍርም?"
    },
    {
      "start": 674.08,
      "end": 676.74,
      "text": "ካልእ ዘድልየኒ ነገር ኣሎ ዶ?"
    },
    {
      "start": 680.15,
      "end": 684.61,
      "text": "ኣየናይ ቃል እዩ ዝኸበደኩም? ኣብ ርእይቶታት ጽሓፍዎ!"
    },
    {
      "start": 684.71,
      "end": 687.65,
      "text": "ቻው፣ ቀልጢፍና ኣብ LilyLingua ክንራኸብ!"
    }
  ]
}
