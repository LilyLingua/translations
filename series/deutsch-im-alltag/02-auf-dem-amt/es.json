    },
    {
      "start": 164.86,
      "end": 166.26,
      "text": "¡Repite!"
    },
    {
      "start": 166.31,
      "end": 170.61,
      "text": "147 – puesto 12"
    },
    {
      "start": 176.42,
      "end": 180.3,
      "text": "Vas al puesto 12. Allí hay una mujer sentada."
    },
    {
      "start": 180.4,
      "end": 184.28,
      "text": "Buenos días. Siéntese. ¿En qué puedo ayudarle?"
    },
    {
      "start": 184.38,
      "end": 185.6,
      "text": "¿Qué dices?"
    },
    {
      "start": 185.65,
      "end": 188.49,
      "text": "A: Quiero empadronarla a usted."
    },
    {
      "start": 188.54,
      "end": 192.11,
      "text": "B: Quiero registrar mi nuevo piso."
    },
    {
      "start": 192.16,
      "end": 195.41,
      "text": "C: Ahora vivo aquí. ¡Adiós!"
    },
    {
      "start": 201.11,
      "end": 206.75,
      "text": "¡B! Registras tu piso, o a ti mismo: „Ich möchte mich anmelden.“"
    },
    {
      "start": 206.8,
      "end": 210.84,
      "text": "Pero no „Sie“ (a usted): la señora Krüger ya está empadronada."
    },
    {
      "start": 211.09,
      "end": 213.69,
